@app.route('/api/classrooms', methods=['GET', 'POST'])
def api_classrooms():
    if session.get('role') not in ['مدير', 'مشرف']:
        return jsonify({"error": "غير مصرح"}), 401

    if request.method == 'GET':
        conn = get_db_connection()
        cursor = conn.cursor()
        cursor.execute("""
            SELECT c.Id, c.Name, c.CameraIP, c.CameraType, c.TeacherId,
                   c.IsActive, u.Name as TeacherName
            FROM Classrooms c
            LEFT JOIN Users u ON c.TeacherId = u.Id
            ORDER BY c.Name
        """)
        rows = cursor.fetchall()
        conn.close()
        return jsonify([{
            'id': r.Id,
            'name': r.Name,
            'camera_ip': r.CameraIP,
            'camera_type': r.CameraType or 'classroom',
            'teacher_id': r.TeacherId,
            'teacher_name': r.TeacherName or '—',
            'is_active': bool(r.IsActive)
        } for r in rows])

    data = request.get_json()
    name = (data.get('name') or '').strip()
    camera_ip = (data.get('camera_ip') or '').strip()
    camera_type = data.get('camera_type', 'classroom')
    teacher_id = data.get('teacher_id')

    if not name or not camera_ip:
        return jsonify({"success": False, "message": "اسم الفصل ورابط الكاميرا مطلوبان"}), 400

    try:
        conn = get_db_connection()
        cursor = conn.cursor()

        cursor.execute("SELECT COUNT(*) FROM Classrooms WHERE Name = ?", (name,))
        if cursor.fetchone()[0] > 0:
            conn.close()
            return jsonify({"success": False, "message": "⚠️ يوجد فصل بنفس الاسم بالفعل"}), 400

        cursor.execute("""
            INSERT INTO Classrooms (Name, CameraIP, CameraType, TeacherId, IsActive)
            VALUES (?, ?, ?, ?, 1)
        """, (name, camera_ip, camera_type, teacher_id if teacher_id else None))
        conn.commit()
        conn.close()
        return jsonify({"success": True, "message": f"✅ تم إضافة الفصل '{name}' بنجاح"})
    except Exception as e:
        print(f"❌ خطأ إضافة الفصل: {e}", flush=True)
        traceback.print_exc()
        return jsonify({"success": False, "message": str(e)}), 500


@app.route('/api/classrooms/<int:cid>', methods=['PUT', 'DELETE'])
def api_classroom_edit(cid):
    if session.get('role') not in ['مدير', 'مشرف']:
        return jsonify({"error": "غير مصرح"}), 401

    if request.method == 'DELETE':
        try:
            conn = get_db_connection()
            cursor = conn.cursor()
            cursor.execute("DELETE FROM Classrooms WHERE Id = ?", (cid,))
            conn.commit()
            conn.close()

            # ✅ تنظيف موارد الكاميرا من الذاكرة فوراً
            with persistent_captures_lock:
                entry = persistent_captures.pop(cid, None)
                if entry and entry.get('cap'):
                    try:
                        entry['cap'].release()
                    except Exception:
                        pass
            with video_buffers_lock:
                video_buffers.pop(cid, None)
            with prev_frames_lock:
                prev_frames.pop(cid, None)
            with camera_locks_lock:
                camera_locks.pop(cid, None)

            print(f"🧹 تم تنظيف موارد الفصل #{cid} من الذاكرة", flush=True)
            return jsonify({"success": True, "message": "✅ تم حذف الفصل"})
        except Exception as e:
            return jsonify({"success": False, "message": str(e)}), 500


    data = request.get_json()
    name = (data.get('name') or '').strip()
    camera_ip = (data.get('camera_ip') or '').strip()
    camera_type = data.get('camera_type', 'classroom')
    teacher_id = data.get('teacher_id')

    if not name or not camera_ip:
        return jsonify({"success": False, "message": "الاسم ورابط الكاميرا مطلوبان"}), 400

    try:
        conn = get_db_connection()
        cursor = conn.cursor()
        cursor.execute("""
            UPDATE Classrooms
            SET Name = ?, CameraIP = ?, CameraType = ?, TeacherId = ?
            WHERE Id = ?
        """, (name, camera_ip, camera_type, teacher_id if teacher_id else None, cid))
        conn.commit()
        conn.close()
        return jsonify({"success": True, "message": "✅ تم تحديث بيانات الفصل"})
    except Exception as e:
        return jsonify({"success": False, "message": str(e)}), 500


@app.route('/api/classrooms/test-camera', methods=['POST'])
def api_classroom_test_camera():
    """اختبار اتصال كاميرا الفصل"""
    if session.get('role') not in ['مدير', 'مشرف']:
        return jsonify({"error": "غير مصرح"}), 401
    data = request.get_json()
    rtsp_url = (data.get('camera_ip') or '').strip()
    if not rtsp_url:
        return jsonify({"success": False, "message": "رابط الكاميرا مطلوب"}), 400

    try:
        os.environ["OPENCV_FFMPEG_CAPTURE_OPTIONS"] = "rtsp_transport;tcp"
        cap = cv2.VideoCapture(rtsp_url, cv2.CAP_FFMPEG)
        if not cap.isOpened():
            return jsonify({"success": False, "message": "❌ تعذر الاتصال بالكاميرا"}), 200
        cap.set(cv2.CAP_PROP_BUFFERSIZE, 1)
        ret, frame = cap.read()
        if not ret:
            cap.release()
            return jsonify({"success": False, "message": "❌ لم يتم استقبال إطار من الكاميرا"}), 200
        h, w = frame.shape[:2]
        ret, jpeg = cv2.imencode('.jpg', frame, [cv2.IMWRITE_JPEG_QUALITY, 70])
        img_b64 = base64.b64encode(jpeg.tobytes()).decode('utf-8')
        cap.release()
        return jsonify({
            "success": True,
            "message": f"✅ الكاميرا تعمل — الدقة: {w}×{h}",
            "resolution": f"{w}×{h}",
            "preview": f"data:image/jpeg;base64,{img_b64}"
        })
    except Exception as e:
        return jsonify({"success": False, "message": f"❌ خطأ: {str(e)}"}), 200


