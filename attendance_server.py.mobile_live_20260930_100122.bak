def _get_exam_tracker(session_id, cid, key):
    """جلب/إنشاء tracker لسلوك معيّن"""
    k = f"{session_id}_{cid}_{key}"
    with _exam_trackers_lock:
        t = _exam_trackers.get(k)
        if not t:
            t = {'history': [], 'last_alert': {}}
            _exam_trackers[k] = t
        return t

