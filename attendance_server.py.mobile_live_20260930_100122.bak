@app.route('/api/parents/search')
def api_parents_search():
    """البحث في أولياء الأمور (طلاب)"""
    if session.get('role') not in ['مدير', 'مشرف']:
        return jsonify({"error": "غير مصرح"}), 401
    q = request.args.get('q', '').strip()
    try:
        conn = get_db_connection()
        cursor = conn.cursor()
        if q:
            search = f"%{q}%"
            cursor.execute("""
                SELECT Id, Name, Class, ParentEmail, TelegramChatID, ParentPhone, ProfileImage
                FROM Users
                WHERE Role = N'طالب' AND IsActive = 1
                  AND (Name LIKE ? OR Class LIKE ? OR ParentPhone LIKE ?)
                ORDER BY Name
            """, (search, search, search))
        else:
            cursor.execute("""
                SELECT TOP 100 Id, Name, Class, ParentEmail, TelegramChatID, ParentPhone, ProfileImage
                FROM Users
                WHERE Role = N'طالب' AND IsActive = 1
                ORDER BY Name
            """)
        rows = cursor.fetchall()
        conn.close()
        return jsonify([{
            'id': r.Id,
            'name': r.Name,
            'class': r.Class or '—',
            'parent_email': r.ParentEmail or '',
            'parent_chat': r.TelegramChatID or '',
            'parent_phone': r.ParentPhone or '',
            'profile_image': r.ProfileImage or ''  # ✅ صورة الطالب
        } for r in rows])
    except Exception as e:
        return jsonify({"error": str(e)}), 500



@app.route('/api/alerts/<int:alert_id>/send-to-parent', methods=['POST'])
def api_send_alert_to_parent(alert_id):
    """إرسال رسالة لولي أمر (مع/بدون صورة)"""
    if session.get('role') not in ['مدير', 'مشرف']:
        return jsonify({"error": "غير مصرح"}), 401

    conn = None
    try:
        data = request.get_json()
        if not data:
            return jsonify({"success": False, "message": "بيانات غير مكتملة"}), 400

        recipient_id = data.get('recipient_id')
        message_text = (data.get('message') or '').strip()
        attach_image = data.get('attach_image', True)
        send_email_flag = data.get('send_email', True)
        send_telegram_flag = data.get('send_telegram', True)

        if not recipient_id or not message_text:
            return jsonify({"success": False, "message": "المستلم والرسالة مطلوبان"}), 400

        # ✅ التحقق من قنوات الإرسال
        if not send_email_flag and not send_telegram_flag:
            return jsonify({"success": False, "message": "اختر قناة إرسال واحدة على الأقل"}), 400

        # ==================== 1. جلب بيانات الإنذار والمستلم ====================
        conn = get_db_connection()
        cursor = conn.cursor()

        cursor.execute("""
            SELECT ClassroomId, ClassroomName, ImagePath
            FROM Alerts WHERE Id = ?
        """, (alert_id,))
        alert_row = cursor.fetchone()
        if not alert_row:
            conn.close()
            return jsonify({"success": False, "message": "الإنذار غير موجود"}), 404

        cursor.execute("""
            SELECT Name, ParentEmail, TelegramChatID
            FROM Users WHERE Id = ? AND Role = N'طالب' AND IsActive = 1
        """, (recipient_id,))
        user_row = cursor.fetchone()
        if not user_row:
            conn.close()
            return jsonify({"success": False, "message": "ولي الأمر غير موجود"}), 404

        conn.close()
        conn = None

        # ==================== 2. تحديد القنوات والصورة ====================
        image_path = alert_row.ImagePath if attach_image else None

        sent_via = 'both'
        if send_email_flag and not send_telegram_flag:
            sent_via = 'email'
        elif send_telegram_flag and not send_email_flag:
            sent_via = 'telegram'

        # ==================== 3. إدراج الإشعار (بـ OUTPUT INSERTED.Id) ====================
        conn = get_db_connection()
        cursor = conn.cursor()

        cursor.execute("""
            INSERT INTO AlertNotifications
            (AlertId, ClassroomId, ClassroomName, RecipientUserId, RecipientName,
             RecipientEmail, RecipientChat, MessageText, ImagePath, SentVia,
             SentByUserId, SentByName, Status, IsCorrection, SentAt)
            OUTPUT INSERTED.Id
            VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 'pending', 0, GETDATE())
        """, (
            alert_id,
            alert_row.ClassroomId,
            alert_row.ClassroomName,
            recipient_id,
            user_row.Name,
            user_row.ParentEmail if send_email_flag else None,
            user_row.TelegramChatID if send_telegram_flag else None,
            message_text,
            image_path,
            sent_via,
            session.get('user_id'),
            session.get('role', '—')
        ))

        row = cursor.fetchone()
        if not row or row[0] is None:
            conn.rollback()
            conn.close()
            print(f"❌ فشل الحصول على notification_id بعد INSERT", flush=True)
            return jsonify({"success": False, "message": "فشل إنشاء الإشعار في قاعدة البيانات"}), 500

        notification_id = int(row[0])
        conn.commit()
        conn.close()
        conn = None

        print(f"✅ تم إنشاء إشعار #{notification_id} للإنذار #{alert_id}", flush=True)

        # ==================== 4. الإرسال الفعلي ====================
        result = send_parent_notification(notification_id)
        return jsonify(result)

    except Exception as e:
        print(f"❌ خطأ في api_send_alert_to_parent: {e}", flush=True)
        traceback.print_exc()
        try:
            if conn:
                conn.close()
        except Exception:
            pass
        return jsonify({"success": False, "message": str(e)}), 500    

@app.route('/api/alerts/<int:alert_id>/notifications')
def api_alert_notifications(alert_id):
    """جلب كل الإشعارات المُرسَلة لإنذار معيّن"""
    if session.get('role') not in ['مدير', 'مشرف']:
        return jsonify({"error": "غير مصرح"}), 401
    try:
        conn = get_db_connection()
        cursor = conn.cursor()
        cursor.execute("""
            SELECT Id, RecipientName, RecipientEmail, RecipientChat,
                   MessageText, ImagePath, SentVia, SentByName, SentAt,
                   Status, IsCorrection, CorrectionFor, CorrectionReason
            FROM AlertNotifications
            WHERE AlertId = ?
            ORDER BY SentAt DESC
        """, (alert_id,))
        rows = cursor.fetchall()
        conn.close()
        return jsonify([{
            'id': r.Id,
            'recipient_name': r.RecipientName,
            'recipient_email': r.RecipientEmail,
            'recipient_chat': r.RecipientChat,
            'message': r.MessageText,
            'image_path': r.ImagePath,
            'sent_via': r.SentVia,
            'sent_by': r.SentByName,
            'sent_at': str(r.SentAt) if r.SentAt else None,
            'status': r.Status,
            'is_correction': bool(r.IsCorrection),
            'correction_for': r.CorrectionFor,
            'correction_reason': r.CorrectionReason
        } for r in rows])
    except Exception as e:
        return jsonify({"error": str(e)}), 500


@app.route('/api/notifications/<int:notification_id>/correct', methods=['POST'])
def api_notification_correct(notification_id):
    """إرسال تصحيح لإشعار سابق"""
    if session.get('role') not in ['مدير', 'مشرف']:
        return jsonify({"error": "غير مصرح"}), 401

    conn = None
    try:
        data = request.get_json()
        if not data:
            return jsonify({"success": False, "message": "بيانات غير مكتملة"}), 400

        correction_message = (data.get('message') or '').strip()
        correction_reason = data.get('reason', 'false_alarm')
        attach_image = data.get('attach_image', True)
        send_email_flag = data.get('send_email', True)
        send_telegram_flag = data.get('send_telegram', True)

        if not correction_message:
            return jsonify({"success": False, "message": "نص التصحيح مطلوب"}), 400

        # ✅ التحقق من قنوات الإرسال
        if not send_email_flag and not send_telegram_flag:
            return jsonify({"success": False, "message": "اختر قناة إرسال واحدة على الأقل"}), 400

        # ✅ التحقق من سبب التصحيح
        valid_reasons = ['false_alarm', 'misunderstanding', 'wrong_recipient', 'info_correction', 'resolved']
        if correction_reason not in valid_reasons:
            correction_reason = 'false_alarm'

        # ==================== 1. جلب الإشعار الأصلي ====================
        conn = get_db_connection()
        cursor = conn.cursor()

        cursor.execute("""
            SELECT AlertId, ClassroomId, ClassroomName, RecipientUserId,
                   RecipientName, RecipientEmail, RecipientChat, ImagePath
            FROM AlertNotifications WHERE Id = ?
        """, (notification_id,))
        orig = cursor.fetchone()

        if not orig:
            conn.close()
            conn = None
            return jsonify({"success": False, "message": "الإشعار الأصلي غير موجود"}), 404

        conn.close()
        conn = None

        # ==================== 2. تجهيز البيانات ====================
        image_path = orig.ImagePath if attach_image else None

        sent_via = 'both'
        if send_email_flag and not send_telegram_flag:
            sent_via = 'email'
        elif send_telegram_flag and not send_email_flag:
            sent_via = 'telegram'

        # ==================== 3. إدراج التصحيح (بـ OUTPUT INSERTED.Id) ====================
        conn = get_db_connection()
        cursor = conn.cursor()

        cursor.execute("""
            INSERT INTO AlertNotifications
            (AlertId, ClassroomId, ClassroomName, RecipientUserId, RecipientName,
             RecipientEmail, RecipientChat, MessageText, ImagePath, SentVia,
             SentByUserId, SentByName, Status, IsCorrection, CorrectionFor,
             CorrectionReason, SentAt)
            OUTPUT INSERTED.Id
            VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 'pending', 1, ?, ?, GETDATE())
        """, (
            orig.AlertId,
            orig.ClassroomId,
            orig.ClassroomName,
            orig.RecipientUserId,
            orig.RecipientName,
            orig.RecipientEmail if send_email_flag else None,
            orig.RecipientChat if send_telegram_flag else None,
            correction_message,
            image_path,
            sent_via,
            session.get('user_id'),
            session.get('role', '—'),
            notification_id,
            correction_reason
        ))

        row = cursor.fetchone()
        if not row or row[0] is None:
            conn.rollback()
            conn.close()
            print(f"❌ فشل الحصول على new_id بعد INSERT التصحيح", flush=True)
            return jsonify({"success": False, "message": "فشل إنشاء التصحيح في قاعدة البيانات"}), 500

        new_id = int(row[0])
        conn.commit()
        conn.close()
        conn = None

        print(f"✅ تم إنشاء تصحيح #{new_id} للإشعار #{notification_id} (سبب: {correction_reason})", flush=True)

        # ==================== 4. الإرسال الفعلي ====================
        result = send_parent_notification(new_id)
        return jsonify(result)

    except Exception as e:
        print(f"❌ خطأ في api_notification_correct: {e}", flush=True)
        traceback.print_exc()
        try:
            if conn:
                conn.close()
        except Exception:
            pass
        return jsonify({"success": False, "message": str(e)}), 500


@app.route('/api/notifications/<int:notification_id>', methods=['DELETE'])
def api_notification_delete(notification_id):
    """حذف إشعار مُرسَل (من السجل فقط)"""
    if session.get('role') not in ['مدير', 'مشرف']:
        return jsonify({"error": "غير مصرح"}), 401
    try:
        conn = get_db_connection()
        cursor = conn.cursor()
        cursor.execute("DELETE FROM AlertNotifications WHERE Id = ?", (notification_id,))
        conn.commit()
        conn.close()
        return jsonify({"success": True, "message": "✅ تم حذف الإشعار من السجل"})
    except Exception as e:
        return jsonify({"success": False, "message": str(e)}), 500


@app.route('/api/teachers-list')
def api_teachers_list():
    """قائمة المعلمين لربطهم بالفصول"""
    if session.get('role') not in ['مدير', 'مشرف']:
        return jsonify({"error": "غير مصرح"}), 401
    conn = get_db_connection()
    cursor = conn.cursor()
    cursor.execute("""
        SELECT Id, Name FROM Users
        WHERE Role = N'معلم' AND IsActive = 1
        ORDER BY Name
    """)
    rows = cursor.fetchall()
    conn.close()
    return jsonify([{"id": r.Id, "name": r.Name} for r in rows])


@app.route('/api/users/search')
def api_users_search():
    if session.get('role') not in ['مدير', 'مشرف']:
        return jsonify({"error": "غير مصرح"}), 401
    q = request.args.get('q', '').strip()
    if not q:
        return jsonify([])
    conn = get_db_connection()
    cursor = conn.cursor()
    cursor.execute("SELECT Id, Name, Role, ProfileImage FROM Users WHERE Name LIKE ? AND IsActive = 1", (f"%{q}%",))
    rows = cursor.fetchall()
    conn.close()
    return jsonify([{
        "id": r.Id,
        "name": r.Name,
        "role": r.Role,
        "profile_image": r.ProfileImage or ''  # ✅
    } for r in rows])

@app.route('/api/broadcast/send', methods=['POST'])
def api_broadcast_send():
    if session.get('role') not in ['مدير', 'مشرف']:
        return jsonify({"success": False, "message": "غير مصرح"}), 401
    data = request.get_json()
    role_filter = data.get('role_filter', 'all')
    message = data.get('message', '').strip()
    send_email_flag = data.get('send_email', True)
    send_telegram_flag = data.get('send_telegram', True)
    if not message:
        return jsonify({"success": False, "message": "الرسالة فارغة."}), 400
    valid_roles = ['all', 'طالب', 'معلم', 'مشرف', 'حارس']
    if role_filter not in valid_roles:
        return jsonify({"success": False, "message": "فلتر غير صحيح."}), 400
    result = send_broadcast_message(role_filter, message, send_email_flag, send_telegram_flag)
    msg_parts = []
    if send_email_flag: msg_parts.append(f"{result['email_count']} بريد")
    if send_telegram_flag: msg_parts.append(f"{result['telegram_count']} تيليجرام")
    success_msg = f"✅ تم إرسال الإعلان إلى {result['total_users']} مستخدم عبر: {' و '.join(msg_parts)}."
    if result['errors']:
        success_msg += f"\n⚠️ بعض الإرسالات فشلت: {', '.join(result['errors'][:3])}"
    return jsonify({"success": True, "message": success_msg, "details": result})


@app.route('/api/holidays', methods=['GET', 'POST'])
def api_holidays():
    if session.get('role') not in ['مدير', 'مشرف']:
        return jsonify({"error": "غير مصرح"}), 401
    if request.method == 'GET':
        conn = get_db_connection()
        cursor = conn.cursor()
        cursor.execute("SELECT Id, HolidayDate, EndDate, Description, HolidayType FROM Holidays ORDER BY HolidayDate DESC")
        rows = cursor.fetchall()
        conn.close()
        return jsonify([{"id": r.Id, "start_date": str(r.HolidayDate), "end_date": str(r.EndDate) if r.EndDate else None, "description": r.Description, "type": r.HolidayType or "عامة"} for r in rows])
    data = request.get_json()
    if not data.get('start_date'):
        return jsonify({"success": False, "message": "تاريخ البداية مطلوب"}), 400
    conn = get_db_connection()
    cursor = conn.cursor()
    cursor.execute("INSERT INTO Holidays (HolidayDate, EndDate, Description, HolidayType) VALUES (?, ?, ?, ?)", (data['start_date'], data.get('end_date'), data.get('description', ''), data.get('type', 'عامة')))
    conn.commit()
    conn.close()
    if not hasattr(app, '_last_holiday_notification'):
        app._last_holiday_notification = {}
    key = f"{data['start_date']}_{data.get('type', 'عامة')}"
    last_time = app._last_holiday_notification.get(key)
    if not last_time or (time.time() - last_time) > 300:
        send_holiday_notification(data, is_weekly=False)
        app._last_holiday_notification[key] = time.time()
    return jsonify({"success": True, "message": "تمت إضافة الإجازة."})


@app.route('/api/users/<int:uid>/full-details')
def api_user_full_details(uid):
    if session.get('role') not in ['مدير', 'مشرف']:
        return jsonify({"error": "غير مصرح"}), 401
  
    conn = get_db_connection()
    cursor = conn.cursor()
  
    cursor.execute("""
        SELECT Name, Role, Class, Age, Email, Phone, ParentEmail, ParentPhone, TelegramChatID, ProfileImage, Images
        FROM Users WHERE Id = ?
    """, (uid,))
    row = cursor.fetchone()
  
    if not row:
        conn.close()
        return jsonify({"error": "غير موجود"}), 404
  
    cursor.execute("SELECT COUNT(*) FROM Attendance WHERE UserId = ? AND Status = N'معذور'", (uid,))
    excuses_count = cursor.fetchone()[0]
    conn.close()
  
    try:
        images_data = json.loads(row.Images) if row.Images else []
    except (json.JSONDecodeError, TypeError, ValueError):
        images_data = []

    # ✅ تحويل المسارات إلى URLs صالحة للعرض
    profile_image = row.ProfileImage or ''
    if profile_image and not profile_image.startswith('http') and not profile_image.startswith('data:'):
        profile_image = '/' + profile_image.replace('\\', '/').lstrip('/')

    processed_images = []
    for img in images_data:
        if img and not img.startswith('http') and not img.startswith('data:'):
            processed_images.append('/' + img.replace('\\', '/').lstrip('/'))
        else:
            processed_images.append(img)

    # ✅ [Student Clean] لا نرسل الإيميل/الهاتف الشخصي للطالب
    if row.Role == 'طالب':
        email_val = None
        phone_val = None
    else:
        email_val = row.Email
        phone_val = row.Phone

    return jsonify({
        'name': row.Name,
        'role': row.Role,
        'class': row.Class,
        'age': row.Age,
        'email': email_val,
        'phone': phone_val,
        'parent_email': row.ParentEmail,
        'parent_phone': row.ParentPhone,
        'telegram_chat_id': row.TelegramChatID,
        'profile_image': profile_image,
        'excuses_count': excuses_count,
        'images': processed_images
    })


@app.route('/api/users/<int:uid>/update', methods=['POST'])
def api_user_update(uid):
    if session.get('role') not in ['مدير', 'مشرف']:
        return jsonify({"success": False, "message": "غير مصرح"}), 401
    data = request.get_json()
    name = (data.get('name') or '').strip()
    if not name:
        return jsonify({"success": False, "message": "الاسم مطلوب"}), 400
    role = data.get('role', 'طالب')
    if role in ['مدير', 'مشرف'] and session.get('role') != 'مدير':
        return jsonify({"success": False, "message": "فقط المدير يمكنه تعيين مدير أو مشرف"}), 403
    class_name = (data.get('class') or '').strip() or None
    age = data.get('age')
    email = (data.get('email') or '').strip() or None
    phone = (data.get('phone') or '').strip() or None
    parent_email = (data.get('parent_email') or '').strip() or None
    parent_phone = (data.get('parent_phone') or '').strip() or None
    new_telegram_chat_id = (data.get('telegram_chat_id') or '').strip() or None

    password = data.get('password')
    parent_password = data.get('parent_password')

    # ✅ [Student Clean] للطلاب: صفّر الإيميل والهاتف واستخدم كلمة مرور واحدة
    if role == 'طالب':
        email = None
        phone = None
        # استخدم نفس كلمة المرور للحقلين
        if password and not parent_password:
            parent_password = password
        elif parent_password and not password:
            password = parent_password

    password_hash = werkzeug.security.generate_password_hash(password) if password else None
    parent_password_hash = werkzeug.security.generate_password_hash(parent_password) if parent_password else None
    image_b64 = data.get('image')
    conn = get_db_connection()
    cursor = conn.cursor()
    try:
        cursor.execute("SELECT TelegramChatID FROM Users WHERE Id = ?", (uid,))
        current_chat_row = cursor.fetchone()
        current_chat_id = current_chat_row[0] if current_chat_row else None
        if image_b64:
            img_bytes = base64.b64decode(image_b64.split(',')[1])
            img = Image.open(io.BytesIO(img_bytes))
            if img.mode != 'RGB':
                img = img.convert('RGB')
            rgb = np.array(img)
            locs, embs = detect_and_extract_faces(rgb)
            if len(locs) == 0:
                conn.close()
                return jsonify({"success": False, "message": "لم يتم اكتشاف وجه."})
            if len(locs) > 1:
                conn.close()
                return jsonify({"success": False, "message": "تم اكتشاف أكثر من وجه."})
            new_encoding = embs[0]
            cursor.execute("SELECT Id, Name, Role, FaceEncoding FROM Users WHERE IsActive = 1 AND FaceEncoding IS NOT NULL AND FaceEncoding != '[]' AND Id != ?", (uid,))
            for u in cursor.fetchall():
                try:
                    existing_enc = np.array(json.loads(u.FaceEncoding))
                    if np.linalg.norm(existing_enc - new_encoding) < FACE_THRESHOLD:
                        conn.close()
                        return jsonify({"success": False, "message": f"⚠️ هذا الوجه مسجل مسبقاً."})
                except Exception:
                    pass
            new_encoding_json = json.dumps(new_encoding.tolist())
            cursor.execute("UPDATE Users SET FaceEncoding = ?, ProfileImage = ? WHERE Id = ?", (new_encoding_json, image_b64, uid))
        update_sql = "UPDATE Users SET Name=?, Role=?, Class=?, Age=?, Email=?, Phone=?, ParentEmail=?, ParentPhone=?"
        params = [name, role, class_name, age, email, phone, parent_email, parent_phone]
        if password_hash:
            update_sql += ", PasswordHash=?"
            params.append(password_hash)
        if parent_password_hash:
            update_sql += ", ParentPassword=?"
            params.append(parent_password_hash)
        update_sql += " WHERE Id=?"
        params.append(uid)
        cursor.execute(update_sql, params)
        if new_telegram_chat_id is not None and new_telegram_chat_id != current_chat_id:
            if new_telegram_chat_id:
                real_chat_id = get_chat_id_from_code(new_telegram_chat_id)
                if real_chat_id:
                    cursor.execute("UPDATE Users SET TelegramChatID = ? WHERE Id = ?", (str(real_chat_id), uid))
                    conn.commit()
                    sent = send_registration_confirmation(real_chat_id, name, role, name)
                    if sent:
                        load_users_cache()
                        conn.close()
                        return jsonify({"success": True, "message": "✅ تم التحديث."})
                    else:
                        cursor.execute("UPDATE Users SET TelegramChatID = ? WHERE Id = ?", (current_chat_id, uid))
                        conn.commit()
                        conn.close()
                        return jsonify({"success": False, "message": "⚠️ تم حفظ البيانات ولكن فشل إرسال الترحيب."}), 500
                else:
                    conn.close()
                    return jsonify({"success": False, "message": "⚠️ رمز التيليجرام غير صالح."}), 400
            else:
                cursor.execute("UPDATE Users SET TelegramChatID = NULL WHERE Id = ?", (uid,))
                conn.commit()
                load_users_cache()
                conn.close()
                return jsonify({"success": True, "message": "تم إلغاء ربط التيليجرام."})
        else:
            conn.commit()
            conn.close()
            load_users_cache()
            return jsonify({"success": True, "message": "تم التحديث."})
    except Exception as e:
        try:
            conn.close()
        except Exception:
            pass
        print(f"❌ خطأ في التحديث: {e}", flush=True)
        traceback.print_exc()
        return jsonify({"success": False, "message": str(e)}), 500


@app.route('/api/dropout-alerts')
def api_dropout_alerts():
    if session.get('role') not in ['مدير', 'مشرف']:
        return jsonify({"error": "غير مصرح"}), 401
    s, t = get_dropout_alerts()
    return jsonify({"students": s, "teachers": t})


@app.route('/api/dropout/send-pdf/<int:user_id>')
def api_dropout_send_pdf(user_id):
    if session.get('role') not in ['مدير', 'مشرف']:
        return jsonify({"error": "غير مصرح"}), 401
    conn = get_db_connection()
    cursor = conn.cursor()
    cursor.execute("SELECT Name, Role, ParentEmail, Email FROM Users WHERE Id = ?", (user_id,))
    user = cursor.fetchone()
    conn.close()
    if not user:
        return jsonify({"success": False, "message": "غير موجود."})
    s, t = get_dropout_alerts()
    data, role = None, user.Role
    for x in s:
        if x['id'] == user_id:
            data = x
            break
    if not data:
        for x in t:
            if x['id'] == user_id:
                data = x
                role = 'معلم'
                break
    if not data:
        return jsonify({"success": False, "message": "لم يتجاوز الحد."})
    pdf_path = generate_dropout_pdf(user.Name, role, data)
    recipient = user.ParentEmail if role == 'طالب' else user.Email
    if recipient:
        send_email(recipient, "🚨 إنذار تسرب", "مرفق تقرير.", pdf_path)
        return jsonify({"success": True, "message": f"تم الإرسال إلى {recipient}"})
    return jsonify({"success": False, "message": "لا يوجد بريد."})


@app.route('/test-camera')
def test_camera():
    settings = load_settings()
    rtsp_url = settings.get('rtsp_url', '')
    try:
        cap = cv2.VideoCapture(rtsp_url) if rtsp_url else cv2.VideoCapture(0)
        if not cap.isOpened():
            return jsonify({"error": "Cannot open camera"})
        time.sleep(1)
        ret, frame = cap.read()
        cap.release()
        if not ret:
            return jsonify({"error": "Cannot read frame"})
        locs, _ = detect_and_extract_faces(cv2.cvtColor(frame, cv2.COLOR_BGR2RGB))
        return jsonify({"success": True, "faces_detected": len(locs)})
    except Exception as e:
        return jsonify({"error": str(e)})


@app.route('/api/recognize', methods=['POST'])
def api_recognize():
    try:
        data = request.get_json()
        if not data or 'image' not in data:
            return jsonify({"success": False, "message": "بيانات غير مكتملة"}), 400
        img = Image.open(io.BytesIO(base64.b64decode(data['image'].split(',')[1])))
        if img.mode != 'RGB':
            img = img.convert('RGB')
        names, locs, err = recognize_faces_in_image(np.array(img))
        if err:
            return jsonify({"success": False, "message": err}), 400
        locs_list = [{"top": int(t), "right": int(r), "bottom": int(b), "left": int(l)} for t, r, b, l in locs]
        return jsonify({"success": True, "names": names, "locations": locs_list, "count": len(names)})
    except Exception as e:
        print(f"❌ خطأ في api_recognize: {e}", flush=True)
        traceback.print_exc()
        return jsonify({"success": False, "message": str(e)}), 500


@app.route('/api/attendance/today')
def api_attendance_today():
    if session.get('role') not in ['مدير', 'مشرف']:
        return jsonify({"error": "غير مصرح"}), 401
    today = datetime.now().strftime("%Y-%m-%d")
    conn = get_db_connection()
    cursor = conn.cursor()
    cursor.execute("""
        SELECT u.Id, u.Name, u.Role, u.Class, u.ProfileImage,
               COUNT(a.Id) as TimesCount,
               MIN(a.CheckInTime) as FirstCheckIn,
               MAX(a.CheckInTime) as LastCheckIn
        FROM Attendance a JOIN Users u ON a.UserId = u.Id
        WHERE a.AttendanceDate = ?
        GROUP BY u.Id, u.Name, u.Role, u.Class, u.ProfileImage
    """, (today,))
    rows = cursor.fetchall()

    cursor.execute("""
        SELECT u.Name, a.CheckInTime FROM Attendance a JOIN Users u ON a.UserId = u.Id
        WHERE a.AttendanceDate = ? ORDER BY u.Name, a.CheckInTime
    """, (today,))
    detail_rows = cursor.fetchall()
    conn.close()
    times_dict = {}
    for r in detail_rows:
        if r.Name not in times_dict:
            times_dict[r.Name] = []
        times_dict[r.Name].append(str(r.CheckInTime))
    result = []
    for r in rows:
        result.append({
            'user_id': r.Id,
            'name': r.Name,
            'role': r.Role,
            'class': r.Class,
            'profile_image': r.ProfileImage or '',  # ✅ صورة المستخدم
            'times_count': r.TimesCount,
            'first_checkin': str(r.FirstCheckIn) if r.FirstCheckIn else '-',
            'last_checkin': str(r.LastCheckIn) if r.LastCheckIn else '-',
            'checkin_times': times_dict.get(r.Name, [])
        })
    return jsonify(result)

@app.route('/api/enroll', methods=['POST'])
def api_enroll():
    if session.get('role') not in ['مدير', 'مشرف']:
        return jsonify({"success": False, "message": "غير مصرح"}), 401

    data = request.get_json()
    role = data.get('role', 'طالب')
    if role in ['مدير', 'مشرف'] and session.get('role') != 'مدير':
        return jsonify({"success": False, "message": "فقط المدير يمكنه إضافة مدير أو مشرف."}), 403

    conn = None
    temp_folder = None
    try:
        name = (data.get('name') or '').strip()
        if not name:
            return jsonify({"success": False, "message": "الاسم مطلوب"}), 400

        class_name = (data.get('class') or '').strip() or None
        sid = (data.get('student_id') or '').strip() or None
        age = data.get('age')
        email = (data.get('email') or '').strip() or None
        phone = (data.get('phone') or '').strip() or None
        p_email = (data.get('parent_email') or '').strip() or None
        p_phone = (data.get('parent_phone') or '').strip() or None

        # ✅ [Student Clean] للطلاب: لا إيميل شخصي ولا هاتف شخصي
        if role == 'طالب':
            email = None
            phone = None
        subjects = data.get('subjects', []) if role == 'معلم' else []
        working_days = data.get('working_days', [0,1,2,3,4]) if role == 'معلم' else []
        max_periods = data.get('max_periods', 7) if role == 'معلم' else 7

        # ============================================================
        # ✅ [الإصلاح] كلمة مرور المستخدم — دعم كامل للطلاب
        # ============================================================
        pw = data.get('password')
        parent_pw = data.get('parent_password')

        # ✅ للطالب: كلمة مرور ولي الأمر هي الأساس
        if role == 'طالب':
            if not parent_pw:
                # إذا لم تُدخل كلمة مرور → استخدم رقم القيد أو اسم الطالب كافتراضي
                parent_pw = sid or name
                print(f"⚠️ كلمة مرور افتراضية لولي الأمر '{name}': {parent_pw}", flush=True)
            pw = parent_pw  # ✅ كلمة واحدة للحقلين

        # للمستخدمين الآخرين
        if not pw:
            pw = sid or name

        pw_hash = werkzeug.security.generate_password_hash(pw) if pw else None
        parent_pw_hash = werkzeug.security.generate_password_hash(parent_pw) if parent_pw else None 
        # ============================================================

        telegram_chat_id = (data.get('telegram_chat_id') or '').strip() or None

        all_embeddings = []
        image_paths = []
        debug_info = []

        if 'images' in data and isinstance(data['images'], list) and len(data['images']) > 0:
            import uuid
            temp_folder = f"uploads/faces/temp_{uuid.uuid4().hex[:8]}"
            os.makedirs(temp_folder, exist_ok=True)

            for idx, img_b64 in enumerate(data['images']):
                img_debug = {"index": idx + 1, "status": "unknown"}
                try:
                    img_data = base64.b64decode(img_b64.split(',')[1])
                    img = Image.open(io.BytesIO(img_data))
                    if img.mode != 'RGB':
                        img = img.convert('RGB')

                    filename = f"{idx+1}.jpg"
                    filepath = os.path.join(temp_folder, filename)
                    img.save(filepath, 'JPEG', quality=95, subsampling=0)
                    image_paths.append(filepath.replace('\\', '/'))

                    rgb_original = np.array(img)
                    img_std = float(rgb_original.std())
                    img_debug["std"] = round(img_std, 2)
                    img_debug["shape"] = list(rgb_original.shape)

                    if img_std < 10:
                        print(f"⚠️ الصورة {idx+1} سوداء (std={img_std:.2f})", flush=True)
                        img_debug["status"] = "black_image"
                        debug_info.append(img_debug)
                        continue

                    h, w = rgb_original.shape[:2]
                    if w > 1280:
                        ratio = 1280 / w
                        rgb_original = cv2.resize(rgb_original, (1280, int(h * ratio)))
                        img_debug["resized_to"] = [1280, int(h * ratio)]

                    print(f"🔍 الصورة {idx+1}: shape={rgb_original.shape}, std={img_std:.2f}", flush=True)

                    locs, embs = detect_and_extract_faces(rgb_original)
                    print(f"   ➜ الكشف على الأصلية: {len(locs)} وجه", flush=True)

                    if len(locs) == 0:
                        lab = cv2.cvtColor(rgb_original, cv2.COLOR_RGB2LAB)
                        l, a, b = cv2.split(lab)
                        clahe = cv2.createCLAHE(clipLimit=2.0, tileGridSize=(8, 8))
                        l = clahe.apply(l)
                        lab = cv2.merge((l, a, b))
                        rgb_enhanced = cv2.cvtColor(lab, cv2.COLOR_LAB2RGB)
                        locs, embs = detect_and_extract_faces(rgb_enhanced)
                        print(f"   ➜ الكشف على المحسّنة: {len(locs)} وجه", flush=True)

                    if len(locs) > 0:
                        all_embeddings.append(embs[0].tolist())
                        img_debug["status"] = "face_detected"
                        img_debug["faces_found"] = len(locs)
                    else:
                        img_debug["status"] = "no_face"
                        print(f"❌ لا يوجد وجه في الصورة {idx+1}", flush=True)

                except Exception as e:
                    print(f"⚠️ خطأ في الصورة {idx+1}: {e}", flush=True)
                    traceback.print_exc()
                    img_debug["status"] = "error"
                    img_debug["error"] = str(e)
                debug_info.append(img_debug)

            if len(all_embeddings) == 0:
                import shutil
                if temp_folder and os.path.exists(temp_folder):
                    shutil.rmtree(temp_folder)
                error_details = []
                for d in debug_info:
                    if d["status"] == "black_image":
                        error_details.append(f"صورة {d['index']}: سوداء")
                    elif d["status"] == "no_face":
                        error_details.append(f"صورة {d['index']}: لا يوجد وجه")
                    elif d["status"] == "error":
                        error_details.append(f"صورة {d['index']}: خطأ")
                detail_msg = " | ".join(error_details) if error_details else "تحقق من الإضاءة"
                return jsonify({"success": False, "message": f"لم يتم اكتشاف أي وجه. التفاصيل: {detail_msg}", "debug": debug_info})

            # ✅ تطبيع (L2) بعد الحساب — يضمن المقارنة الصحيحة
            mean_emb_np = np.mean(np.array(all_embeddings), axis=0)
            norm = np.linalg.norm(mean_emb_np)
            if norm > 0:
                mean_emb_np = mean_emb_np / norm
            mean_embedding = mean_emb_np.tolist()
            encoding_json = json.dumps(mean_embedding)
            print(f"✅ تم استخراج {len(all_embeddings)} بصمة.", flush=True)
        else:
            return jsonify({"success": False, "message": "الصورة مطلوبة"}), 400

        # ==================== فحص التكرار ====================
        conn = get_db_connection()
        cursor = conn.cursor()
        cursor.execute("""
            SELECT Id, Name, Role, FaceEncoding FROM Users
            WHERE IsActive = 1 AND FaceEncoding IS NOT NULL AND FaceEncoding != '[]'
        """)
        mean_emb_arr = np.array(json.loads(encoding_json))

        for u in cursor.fetchall():
            try:
                existing_enc_data = json.loads(u.FaceEncoding)
                if isinstance(existing_enc_data, list) and len(existing_enc_data) > 0:
                    if isinstance(existing_enc_data[0], list):
                        existing_embeddings = existing_enc_data
                    else:
                        existing_embeddings = [existing_enc_data]

                    for existing_emb in existing_embeddings:
                        if np.linalg.norm(np.array(existing_emb) - mean_emb_arr) < FACE_THRESHOLD:
                            conn.close()
                            import shutil
                            if temp_folder and os.path.exists(temp_folder):
                                shutil.rmtree(temp_folder)
                            return jsonify({"success": False, "message": f"⚠️ الوجه مسجل باسم '{u.Name}'."})
            except Exception as ex:
                print(f"⚠️ خطأ مقارنة {u.Name}: {ex}", flush=True)

        # ==================== فحص رمز التيليجرام ====================
        actual_chat_id = None
        if telegram_chat_id:
            actual_chat_id = get_chat_id_from_code(telegram_chat_id)
            if not actual_chat_id:
                conn.close()
                import shutil
                if temp_folder and os.path.exists(temp_folder):
                    shutil.rmtree(temp_folder)
                return jsonify({"success": False, "message": "⚠️ رمز التيليجرام غير صالح."}), 400

        # ==================== ✅ إدراج واحد فقط مع OUTPUT INSERTED.Id ====================
        cursor.execute("""
            INSERT INTO Users
            (Name, Role, Class, AcademicYear, StudentId, Age, Email, Phone, FaceEncoding, IsActive,
            ParentEmail, ParentPhone, PasswordHash, Username, ParentUsername, ParentPassword,
            TelegramChatID, ProfileImage, WorkingDays, MaxPeriodsPerDay)
            OUTPUT INSERTED.Id
            VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, 1, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
        """, (
            name, role, class_name, datetime.now().year, sid, age, email, phone, encoding_json,
            p_email, p_phone, pw_hash, name,
            (data.get('parent_username') or '').strip() or None,
            parent_pw_hash, actual_chat_id, None,
            ','.join(str(x) for x in working_days) if role == 'معلم' else None,
            max_periods
        ))

        row = cursor.fetchone()
        if not row or row[0] is None:
            conn.rollback()
            conn.close()
            import shutil
            if temp_folder and os.path.exists(temp_folder):
                shutil.rmtree(temp_folder)
            print(f"❌ فشل الحصول على new_user_id بعد INSERT", flush=True)
            return jsonify({"success": False, "message": "فشل إنشاء المستخدم في قاعدة البيانات"}), 500

        new_user_id = int(row[0])
        conn.commit()
        print(f"✅ تم إنشاء مستخدم جديد #{new_user_id}", flush=True)

        # ==================== نقل مجلد الصور ====================
        final_folder = f"uploads/faces/user_{new_user_id}"
        saved_images_count = 0
        import shutil

        if temp_folder and os.path.exists(temp_folder):
            if os.path.exists(final_folder):
                shutil.rmtree(final_folder)
            os.rename(temp_folder, final_folder)
            temp_folder = None

            final_paths = [f"uploads/faces/user_{new_user_id}/{i+1}.jpg" for i in range(len(image_paths))]
            final_profile = final_paths[0] if final_paths else None
            saved_images_count = len(final_paths)

            cursor.execute(
                "UPDATE Users SET ProfileImage = ?, Images = ? WHERE Id = ?",
                (final_profile, json.dumps(final_paths), new_user_id)
            )
            conn.commit()
        if role == 'معلم' and subjects:
            for sub in subjects:
                cursor.execute("INSERT INTO TeacherSubjects (TeacherId, Subject) VALUES (?, ?)", (new_user_id, sub))
            conn.commit()
        conn.close()
        conn = None

        # ==================== إرسال الترحيبات ====================
        if actual_chat_id:
            sent = send_registration_confirmation(actual_chat_id, name, role, name)
            if not sent:
                load_users_cache()
                return jsonify({
                    "success": True,
                    "warning": True,
                    "message": f"✅ تم إضافة {name} مع {saved_images_count} صورة، لكن فشل إرسال الترحيب."
                }), 200

        recipient_email = p_email if role == 'طالب' else email
        if recipient_email:
            send_welcome_email(role, name, recipient_email, student_name=name if role == 'طالب' else None)

        load_users_cache()
        return jsonify({
            "success": True,
            "message": f"✅ تم إضافة {name} بنجاح مع {saved_images_count} صورة.",
            "debug": debug_info
        })

    except Exception as e:
        print(f"❌ خطأ في التسجيل: {e}", flush=True)
        traceback.print_exc()
        try:
            if conn:
                conn.close()
        except Exception:
            pass
        try:
            if temp_folder and os.path.exists(temp_folder):
                import shutil
                shutil.rmtree(temp_folder)
        except Exception:
            pass
        return jsonify({"success": False, "message": str(e)}), 500
    
    

@app.route('/api/detect_faces', methods=['POST'])
def api_detect_faces():
    try:
        data = request.get_json()
        if not data or 'image' not in data:
            return jsonify({"success": False, "message": "بيانات غير مكتملة"}), 400
        img = Image.open(io.BytesIO(base64.b64decode(data['image'].split(',')[1])))
        if img.mode != 'RGB':
            img = img.convert('RGB')
        rgb = np.array(img)
        locs, _ = detect_and_extract_faces(rgb)
        locations = [{"top": int(top), "right": int(right), "bottom": int(bottom), "left": int(left)} for top, right, bottom, left in locs]
        return jsonify({"success": True, "count": len(locs), "locations": locations})
    except Exception as e:
        print(f"❌ خطأ في detect_faces: {e}", flush=True)
        traceback.print_exc()
        return jsonify({"success": False, "message": str(e)}), 500


@app.route('/api/users')
def api_users():
    if session.get('role') not in ['مدير', 'مشرف']:
        return jsonify({"error": "غير مصرح"}), 401
    conn = get_db_connection()
    cursor = conn.cursor()
    cursor.execute("SELECT Id, Name, Role, Class, StudentId, IsActive FROM Users ORDER BY Name ASC")
    rows = cursor.fetchall()
    conn.close()
    return jsonify([{'id': r.Id, 'name': r.Name, 'role': r.Role, 'class': r.Class, 'studentId': r.StudentId, 'isActive': r.IsActive} for r in rows])

