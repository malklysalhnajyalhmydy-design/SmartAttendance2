def _normalize_class(name):
    """توحيد اسم الفصل للمقارنة:
    - 'الصف السادس' → 'سادس'
    - 'السادس'     → 'سادس'
    - 'أول ثانوي'  → 'أول ثانوي' (بدون كسر)
    """
    if not name:
        return ""
    n = str(name).strip()
    # إزالة "الصف" أو "صف" مع مسافة قبلها/بعدها
    n = n.replace("الصف ", "").replace("الصف", "").replace("صف ", "").replace("صف", "").strip()
    # إزالة "ال" التعريف فقط إذا كانت الكلمة طويلة (تجنب كسر "الأول" → "ول")
    if n.startswith("ال") and len(n) > 3:
        n = n[2:]
    return n.strip()

def _create_alert(classroom_id, classroom_name, user_id, user_name,
                  alert_type, description, teacher_id=None, image_b64=None):
    """إنشاء إنذار في قاعدة البيانات + إرسال إشعارات + حفظ فيديو"""
    try:
        classroom_id = int(classroom_id) if classroom_id is not None else None
        user_id = int(user_id) if user_id is not None else None
        teacher_id = int(teacher_id) if teacher_id is not None else None

        # 1. حفظ الصورة
        image_path = None
        if image_b64:
            try:
                import uuid
                os.makedirs('uploads/alerts/images', exist_ok=True)
                fname = f"alert_{uuid.uuid4().hex[:12]}.jpg"
                fpath = os.path.join('uploads/alerts/images', fname)
                img_data = base64.b64decode(image_b64.split(',')[1])
                with open(fpath, 'wb') as f:
                    f.write(img_data)
                image_path = f"uploads/alerts/images/{fname}"
            except Exception as e:
                print(f"⚠️ فشل حفظ صورة الإنذار: {e}", flush=True)

        # 2. الإدراج في جدول Alerts
        conn = get_db_connection()
        cursor = conn.cursor()
             # ✅ استخدام OUTPUT INSERTED.Id (أكثر موثوقية من SCOPE_IDENTITY)
        cursor.execute("""
            INSERT INTO Alerts
            (ClassroomId, ClassroomName, UserId, UserName,
             AlertType, Description, ImagePath, IsRead, CreatedAt, ReviewStatus)
            OUTPUT INSERTED.Id
            VALUES (?, ?, ?, ?, ?, ?, ?, 0, GETDATE(), 'pending')
        """, (classroom_id, classroom_name, user_id, user_name,
              alert_type, description, image_path))

        row = cursor.fetchone()
        if not row or row[0] is None:
            conn.rollback()
            conn.close()
            print(f"❌ فشل الحصول على alert_id بعد INSERT", flush=True)
            return None

        alert_id = int(row[0])
        conn.commit()
        conn.close()
        print(f"✅ تم إنشاء إنذار #{alert_id}", flush=True)

        # ============================================================
        # ✅ [الجزء 4] استبدل كتلة بدء تسجيل الفيديو بهذه
        # ============================================================
        try:
            # ✅ جلب camera_ip مرة واحدة (خارج thread التسجيل)
            camera_ip = None
            if classroom_id:
                try:
                    conn2 = get_db_connection()
                    cur2 = conn2.cursor()
                    cur2.execute("SELECT CameraIP FROM Classrooms WHERE Id = ?", (classroom_id,))
                    row2 = cur2.fetchone()
                    if row2:
                        camera_ip = row2.CameraIP
                    conn2.close()
                except Exception as e:
                    print(f"⚠️ فشل جلب camera_ip: {e}", flush=True)

            if camera_ip:
                save_alert_video(classroom_id, alert_id, camera_ip, pre_seconds=10, post_seconds=10)
            else:
                print(f"⚠️ تخطي تسجيل فيديو #{alert_id} — لا يوجد camera_ip", flush=True)
        except Exception as e:
            print(f"⚠️ فشل بدء تسجيل الفيديو: {e}", flush=True)
        # ============================================================

        # 4. إرسال الإشعارات
        _notify_alert(alert_type, description, classroom_name,
                      user_name, teacher_id, image_path)

        print(f"🚨 إنذار جديد #{alert_id}: [{alert_type}] {description}", flush=True)
        return alert_id
    except Exception as e:
        print(f"❌ فشل إنشاء الإنذار: {e}", flush=True)
        traceback.print_exc()
        return None


def _notify_alert(alert_type, description, classroom_name, user_name, teacher_id=None, image_path=None):
    """إرسال إشعار الإنذار للجميع - نسخة محسّنة مع Fallback"""
    try:
        type_icons = {
            'stranger': '👤❓',
            'wrong_class': '🎓⚠️',
            'banned_item': '🚫',
            'fire': '🔥',
            'unauthorized_entry': '🚷'
        }
        icon = type_icons.get(alert_type, '🚨')
        now_str = datetime.now().strftime("%Y-%m-%d %H:%M")

        message = (
            f"{icon} <b>إنذار أمني</b>\n\n"
            f"🏫 <b>الفصل:</b> {classroom_name}\n"
            f"📋 <b>النوع:</b> {description}\n"
            f"⏰ <b>الوقت:</b> {now_str}"
        )

        recipients_chat = set()
        recipients_email = set()

        try:
            conn = get_db_connection()
            cursor = conn.cursor()

            cursor.execute("SELECT TelegramChatID, Email FROM Users WHERE Role = N'مدير' AND IsActive = 1")
            for r in cursor.fetchall():
                if r.TelegramChatID:
                    recipients_chat.add(str(r.TelegramChatID))
                if r.Email:
                    recipients_email.add(r.Email)

            cursor.execute("SELECT TelegramChatID, Email FROM Users WHERE Role = N'مشرف' AND IsActive = 1")
            for r in cursor.fetchall():
                if r.TelegramChatID:
                    recipients_chat.add(str(r.TelegramChatID))
                if r.Email:
                    recipients_email.add(r.Email)

            if teacher_id:
                cursor.execute("SELECT TelegramChatID, Email FROM Users WHERE Id = ?", (teacher_id,))
                r = cursor.fetchone()
                if r:
                    if r.TelegramChatID:
                        recipients_chat.add(str(r.TelegramChatID))
                    if r.Email:
                        recipients_email.add(r.Email)

            if not recipients_chat and not recipients_email:
                settings = load_settings()
                admin_chat = settings.get('admin_telegram_chat_id')
                admin_email = settings.get('admin_email') or EMAIL_SENDER
                if admin_chat:
                    recipients_chat.add(str(admin_chat))
                if admin_email:
                    recipients_email.add(admin_email)
                print(f"ℹ️ لا يوجد مدير/مشرف — استخدام حساب المسؤول من الإعدادات", flush=True)

            if not recipients_chat and not recipients_email:
                print(f"⚠️ لا يوجد مستلمون للإنذار — لم يتم إرسال إشعار", flush=True)

            conn.close()
        except Exception as e:
            print(f"⚠️ فشل جلب المستلمين: {e}", flush=True)
            traceback.print_exc()

        for chat in recipients_chat:
            send_telegram(chat, message)

        if alert_type in ['fire', 'banned_item', 'stranger', 'wrong_class']:
            for email in recipients_email:
                send_email(email, f"🚨 إنذار: {description}",
                           f"{description}\n\nالفصل: {classroom_name}\nالوقت: {now_str}")

        print(f"📨 تم إرسال الإنذار إلى {len(recipients_chat)} تيليجرام + {len(recipients_email)} إيميل", flush=True)
    except Exception as e:
        print(f"❌ فشل إرسال الإشعارات: {e}", flush=True)
        traceback.print_exc()


def _build_default_message(alert_id):
    """بناء الرسالة الأولية حسب نوع الإنذار (مع معالجة آمنة للتاريخ)"""
    try:
        conn = get_db_connection()
        cursor = conn.cursor()
        cursor.execute("""
            SELECT AlertType, ClassroomName, UserName, CreatedAt, Description
            FROM Alerts WHERE Id = ?
        """, (alert_id,))
        row = cursor.fetchone()

        if not row:
            conn.close()
            return None

        student_class = ''
        if row.UserName:
            cursor.execute("SELECT Class FROM Users WHERE Name = ? AND Role = N'طالب'", (row.UserName,))
            sc = cursor.fetchone()
            if sc and sc.Class:
                student_class = sc.Class
        conn.close()

        template = MESSAGE_TEMPLATES.get(row.AlertType)
        if not template:
            return f"عزيزي ولي الأمر،\n\n{row.Description or ''}\n\nمع تحية إدارة المدرسة"

        # ✅ إصلاح: معالجة CreatedAt سواء كان datetime أو str
        dt = row.CreatedAt
        if dt is None:
            date_str = "—"
            time_str = "—"
        elif isinstance(dt, str):
            try:
                dt_obj = datetime.strptime(dt, "%Y-%m-%d %H:%M:%S")
                date_str = dt_obj.strftime("%Y-%m-%d")
                time_str = dt_obj.strftime("%H:%M")
            except Exception:
                date_str = dt[:10] if len(dt) >= 10 else dt
                time_str = dt[11:16] if len(dt) >= 16 else "—"
        else:
            date_str = dt.strftime("%Y-%m-%d")
            time_str = dt.strftime("%H:%M")

        body = template['body'].format(
            classroom_name=row.ClassroomName or '—',
            date=date_str,
            time=time_str,
            student_name=row.UserName or '—',
            student_class=student_class or '—'
        )
        return body
    except Exception as e:
        print(f"❌ خطأ في بناء الرسالة: {e}", flush=True)
        traceback.print_exc()
        return None


def send_parent_notification(notification_id):
    """إرسال إشعار إلى ولي الأمر (نصي + صورة)"""
    try:
        conn = get_db_connection()
        cursor = conn.cursor()
        cursor.execute("""
            SELECT Id, AlertId, RecipientName, RecipientEmail, RecipientChat,
                   MessageText, ImagePath, SentVia, IsCorrection, CorrectionReason
            FROM AlertNotifications
            WHERE Id = ?
        """, (notification_id,))
        row = cursor.fetchone()
        conn.close()

        if not row:
            return {"success": False, "message": "الإشعار غير موجود"}

        message_text = row.MessageText
        image_path = row.ImagePath if row.ImagePath and os.path.exists(row.ImagePath) else None
        sent_count = 0
        errors = []

        if row.RecipientEmail and row.SentVia in ['email', 'both']:
            if _send_email_with_inline_image(row.RecipientEmail, message_text, image_path, row.IsCorrection):
                sent_count += 1
            else:
                errors.append("فشل الإيميل")

        if row.RecipientChat and row.SentVia in ['telegram', 'both']:
            if _send_telegram_with_photo(str(row.RecipientChat), message_text, image_path):
                sent_count += 1
            else:
                errors.append("فشل التلجرام")

        conn = get_db_connection()
        cursor = conn.cursor()
        if sent_count > 0:
            cursor.execute("UPDATE AlertNotifications SET Status = 'sent' WHERE Id = ?", (notification_id,))
            cursor.execute("UPDATE Alerts SET ParentNotified = 1 WHERE Id = ?", (row.AlertId,))
        else:
            cursor.execute("UPDATE AlertNotifications SET Status = 'failed', ErrorMessage = ? WHERE Id = ?",
                           (" و ".join(errors), notification_id))
        conn.commit()
        conn.close()

        if sent_count > 0:
            return {"success": True, "message": f"✅ تم الإرسال بنجاح ({sent_count} قناة)"}
        else:
            return {"success": False, "message": f"❌ فشل: {' و '.join(errors)}"}
    except Exception as e:
        print(f"❌ خطأ في send_parent_notification: {e}", flush=True)
        traceback.print_exc()
        return {"success": False, "message": str(e)}


def _send_email_with_inline_image(to_email, message_text, image_path, is_correction=False):
    """إرسال إيميل مع صورة مضمّنة — بنية MIME مبسطة لتجنب Spam"""
    try:
        from email.mime.image import MIMEImage

        subject_prefix = "✏️ تصحيح رسالة سابقة" if is_correction else "🚨 إشعار من إدارة المدرسة"

        # ✅ بنية مبسطة: alternative (نص + html) + صورة مضمّنة
        msg = MIMEMultipart('alternative')
        msg['From'] = EMAIL_SENDER
        msg['To'] = to_email
        msg['Subject'] = subject_prefix

        # 1. نص عادي (fallback للعملاء القديمة)
        msg.attach(MIMEText(message_text, 'plain', 'utf-8'))

        # 2. HTML مع صورة
        if image_path and os.path.exists(image_path):
            text_with_break = message_text.replace('\n', '<br>')
            html_body = f"""
            <html><body style="font-family: 'Cairo', Arial, sans-serif; direction: rtl; text-align: right; line-height: 1.8;">
                <div style="max-width: 600px; margin: 0 auto; padding: 20px; background: #f9f9f9; border-radius: 10px;">
                    <p>{text_with_break}</p>
                    <div style="margin-top: 20px; text-align: center;">
                        <img src="cid:alert_image" style="max-width: 100%; border-radius: 10px; border: 1px solid #ddd;">
                    </div>
                </div>
            </body></html>
            """
            # نجمع html + image في related ثم نرفقها بداخل alternative
            related = MIMEMultipart('related')
            related.attach(MIMEText(html_body, 'html', 'utf-8'))

            with open(image_path, 'rb') as f:
                img_data = f.read()
            image = MIMEImage(img_data)
            image.add_header('Content-ID', '<alert_image>')
            image.add_header('Content-Disposition', 'inline', filename=os.path.basename(image_path))
            related.attach(image)

            msg.attach(related)
        else:
            text_with_break = message_text.replace('\n', '<br>')
            html_body = f"""
            <html><body style="font-family: 'Cairo', Arial, sans-serif; direction: rtl; text-align: right; line-height: 1.8;">
                <div style="max-width: 600px; margin: 0 auto; padding: 20px; background: #f9f9f9; border-radius: 10px;">
                    <p>{text_with_break}</p>
                </div>
            </body></html>
            """
            msg.attach(MIMEText(html_body, 'html', 'utf-8'))

        server = smtplib.SMTP('smtp.gmail.com', 587, timeout=NETWORK_TIMEOUT)
        server.starttls()
        server.login(EMAIL_SENDER, EMAIL_PASSWORD)
        server.send_message(msg)
        server.quit()
        print(f"✅ بريد إلى {to_email}", flush=True)
        return True
    except Exception as e:
        print(f"❌ بريد: {e}", flush=True)
        return False


def _send_telegram_with_photo(chat_id, message_text, image_path):
    """إرسال نص + صورة على تلجرام (آمن عند انقطاع الإنترنت)"""
    if not TELEGRAM_TOKEN:
        return False

    # ✅ فحص الإنترنت
    if not app.config.get('INTERNET_AVAILABLE', True):
        if not check_internet_available():
            # احفظ للطبع لاحقاً
            save_pending_notification('telegram', str(chat_id), message_text)
            print(f"📥 إشعار تلجرام (نص) مؤجل لـ {chat_id}", flush=True)
            return False
        app.config['INTERNET_AVAILABLE'] = True

    try:
        # 1. إرسال النص
        text_ok = send_telegram(chat_id, message_text)

        # 2. إرسال الصورة (إن وُجدت)
        if image_path and os.path.exists(image_path):
            try:
                url = f"https://api.telegram.org/bot{TELEGRAM_TOKEN}/sendPhoto"
                with open(image_path, 'rb') as f:
                    files = {'photo': f}
                    data = {'chat_id': chat_id}
                    r = requests.post(url, data=data, files=files, timeout=30)
                    result = r.json()
                    if not result.get('ok'):
                        print(f"⚠️ فشل إرسال الصورة: {result.get('description')}", flush=True)
            except requests.exceptions.ConnectionError:
                mark_internet_unavailable()
                print(f"⚠️ انقطع الإنترنت أثناء إرسال الصورة — تم إرسال النص فقط", flush=True)
            except Exception as e:
                print(f"⚠️ خطأ في إرسال الصورة: {e}", flush=True)

        return text_ok
    except Exception as e:
        print(f"❌ خطأ في _send_telegram_with_photo: {e}", flush=True)
        return False




# ==================== 🏥 Health Check & Monitoring ====================
_START_TIME = time.time()


def check_camera_health():
    """فحص صحة الكاميرات وإرسال تنبيه عند الفشل > 5 دقائق"""
    try:
        now = time.time()
        broken = []
        with persistent_captures_lock:
            for cid, entry in list(persistent_captures.items()):
                last_ok = entry.get('last_ok', 0)
                if last_ok and (now - last_ok) > 300:
                    broken.append(cid)

        if broken:
            try:
                conn = get_db_connection()
                cursor = conn.cursor()
                placeholders = ','.join(['?'] * len(broken))
                cursor.execute(
                    f"SELECT Id, Name FROM Classrooms WHERE Id IN ({placeholders})",
                    broken
                )
                names = [f"#{r.Id} ({r.Name})" for r in cursor.fetchall()]
                conn.close()

                settings = load_settings()
                admin_chat = settings.get('admin_telegram_chat_id')
                if admin_chat:
                    msg = f"⚠️ <b>كاميرات معطلة</b>\n\n{chr(10).join(names)}\n\nمنذ أكثر من 5 دقائق"
                    send_telegram(admin_chat, msg)
                    print(f"📢 تنبيه: {len(broken)} كاميرا معطلة", flush=True)
            except Exception as e:
                print(f"⚠️ خطأ في جلب أسماء الكاميرات: {e}", flush=True)
    except Exception as e:
        print(f"⚠️ خطأ في check_camera_health: {e}", flush=True)


def backup_database():
    """نسخ احتياطي لقاعدة البيانات"""
    try:
        os.makedirs('backups', exist_ok=True)
        timestamp = datetime.now().strftime('%Y%m%d_%H%M%S')
        backup_file = f"backups/SmartAttendance_{timestamp}.bak"

        conn = get_db_connection()
        cursor = conn.cursor()
        cursor.execute(f"""
            BACKUP DATABASE [SmartAttendanceDB]
            TO DISK = N'{os.path.abspath(backup_file)}'
            WITH FORMAT, INIT, NAME = N'SmartAttendance Backup',
            SKIP, NOREWIND, NOUNLOAD, STATS = 10
        """)
        conn.commit()
        conn.close()

        # احذف النسخ الأقدم من 30 يوم
        cutoff = datetime.now() - timedelta(days=30)
        for f in os.listdir('backups'):
            path = os.path.join('backups', f)
            if f.endswith('.bak') and os.path.getmtime(path) < cutoff.timestamp():
                os.remove(path)

        print(f"✅ Backup: {backup_file}", flush=True)
    except Exception as e:
        print(f"⚠️ فشل Backup: {e}", flush=True)


