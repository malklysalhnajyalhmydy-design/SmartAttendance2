@app.route('/api/classroom/detect', methods=['POST'])
def api_classroom_detect():
    """
    الكشف على كاميرا فصل معيّن:
    - التعرف على الوجوه
    - كشف الشخص الغريب
    - كشف الطالب في الفصل الخطأ
    - كشف الحريق/الدخان
    - إرسال إشعارات + تسجيل في جدول Alerts
    مع فترة تهدئة (Cooldown) لمنع تكرار الإنذارات
    """
    if session.get('role') not in ['مدير', 'مشرف']:
        return jsonify({"success": False, "message": "غير مصرح"}), 401

    try:
        data = request.get_json()
        if not data or 'image' not in data or 'classroom_id' not in data:
            return jsonify({"success": False, "message": "بيانات غير مكتملة"}), 400

        classroom_id = int(data.get('classroom_id'))

        conn = get_db_connection()
        cursor = conn.cursor()
        cursor.execute("""
            SELECT Id, Name, TeacherId
            FROM Classrooms WHERE Id = ? AND IsActive = 1
        """, (classroom_id,))
        cls_row = cursor.fetchone()
        conn.close()
        if not cls_row:
            return jsonify({"success": False, "message": "الفصل غير موجود"}), 404

        classroom_name = cls_row.Name
        teacher_id = int(cls_row.TeacherId) if cls_row.TeacherId else None

        cooldown_key = f'alert_cooldown_{classroom_id}'
        last_alert_times = app.config.get(cooldown_key, {})
        now_ts = time.time()
        COOLDOWN_SECONDS = 60

        def _can_alert(alert_type):
            last = last_alert_times.get(alert_type, 0)
            if now_ts - last < COOLDOWN_SECONDS:
                return False
            last_alert_times[alert_type] = now_ts
            app.config[cooldown_key] = last_alert_times
            return True

        img = Image.open(io.BytesIO(base64.b64decode(data['image'].split(',')[1])))
        if img.mode != 'RGB':
            img = img.convert('RGB')
        image_np = np.array(img)

        if len(image_np.shape) == 2:
            rgb = cv2.cvtColor(image_np, cv2.COLOR_GRAY2RGB)
        elif image_np.shape[2] == 4:
            rgb = cv2.cvtColor(image_np, cv2.COLOR_RGBA2RGB)
        else:
            rgb = image_np.copy()

        image_bgr = cv2.cvtColor(rgb, cv2.COLOR_RGB2BGR)

        # ✅ استخدام prev_frames المشتركة بدل app.config
        with prev_frames_lock:
            prev_frame = prev_frames.get(classroom_id)
        fire_result = detect_fire_smoke(image_bgr, prev_frame)
        # تحديث آخر إطار (بنسخة مصغّرة لتوفير الذاكرة)
        try:
            small = cv2.resize(image_bgr, (320, 240))
            with prev_frames_lock:
                prev_frames[classroom_id] = small
        except Exception:
            pass

        if fire_result['fire_detected'] or fire_result['smoke_detected']:
            if _can_alert('fire'):
                alert_desc = []
                if fire_result['fire_detected']:
                    alert_desc.append(f"🔥 حريق (نسبة: {fire_result['fire_ratio']*100:.1f}%)")
                if fire_result['smoke_detected']:
                    alert_desc.append(f"💨 دخان (نسبة: {fire_result['smoke_ratio']*100:.1f}%)")
                full_desc = f"{' و '.join(alert_desc)} في {classroom_name}"

                _create_alert(
                    classroom_id=classroom_id,
                    classroom_name=classroom_name,
                    user_id=None,
                    user_name=None,
                    alert_type='fire',
                    description=full_desc,
                    teacher_id=teacher_id,
                    image_b64=data.get('image')
                )
                print(f"🔥🔥 {full_desc}", flush=True)
            else:
                print(f"⏳ حريق/دخان في {classroom_name} — ضمن فترة التهدئة", flush=True)

        faces = face_app.get(image_bgr)
        if not faces:
            return jsonify({
                "success": True,
                "count": 0,
                "names": [],
                "statuses": [],
                "locations": [],
                "alerts_created": 0,
                "fire_detected": fire_result['fire_detected'],
                "smoke_detected": fire_result['smoke_detected'],
                "fire_regions": fire_result.get('fire_regions', [])
            })

        h, w = rgb.shape[:2]
        locations, names, statuses = [], [], []
        alerts_created = 0

        for face in faces:
            bbox = face.bbox.astype(int)
            left, top, right, bottom = bbox[0], bbox[1], bbox[2], bbox[3]
            top, left = max(0, top), max(0, left)
            bottom, right = min(h, bottom), min(w, right)
            locations.append({
                "top": int(top),
                "right": int(right),
                "bottom": int(bottom),
                "left": int(left)
            })

            emb = face.normed_embedding
            user_id, name, dist = find_best_match_vectorized(emb)

            if user_id is not None:
                user_id = int(user_id)

            if user_id is None:
                names.append("غير معروف")
                statuses.append("stranger")
                if _can_alert('stranger'):
                    _create_alert(
                        classroom_id=classroom_id,
                        classroom_name=classroom_name,
                        user_id=None,
                        user_name=None,
                        alert_type='stranger',
                        description=f"شخص غير معروف ظهر في {classroom_name}",
                        teacher_id=teacher_id,
                        image_b64=data.get('image')
                    )
                    alerts_created += 1
                else:
                    print(f"⏳ شخص غريب في {classroom_name} — ضمن التهدئة", flush=True)
                continue

            names.append(name)

            conn = get_db_connection()
            cursor = conn.cursor()
            cursor.execute("SELECT Class, Role FROM Users WHERE Id = ?", (user_id,))
            urow = cursor.fetchone()
            conn.close()

            user_class = (urow.Class or "").strip() if urow else ""
            user_role = urow.Role if urow else ""

            if user_role == 'طالب':
                cls_name_clean = _normalize_class(classroom_name)
                user_cls_clean = _normalize_class(user_class)

                if cls_name_clean and user_cls_clean and cls_name_clean != user_cls_clean:
                    statuses.append("wrong_class")
                    if _can_alert('wrong_class'):
                        _create_alert(
                            classroom_id=classroom_id,
                            classroom_name=classroom_name,
                            user_id=user_id,
                            user_name=name,
                            alert_type='wrong_class',
                            description=f"الطالب {name} من فصل '{user_class}' دخل إلى '{classroom_name}'",
                            teacher_id=teacher_id,
                            image_b64=data.get('image')
                        )
                        alerts_created += 1
                    else:
                        print(f"⏳ {name} في فصل خطأ — ضمن التهدئة", flush=True)
                else:
                    statuses.append("ok")
            else:
                statuses.append("ok")

        app.config[f'last_detect_{classroom_id}'] = datetime.now().isoformat()

        return jsonify({
            "success": True,
            "count": len(faces),
            "names": names,
            "statuses": statuses,
            "locations": locations,
            "alerts_created": alerts_created,
            "fire_detected": fire_result['fire_detected'],
            "smoke_detected": fire_result['smoke_detected'],
            "fire_regions": fire_result.get('fire_regions', [])
        })

    except Exception as e:
        print(f"❌ خطأ في classroom detect: {e}", flush=True)
        traceback.print_exc()
        return jsonify({"success": False, "message": str(e)}), 500


@app.route('/api/alerts', methods=['GET'])
def api_alerts_list():
    """قائمة الإنذارات الأخيرة"""
    if session.get('role') not in ['مدير', 'مشرف']:
        return jsonify({"error": "غير مصرح"}), 401
    try:
        limit = request.args.get('limit', 50, type=int)
        unread_only = request.args.get('unread', '0') == '1'
        conn = get_db_connection()
        cursor = conn.cursor()
        where_clause = "WHERE IsRead = 0" if unread_only else ""
        cursor.execute(f"""
            SELECT TOP {limit}
                Id, ClassroomId, ClassroomName, UserId, UserName,
                AlertType, Description, ImagePath, IsRead, CreatedAt
            FROM Alerts
            {where_clause}
            ORDER BY CreatedAt DESC
        """)
        rows = cursor.fetchall()
        conn.close()
        return jsonify([{
            'id': r.Id,
            'classroom_id': r.ClassroomId,
            'classroom_name': r.ClassroomName,
            'user_id': r.UserId,
            'user_name': r.UserName,
            'alert_type': r.AlertType,
            'description': r.Description,
            'image_path': r.ImagePath,
            'is_read': bool(r.IsRead),
            'created_at': str(r.CreatedAt) if r.CreatedAt else None
        } for r in rows])
    except Exception as e:
        return jsonify({"error": str(e)}), 500


@app.route('/api/alerts/<int:alert_id>/read', methods=['POST'])
def api_alert_mark_read(alert_id):
    """تعليم إنذار كمقروء"""
    if session.get('role') not in ['مدير', 'مشرف']:
        return jsonify({"error": "غير مصرح"}), 401
