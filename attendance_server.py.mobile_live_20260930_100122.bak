@app.route('/api/alerts/<int:alert_id>/video', methods=['DELETE'])
def api_alert_video_delete(alert_id):
    """حذف فيديو الإنذار"""
    if session.get('role') not in ['مدير', 'مشرف']:
        return jsonify({"error": "غير مصرح"}), 401
    try:
        conn = get_db_connection()
        cursor = conn.cursor()
        cursor.execute("SELECT VideoPath FROM AlertVideos WHERE AlertId = ?", (alert_id,))
        rows = cursor.fetchall()
        for r in rows:
            if r.VideoPath and os.path.exists(r.VideoPath):
                try:
                    os.remove(r.VideoPath)
                except Exception:
                    pass
        cursor.execute("DELETE FROM AlertVideos WHERE AlertId = ?", (alert_id,))
        cursor.execute("UPDATE Alerts SET VideoPath = NULL WHERE Id = ?", (alert_id,))
        conn.commit()
        conn.close()
        return jsonify({"success": True, "message": "✅ تم حذف الفيديو"})
    except Exception as e:
        return jsonify({"success": False, "message": str(e)}), 500


