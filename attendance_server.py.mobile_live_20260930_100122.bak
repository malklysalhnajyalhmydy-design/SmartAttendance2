@app.route('/api/exams/sessions', methods=['GET', 'POST'])
def api_exam_sessions():
    print(f"\n{'='*60}", flush=True)
    print(f"🎯 [api_exam_sessions] بدأ التنفيذ", flush=True)
    print(f"   Method: {request.method}", flush=True)
    print(f"   Session Role: {session.get('role')}", flush=True)
    print(f"   Session User: {session.get('user_id')}", flush=True)
    print(f"{'='*60}", flush=True)

    if session.get('role') not in ['مدير', 'مشرف']:
        print(f"   ❌ رفض: الدور غير مصرح", flush=True)
        return jsonify({"error": "غير مصرح"}), 401

    conn = None
    try:
        conn = get_db_connection()
        cursor = conn.cursor()
        print(f"   ✅ تم الاتصال بقاعدة البيانات", flush=True)

        if request.method == 'GET':
            cursor.execute("""SELECT Id, ExamName, Subject, ExamDate, StartTime, EndTime, Status,
                              TotalViolations, StartedAt, StoppedAt, CreatedAt
                              FROM ExamSessions ORDER BY CreatedAt DESC""")
            rows = cursor.fetchall()
            result = []
            for r in rows:
                cursor.execute("""SELECT esc.Id, esc.ClassroomId, esc.ClassroomName, esc.Subject,
                                  esc.TeacherId, t.Name as TeacherName, esc.SupervisorId, s.Name as SupervisorName,
                                  esc.ViolationCount, esc.Status as ClassStatus, esc.StartTime, esc.EndTime,
                                  esc.AutoStart, esc.AutoStop
                                  FROM ExamSessionClassrooms esc
                                  LEFT JOIN Users t ON esc.TeacherId = t.Id
                                  LEFT JOIN Users s ON esc.SupervisorId = s.Id
                                  WHERE esc.SessionId = ?""", (r.Id,))
                cls_rows = cursor.fetchall()
                result.append({
                    'id': r.Id, 'exam_name': r.ExamName, 'subject': r.Subject,
                    'exam_date': str(r.ExamDate), 'start_time': r.StartTime, 'end_time': r.EndTime,
                    'status': r.Status or 'idle', 'total_violations': r.TotalViolations or 0,
                    'created_at': str(r.CreatedAt) if r.CreatedAt else None,
                    'classrooms': [{
                        'sc_id': c.Id, 'classroom_id': c.ClassroomId, 'classroom_name': c.ClassroomName,
                        'subject': c.Subject, 'teacher_id': c.TeacherId, 'teacher_name': c.TeacherName,
                        'supervisor_id': c.SupervisorId, 'supervisor_name': c.SupervisorName,
                        'violation_count': c.ViolationCount or 0, 'class_status': c.ClassStatus or 'idle',
                        'start_time': c.StartTime, 'end_time': c.EndTime,
                        'auto_start': bool(c.AutoStart), 'auto_stop': bool(c.AutoStop)
                    } for c in cls_rows]
                })
            print(f"   ✅ تم جلب {len(result)} جلسة", flush=True)
            return jsonify(result)

        # ========== POST ==========
        print(f"   📥 POST: بدء إنشاء جلسة جديدة", flush=True)

        data = request.get_json()
        print(f"   📦 البيانات الواردة: {data}", flush=True)

        if not data:
            print(f"   ❌ لا توجد بيانات JSON", flush=True)
            return jsonify({"success": False, "message": "لا توجد بيانات"}), 400

        exam_name = data.get('exam_name')
        exam_date = data.get('exam_date')
        classrooms = data.get('classrooms', [])

        print(f"   📌 اسم الجلسة: {exam_name}", flush=True)
        print(f"   📅 التاريخ: {exam_date}", flush=True)
        print(f"   🏫 عدد الفصول: {len(classrooms)}", flush=True)

        if not classrooms:
            print(f"   ❌ لا توجد فصول", flush=True)
            return jsonify({"success": False, "message": "اختر فصلاً واحداً على الأقل"}), 400

        for idx, c in enumerate(classrooms):
            print(f"      [{idx+1}] {c.get('classroom_name')} | مادة: {c.get('subject')} | من: {c.get('start_time')} إلى: {c.get('end_time')}", flush=True)

            if not c.get('subject') or not c.get('start_time') or not c.get('end_time'):
                err = f"الفصل {c.get('classroom_name')} ناقص بيانات"
                print(f"   ❌ {err}", flush=True)
                return jsonify({"success": False, "message": err}), 400
            if c['start_time'] >= c['end_time']:
                err = f"وقت نهاية {c.get('classroom_name')} يجب أن يكون بعد البداية"
                print(f"   ❌ {err}", flush=True)
                return jsonify({"success": False, "message": err}), 400

        times = sorted([c['start_time'] for c in classrooms])
        ends = sorted([c['end_time'] for c in classrooms])
        print(f"   ⏰ الوقت الكلي: من {times[0]} إلى {ends[-1]}", flush=True)

        cursor.execute("""INSERT INTO ExamSessions (ExamName, Subject, ExamDate, StartTime, EndTime, CreatedByUserId, Status)
                          OUTPUT INSERTED.Id VALUES (?, ?, ?, ?, ?, ?, 'idle')""",
                       (exam_name, data.get('subject'), exam_date,
                        times[0], ends[-1], session.get('user_id')))
        row = cursor.fetchone()
        if not row:
            print(f"   ❌ فشل الحصول على session ID", flush=True)
            return jsonify({"success": False, "message": "فشل إنشاء الجلسة"}), 500

        sid = int(row[0])
        print(f"   ✅ تم إنشاء الجلسة #{sid}", flush=True)

        for c in classrooms:
            cursor.execute("""INSERT INTO ExamSessionClassrooms
                (SessionId, ClassroomId, ClassroomName, Subject, TeacherId, SupervisorId,
                 StartTime, EndTime, AutoStart, AutoStop, Status, ExamDate)
                VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 'idle', ?)""",
                (sid, c['classroom_id'], c.get('classroom_name'), c.get('subject'),
                 c.get('teacher_id'), c.get('supervisor_id'), c.get('start_time'), c.get('end_time'),
                 1 if c.get('auto_start', True) else 0, 1 if c.get('auto_stop', True) else 0,
                 exam_date))
            print(f"   ✅ تم إضافة الفصل {c.get('classroom_name')} للجلسة", flush=True)

        conn.commit()
        print(f"   🎉 تم حفظ الجلسة #{sid} بنجاح", flush=True)
        return jsonify({"success": True, "message": "✅ تم إنشاء الجلسة", "id": sid})

    except Exception as e:
        print(f"\n{'='*60}", flush=True)
        print(f"   💥 خطأ في api_exam_sessions: {type(e).__name__}", flush=True)
        print(f"   الرسالة: {e}", flush=True)
        print(f"   التفاصيل:", flush=True)
        traceback.print_exc()
        print(f"{'='*60}\n", flush=True)
        return jsonify({"success": False, "message": f"خطأ: {str(e)}"}), 500
    finally:
        if conn:
            try: conn.close()
            except: pass

@app.route('/api/exams/sessions/<int:sid>/start', methods=['POST'])
def api_exam_session_start(sid):
    if session.get('role') not in ['مدير', 'مشرف']: return jsonify({"error": "غير مصرح"}), 401
    conn = get_db_connection(); cursor = conn.cursor()
    cursor.execute("UPDATE ExamSessionClassrooms SET Status='running', StartedAt=GETDATE() WHERE SessionId=? AND Status='idle'", (sid,))
    cursor.execute("UPDATE ExamSessions SET Status='running', StartedAt=COALESCE(StartedAt, GETDATE()) WHERE Id=?", (sid,))
    conn.commit(); conn.close()
    return jsonify({"success": True, "message": "▶️ بدأت كل الفصول"})


