# 💬 نظام الرسائل الخاصة
# ═══════════════════════════════════════════════════════════════

MESSAGE_TEMPLATES_FILE = "message_templates.json"


def _load_message_templates():
    """جلب القوالب أو إنشاؤها"""
    defaults = [
        {"id":"meeting","icon":"🔔","name":"طلب اجتماع",
         "text":"عزيزي {الاسم}،\n\nنرجو منكم الحضور إلى إدارة المدرسة يوم {التاريخ} الساعة {الوقت}\nلمناقشة أمر يخص {الطالب/المعلم}.\n\nمع التحية،\nإدارة المدرسة"},
        {"id":"absence","icon":"⚠️","name":"تنبيه غياب",
         "text":"عزيزي ولي الأمر،\n\nنلفت انتباهكم إلى أن {الاسم} قد تغيب عن {الحصة/اليوم}\nبتاريخ {التاريخ} دون عذر مسبق.\n\nنرجو المتابعة.\n\nإدارة المدرسة"},
        {"id":"appreciation","icon":"🏆","name":"تكريم وتقدير",
         "text":"نبارك لكم تميز {الاسم} في {المواد الدراسية}\nونشكر لكم حسن التربية والمتابعة.\n\nمع خالص التقدير،\nإدارة المدرسة"},
        {"id":"class_reminder","icon":"📚","name":"تذكير بحصة",
         "text":"تذكير: لديكم حصة {المادة} في الفصل {الفصل}\nيوم {اليوم} الساعة {الوقت}.\n\nمع التحية،\nإدارة المدرسة"},
        {"id":"behavior","icon":"📝","name":"تنبيه سلوك",
         "text":"عزيزي ولي الأمر،\n\nنود إعلامكم بسلوك يستدعي المتابعة من {الاسم}\nبتاريخ {التاريخ}.\n\nنرجو التواصل معنا للمناقشة.\n\nإدارة المدرسة"},
        {"id":"custom","icon":"✏️","name":"قالب مخصص","text":""},
    ]
    if os.path.exists(MESSAGE_TEMPLATES_FILE):
        try:
            with open(MESSAGE_TEMPLATES_FILE, 'r', encoding='utf-8') as f:
                data = json.load(f)
                if isinstance(data, list) and data:
                    return data
        except Exception:
            pass
    try:
        with open(MESSAGE_TEMPLATES_FILE, 'w', encoding='utf-8') as f:
            json.dump(defaults, f, ensure_ascii=False, indent=2)
    except Exception:
        pass
    return defaults


@app.route('/api/messages/templates', methods=['GET'])
def api_get_message_templates():
    if session.get('role') not in ['مدير', 'مشرف']:
        return jsonify({"error": "غير مصرح"}), 401
    return jsonify(_load_message_templates())


@app.route('/api/users/search-by-role')
def api_users_search_by_role():
    """بحث ذكي في المستخدمين"""
    if session.get('role') not in ['مدير', 'مشرف']:
        return jsonify({"error": "غير مصرح"}), 401
    try:
        q = (request.args.get('q') or '').strip()
        role = (request.args.get('role') or 'all').strip()
       
        conn = get_db_connection()
        cursor = conn.cursor()
        conditions = ["IsActive = 1"]
        params = []
        if role and role != 'all':
            conditions.append("Role = ?")
            params.append(role)
        if q:
            conditions.append("(Name LIKE ? OR Class LIKE ? OR StudentId LIKE ?)")
            s = f"%{q}%"
            params.extend([s, s, s])
        where = " AND ".join(conditions)
        cursor.execute(f"""
            SELECT TOP 50 Id, Name, Role, Class, Email, ParentEmail,
                   TelegramChatID, ProfileImage
            FROM Users WHERE {where} ORDER BY Name
        """, params)
        rows = cursor.fetchall()
        conn.close()
        return jsonify([{
            'id': r.Id, 'name': r.Name, 'role': r.Role,
            'class': r.Class or '-',
            'email': r.Email or '',
            'parent_email': r.ParentEmail or '',
            'chat_id': r.TelegramChatID or '',
            'profile_image': r.ProfileImage or ''
        } for r in rows])
    except Exception as e:
        print(f"❌ search-by-role: {e}", flush=True)
        return jsonify({"error": str(e)}), 500


@app.route('/api/messages/send-private', methods=['POST'])
def api_send_private_message():
    """إرسال رسالة خاصة لمستخدم محدد"""
    if session.get('role') not in ['مدير', 'مشرف']:
        return jsonify({"error": "غير مصرح"}), 401
    try:
        data = request.get_json() or {}
        recipient_id = data.get('recipient_id')
        subject = (data.get('subject') or 'رسالة من الإدارة').strip()
        message = (data.get('message') or '').strip()
        send_email_flag = data.get('send_email', True)
        send_telegram_flag = data.get('send_telegram', True)
        save_internal = data.get('save_internal', True)

        if not recipient_id:
            return jsonify({"success": False, "message": "اختر المستلم"}), 400
        if not message or len(message) < 3:
            return jsonify({"success": False, "message": "الرسالة قصيرة جداً"}), 400
        if not (send_email_flag or send_telegram_flag or save_internal):
            return jsonify({"success": False, "message": "اختر قناة واحدة على الأقل"}), 400

        conn = get_db_connection()
        cursor = conn.cursor()
        cursor.execute("""
            SELECT Id, Name, Role, Email, ParentEmail, TelegramChatID
            FROM Users WHERE Id = ? AND IsActive = 1
        """, (recipient_id,))
        recipient = cursor.fetchone()
        if not recipient:
            conn.close()
            return jsonify({"success": False, "message": "المستلم غير موجود"}), 404

        admin_id = session.get('user_id')
        admin_name = session.get('role', 'الإدارة')
        cursor.execute("SELECT Name FROM Users WHERE Id = ?", (admin_id,))
        ar = cursor.fetchone()
        if ar and ar.Name:
            admin_name = ar.Name

        cursor.execute("""
            INSERT INTO Messages
            (ThreadId, SenderUserId, SenderName, SenderRole, IsFromAdmin,
             Subject, MessageText, Status, SentViaInApp, SentViaEmail,
             SentViaTelegram, RecipientUserId, MessageType, CreatedAt)
            OUTPUT INSERTED.Id
            VALUES (NULL, ?, ?, N'الإدارة', 1, ?, ?, 'sent', ?, ?, ?, ?, 'private', GETDATE())
        """, (
            admin_id, admin_name, subject, message,
            1 if save_internal else 0,
            1 if send_email_flag else 0,
            1 if send_telegram_flag else 0,
            recipient_id
        ))
        row = cursor.fetchone()
        if not row:
            conn.rollback(); conn.close()
            return jsonify({"success": False, "message": "فشل الحفظ"}), 500
        msg_id = int(row[0])
        cursor.execute("UPDATE Messages SET ThreadId = ? WHERE Id = ?", (msg_id, msg_id))
        conn.commit()
        conn.close()

        now_str = datetime.now().strftime("%Y-%m-%d %H:%M")
        channels = []

        if send_telegram_flag and recipient.TelegramChatID:
            tg_msg = f"📨 <b>{subject}</b>\n\n{message}\n\n<i>⏰ {now_str}</i>"
            try:
                if send_telegram(str(recipient.TelegramChatID), tg_msg):
                    channels.append('📱 تيليجرام')
            except Exception:
                pass

        if send_email_flag:
            to_email = recipient.Email or recipient.ParentEmail
            if to_email:
                try:
                    if send_email(to_email, subject, message):
                        channels.append('📧 إيميل')
                except Exception:
                    pass

        if save_internal:
            channels.append('💬 داخلي')

        print(f"✅ رسالة خاصة #{msg_id} → {recipient.Name} ({', '.join(channels)})", flush=True)
        return jsonify({
            "success": True,
            "message": f"✅ تم الإرسال إلى {recipient.Name} عبر: {' + '.join(channels) if channels else 'لا توجد قناة'}",
            "id": msg_id
        })
    except Exception as e:
        print(f"❌ send-private: {e}", flush=True)
        traceback.print_exc()
        return jsonify({"success": False, "message": str(e)}), 500


@app.route('/api/messages/outbox')
def api_messages_outbox():
    """جلب الرسائل الصادرة"""
    if session.get('role') not in ['مدير', 'مشرف']:
        return jsonify({"error": "غير مصرح"}), 401
    try:
        q = (request.args.get('q') or '').strip()
        status = (request.args.get('status') or 'all').strip()
        role = (request.args.get('role') or 'all').strip()
        days = request.args.get('days', 0, type=int)

        conn = get_db_connection()
        cursor = conn.cursor()
        conditions = ["IsFromAdmin = 1"]
        params = []
        if q:
            conditions.append("(Subject LIKE ? OR MessageText LIKE ?)")
            s = f"%{q}%"
            params.extend([s, s])
        if days > 0:
            conditions.append("CreatedAt >= DATEADD(DAY, -?, GETDATE())")
            params.append(days)
        if status == 'read':
            conditions.append("ReadAt IS NOT NULL")
        elif status == 'unread':
            conditions.append("ReadAt IS NULL")

        where = " AND ".join(conditions)
        cursor.execute(f"""
            SELECT TOP 200 Id, SenderName, Subject, MessageText,
                   RecipientUserId, Status, ReadAt,
                   SentViaEmail, SentViaTelegram, SentViaInApp, CreatedAt
            FROM Messages WHERE {where}
            ORDER BY CreatedAt DESC
        """, params)
        rows = cursor.fetchall()

        result = []
        for r in rows:
            rec = None
            if r.RecipientUserId:
                cursor.execute(
                    "SELECT Name, Role, Class FROM Users WHERE Id = ?",
                    (r.RecipientUserId,)
                )
                u = cursor.fetchone()
                if u:
                    if role != 'all' and u.Role != role:
                        continue
                    rec = {'name': u.Name, 'role': u.Role, 'class': u.Class or '-'}
                elif role != 'all':
                    continue
            elif role != 'all':
                continue

            result.append({
                'id': r.Id,
                'subject': r.Subject or '',
                'message': r.MessageText or '',
                'recipient': rec,
                'is_read': r.ReadAt is not None,
                'read_at': str(r.ReadAt) if r.ReadAt else None,
                'sent_via_email': bool(r.SentViaEmail),
                'sent_via_telegram': bool(r.SentViaTelegram),
                'sent_via_inapp': bool(r.SentViaInApp),
                'created_at': str(r.CreatedAt) if r.CreatedAt else ''
            })
        conn.close()
        return jsonify({'success': True, 'messages': result, 'total': len(result)})
    except Exception as e:
        print(f"❌ outbox: {e}", flush=True)
        return jsonify({'success': False, 'message': str(e)}), 500


@app.route('/api/messages/inbox-count')
def api_messages_inbox_count():
    """عدّاد الرسائل الواردة الخاصة (للمدير/مشرف)"""
    if session.get('role') not in ['مدير', 'مشرف']:
        return jsonify({"count": 0})
    try:
        conn = get_db_connection()
        cursor = conn.cursor()
        cursor.execute("""
            SELECT COUNT(*) FROM Messages
            WHERE IsFromAdmin = 0 AND Status = 'new'
        """)
        c = cursor.fetchone()[0]
        conn.close()
        return jsonify({"count": c or 0})
    except Exception:
        return jsonify({"count": 0})


@app.route('/api/messages/pending')
def api_messages_pending():
    """الرسائل المعلّقة (فشل إرسالها)"""
    if session.get('role') not in ['مدير', 'مشرف']:
        return jsonify({"error": "غير مصرح"}), 401
    try:
        conn = get_db_connection()
        cursor = conn.cursor()
        cursor.execute("""
            SELECT TOP 100 Id, NotificationType, Target, Message, CreatedAt
            FROM PendingNotifications WHERE IsSent = 0
            ORDER BY CreatedAt DESC
        """)
        rows = cursor.fetchall()
        conn.close()
        return jsonify([{
            'id': r.Id,
            'type': r.NotificationType,
            'target': r.Target,
            'message': (r.Message or '')[:100],
            'created_at': str(r.CreatedAt) if r.CreatedAt else ''
        } for r in rows])
    except Exception:
        return jsonify([])


@app.route('/api/messages/retry-pending', methods=['POST'])
def api_messages_retry_pending():
    """إعادة إرسال الرسائل المعلّقة"""
    if session.get('role') not in ['مدير', 'مشرف']:
        return jsonify({"error": "غير مصرح"}), 401
    try:
        flush_pending_notifications()
        return jsonify({"success": True, "message": "✅ تمت محاولة إعادة الإرسال"})
    except Exception as e:
        return jsonify({"success": False, "message": str(e)}), 500


# ✅ ترقيع دالة mark-read للرسائل الخاصة (يُستخدم في الواجهة الأمامية)
@app.route('/api/messages/<int:mid>/read-private', methods=['POST'])
def api_mark_read_private(mid):
    """تعليم رسالة خاصة كمقروءة (يستدعيه المستقبل)"""
    try:
        uid = session.get('user_id')
        if not uid:
            return jsonify({"success": False}), 401
        conn = get_db_connection()
        cursor = conn.cursor()
        cursor.execute("""
            UPDATE Messages SET ReadAt = GETDATE(), Status = 'read'
            WHERE Id = ? AND RecipientUserId = ? AND ReadAt IS NULL
        """, (mid, uid))
        affected = cursor.rowcount
        conn.commit()
        conn.close()
        return jsonify({"success": True, "affected": affected})
    except Exception as e:
        return jsonify({"success": False, "message": str(e)}), 500

# ═══════════════════════════════════════════════════════════════
# نهاية كود الرسائل الخاصة
# ═══════════════════════════════════════════════════════════════



if __name__ == "__main__":
    # ====== إنشاء الجداول ======
    try:
        conn = get_db_connection()
        cursor = conn.cursor()

        # ✅ جدول Attendance (حرج)
        cursor.execute("""
            IF NOT EXISTS (SELECT * FROM sysobjects WHERE name='Attendance' AND xtype='U')
            CREATE TABLE Attendance (
                Id INT IDENTITY(1,1) PRIMARY KEY,
                UserId INT NOT NULL,
                Name NVARCHAR(100) NOT NULL,
                AttendanceDate DATE NOT NULL,
                CheckInTime TIME NULL,
                CheckOutTime TIME NULL,
                Status NVARCHAR(20) DEFAULT N'حاضر',
                ExcuseReason NVARCHAR(500) NULL,
                AttachmentPath NVARCHAR(500) NULL,
                FOREIGN KEY (UserId) REFERENCES Users(Id)
            )
        """)

        # ✅ جدول Holidays (حرج)
        cursor.execute("""
            IF NOT EXISTS (SELECT * FROM sysobjects WHERE name='Holidays' AND xtype='U')
            CREATE TABLE Holidays (
                Id INT IDENTITY(1,1) PRIMARY KEY,
                HolidayDate DATE NOT NULL,
                EndDate DATE NULL,
                Description NVARCHAR(255) NULL,
                HolidayType NVARCHAR(50) DEFAULT N'عامة'
            )
        """)

        # ✅ جدول IndividualHolidays (حرج)
        cursor.execute("""
            IF NOT EXISTS (SELECT * FROM sysobjects WHERE name='IndividualHolidays' AND xtype='U')
            CREATE TABLE IndividualHolidays (
                Id INT IDENTITY(1,1) PRIMARY KEY,
                UserId INT NOT NULL,
                HolidayDate DATE NOT NULL,
                Description NVARCHAR(255) NULL,
                FOREIGN KEY (UserId) REFERENCES Users(Id)
            )
        """)

        # ✅ جدول TelegramCodes (حرج)
        cursor.execute("""
            IF NOT EXISTS (SELECT * FROM sysobjects WHERE name='TelegramCodes' AND xtype='U')
            CREATE TABLE TelegramCodes (
                Id INT IDENTITY(1,1) PRIMARY KEY,
                Code NVARCHAR(20) NOT NULL UNIQUE,
                ChatId NVARCHAR(50) NOT NULL,
                CreatedAt DATETIME DEFAULT GETDATE()
            )
        """)

        cursor.execute("""
            IF NOT EXISTS (SELECT * FROM sysobjects WHERE name='Notifications' AND xtype='U')
            CREATE TABLE Notifications (
                Id INT IDENTITY(1,1) PRIMARY KEY,
                UserId INT NOT NULL,
                NotificationType NVARCHAR(50) NOT NULL,
                SentDate DATE NOT NULL,
                SentTime TIME NOT NULL,
                FOREIGN KEY (UserId) REFERENCES Users(Id)
            )
        """)
        cursor.execute("""
            IF NOT EXISTS (SELECT * FROM sysobjects WHERE name='LoginAttempts' AND xtype='U')
            CREATE TABLE LoginAttempts (
                Id INT IDENTITY(1,1) PRIMARY KEY,
                UserId INT NOT NULL,
                AttemptTime DATETIME DEFAULT GETDATE(),
                IsLocked BIT DEFAULT 0,
                LockUntil DATETIME NULL,
                FOREIGN KEY (UserId) REFERENCES Users(Id)
            )
        """)
        cursor.execute("""
            IF NOT EXISTS (SELECT * FROM sysobjects WHERE name='PasswordResetTokens' AND xtype='U')
            CREATE TABLE PasswordResetTokens (
                Id INT IDENTITY(1,1) PRIMARY KEY,
                UserId INT NOT NULL,
                Token NVARCHAR(255) NOT NULL UNIQUE,
                ExpiryDate DATETIME NOT NULL,
                IsUsed BIT DEFAULT 0,
                FOREIGN KEY (UserId) REFERENCES Users(Id)
            )
        """)
        cursor.execute("""
            IF NOT EXISTS (SELECT * FROM sysobjects WHERE name='Classes' AND xtype='U')
            CREATE TABLE Classes (
                Id INT IDENTITY(1,1) PRIMARY KEY,
                Name NVARCHAR(100) NOT NULL,
                Grade INT NULL
            )
         """)
        cursor.execute("""
            IF NOT EXISTS (SELECT * FROM sys.columns WHERE name='Images' AND object_id=OBJECT_ID('Users'))
                ALTER TABLE Users ADD Images NVARCHAR(MAX) NULL
        """)
        cursor.execute("""
            IF NOT EXISTS (SELECT * FROM sys.columns WHERE name='CreatedAt' AND object_id=OBJECT_ID('Users'))
                ALTER TABLE Users ADD CreatedAt DATETIME DEFAULT GETDATE()
        """)
        cursor.execute("""
            IF NOT EXISTS (SELECT * FROM sysobjects WHERE name='PendingNotifications' AND xtype='U')
            CREATE TABLE PendingNotifications (
                Id INT IDENTITY(1,1) PRIMARY KEY,
                NotificationType NVARCHAR(20) NOT NULL,
                Target NVARCHAR(500) NOT NULL,
                Message NVARCHAR(MAX) NOT NULL,
                Extra NVARCHAR(MAX) NULL,
                CreatedAt DATETIME DEFAULT GETDATE(),
                IsSent BIT DEFAULT 0
            )
        """)
        cursor.execute("""
            IF NOT EXISTS (SELECT * FROM sysobjects WHERE name='ROI_Zones' AND xtype='U')
            CREATE TABLE ROI_Zones (
                Id INT IDENTITY(1,1) PRIMARY KEY,
                CameraId NVARCHAR(50) NOT NULL,
                ZoneName NVARCHAR(50) NOT NULL,
                Coordinates NVARCHAR(500) NOT NULL
            )
        """)
        cursor.execute("""
            IF NOT EXISTS (SELECT * FROM sysobjects WHERE name='Exam_Sessions' AND xtype='U')
            CREATE TABLE Exam_Sessions (
                Id INT IDENTITY(1,1) PRIMARY KEY,
                ClassId INT NOT NULL,
                StartTime DATETIME NOT NULL,
                EndTime DATETIME NULL,
                IsActive BIT DEFAULT 0
            )
        """)

        cursor.execute("""
            IF NOT EXISTS (SELECT * FROM sysobjects WHERE name='Classrooms' AND xtype='U')
            CREATE TABLE Classrooms (
                Id INT IDENTITY(1,1) PRIMARY KEY,
                Name NVARCHAR(100) NOT NULL,
                CameraIP NVARCHAR(500) NOT NULL,
                CameraType NVARCHAR(20) DEFAULT 'classroom',
                TeacherId INT NULL,
                IsActive BIT DEFAULT 1,
                CreatedAt DATETIME DEFAULT GETDATE(),
                FOREIGN KEY (TeacherId) REFERENCES Users(Id)
            )
        """)

        # ✅ جدول الإنذارات
        cursor.execute("""
            IF NOT EXISTS (SELECT * FROM sysobjects WHERE name='Alerts' AND xtype='U')
            CREATE TABLE Alerts (
                Id INT IDENTITY(1,1) PRIMARY KEY,
                ClassroomId INT NULL,
                ClassroomName NVARCHAR(100) NULL,
                UserId INT NULL,
                UserName NVARCHAR(100) NULL,
                AlertType NVARCHAR(50) NOT NULL,
                Description NVARCHAR(500) NOT NULL,
                ImagePath NVARCHAR(500) NULL,
                IsRead BIT DEFAULT 0,
                CreatedAt DATETIME DEFAULT GETDATE()
            )
        """)

        # ✅ جدول الإشعارات المُرسَلة لأولياء الأمور
        cursor.execute("""
            IF NOT EXISTS (SELECT * FROM sysobjects WHERE name='AlertNotifications' AND xtype='U')
            CREATE TABLE AlertNotifications (
                Id INT IDENTITY(1,1) PRIMARY KEY,
                AlertId INT NOT NULL,
                ClassroomId INT NULL,
                ClassroomName NVARCHAR(100) NULL,
                RecipientUserId INT NULL,
                RecipientName NVARCHAR(100) NULL,
                RecipientEmail NVARCHAR(255) NULL,
                RecipientChat NVARCHAR(100) NULL,
                MessageText NVARCHAR(MAX) NOT NULL,
                ImagePath NVARCHAR(500) NULL,
                SentVia NVARCHAR(20) DEFAULT 'both',
                SentByUserId INT NULL,
                SentByName NVARCHAR(100) NULL,
                Status NVARCHAR(20) DEFAULT 'sent',
                ErrorMessage NVARCHAR(500) NULL,
                IsCorrection BIT DEFAULT 0,
                CorrectionFor INT NULL,
                CorrectionReason NVARCHAR(50) NULL,
                SentAt DATETIME DEFAULT GETDATE()
            )
        """)

        # ✅ إضافة أعمدة حالة المراجعة والفيديو لجدول Alerts
        for col_def in [
            ("ParentNotified", "BIT DEFAULT 0"),
            ("ReviewStatus", "NVARCHAR(20) DEFAULT 'pending'"),
            ("ReviewNotes", "NVARCHAR(500) NULL"),
            ("ReviewedByUserId", "INT NULL"),
            ("ReviewedByName", "NVARCHAR(100) NULL"),
            ("ReviewedAt", "DATETIME NULL"),
            ("VideoPath", "NVARCHAR(500) NULL"),
        ]:
            col_name, col_type = col_def
            cursor.execute(f"""
                IF NOT EXISTS (SELECT * FROM sys.columns
                               WHERE name='{col_name}' AND object_id=OBJECT_ID('Alerts'))
                ALTER TABLE Alerts ADD {col_name} {col_type}
            """)

        # ✅ إضافة أعمدة إضافية لجدول AlertNotifications
        for col_def in [
            ("CorrectionFor", "INT NULL"),
            ("CorrectionReason", "NVARCHAR(50) NULL"),
            ("IsCorrection", "BIT DEFAULT 0"),
        ]:
            col_name, col_type = col_def
            cursor.execute(f"""
                IF NOT EXISTS (SELECT * FROM sys.columns
                               WHERE name='{col_name}' AND object_id=OBJECT_ID('AlertNotifications'))
                ALTER TABLE AlertNotifications ADD {col_name} {col_type}
            """)

        # ✅ جدول الفيديوهات المحفوظة
        cursor.execute("""
            IF NOT EXISTS (SELECT * FROM sysobjects WHERE name='AlertVideos' AND xtype='U')
            CREATE TABLE AlertVideos (
                Id INT IDENTITY(1,1) PRIMARY KEY,
                AlertId INT NOT NULL,
                ClassroomId INT NULL,
                VideoPath NVARCHAR(500) NOT NULL,
                Duration INT DEFAULT 20,
                FileSizeMB FLOAT NULL,
                CreatedAt DATETIME DEFAULT GETDATE()
            )
        """)
        cursor.execute("""
            IF NOT EXISTS (SELECT * FROM sysobjects WHERE name='Messages' AND xtype='U')
            CREATE TABLE Messages (
                Id INT IDENTITY(1,1) PRIMARY KEY,
                ThreadId INT NULL,
                SenderUserId INT NULL,
                SenderName NVARCHAR(100) NOT NULL,
                SenderRole NVARCHAR(50) NOT NULL,
                SenderEmail NVARCHAR(255) NULL,
                SenderChatId NVARCHAR(100) NULL,
                IsFromAdmin BIT DEFAULT 0,
                Subject NVARCHAR(200) NULL,
                MessageText NVARCHAR(MAX) NOT NULL,
                Status NVARCHAR(20) DEFAULT 'new',
                SentViaEmail BIT DEFAULT 0,
                SentViaTelegram BIT DEFAULT 0,
                SentViaInApp BIT DEFAULT 1,
                CreatedAt DATETIME DEFAULT GETDATE(),
                ReadAt DATETIME NULL
            )
        """)
        cursor.execute("""
            IF NOT EXISTS (SELECT * FROM sysobjects WHERE name='Periods' AND xtype='U')
            CREATE TABLE Periods (
                Id INT IDENTITY(1,1) PRIMARY KEY,
                PeriodNumber INT NOT NULL,
                StartTime NVARCHAR(10) NOT NULL,
                EndTime NVARCHAR(10) NOT NULL,
                Name NVARCHAR(50) NULL,
                IsBreak BIT DEFAULT 0,
                IsActive BIT DEFAULT 1
            )
        """)

        cursor.execute("""
            IF NOT EXISTS (SELECT * FROM sysobjects WHERE name='ClassSchedule' AND xtype='U')
            CREATE TABLE ClassSchedule (
                Id INT IDENTITY(1,1) PRIMARY KEY,
                TeacherId INT NOT NULL,
                Subject NVARCHAR(100) NOT NULL,
                ClassroomId INT NULL,
                ClassroomName NVARCHAR(100) NULL,
                DayOfWeek INT NOT NULL,
                PeriodNumber INT NOT NULL,
                SupervisorId INT NULL,
                Notes NVARCHAR(500) NULL,
                CreatedAt DATETIME DEFAULT GETDATE(),
                FOREIGN KEY (TeacherId) REFERENCES Users(Id)
            )
        """)

        cursor.execute("""
            IF NOT EXISTS (SELECT * FROM sysobjects WHERE name='TeacherSubjects' AND xtype='U')
            CREATE TABLE TeacherSubjects (
                Id INT IDENTITY(1,1) PRIMARY KEY,
                TeacherId INT NOT NULL,
                Subject NVARCHAR(100) NOT NULL,
                FOREIGN KEY (TeacherId) REFERENCES Users(Id)
            )
        """)

        cursor.execute("""
            IF NOT EXISTS (SELECT * FROM sysobjects WHERE name='ExamSessions' AND xtype='U')
            CREATE TABLE ExamSessions (
                Id INT IDENTITY(1,1) PRIMARY KEY,
                ExamName NVARCHAR(150) NOT NULL,
                Subject NVARCHAR(100) NULL,
                ExamDate DATE NOT NULL,
                StartTime NVARCHAR(10) NULL,
                EndTime NVARCHAR(10) NULL,
                Status NVARCHAR(20) DEFAULT 'idle',
                StartedByUserId INT NULL,
                StartedAt DATETIME NULL,
                StoppedAt DATETIME NULL,
                TotalViolations INT DEFAULT 0,
                CreatedByUserId INT NULL,
                CreatedAt DATETIME DEFAULT GETDATE()
            )
        """)

        cursor.execute("""
            IF NOT EXISTS (SELECT * FROM sysobjects WHERE name='ExamSessionClassrooms' AND xtype='U')
            CREATE TABLE ExamSessionClassrooms (
                Id INT IDENTITY(1,1) PRIMARY KEY,
                SessionId INT NOT NULL,
                ClassroomId INT NOT NULL,
                ClassroomName NVARCHAR(100) NULL,
                Subject NVARCHAR(100) NULL,
                TeacherId INT NULL,
                SupervisorId INT NULL,
                StartTime NVARCHAR(10) NULL,
                EndTime NVARCHAR(10) NULL,
                AutoStart BIT DEFAULT 1,
                AutoStop BIT DEFAULT 1,
                Status NVARCHAR(20) DEFAULT 'idle',
                StartedAt DATETIME NULL,
                StoppedAt DATETIME NULL,
                NotifiedStart BIT DEFAULT 0,
                NotifiedEnd BIT DEFAULT 0,
                ExamDate DATE NULL,
                ViolationCount INT DEFAULT 0,
                FOREIGN KEY (SessionId) REFERENCES ExamSessions(Id)
            )
        """)

        cursor.execute("""
            IF NOT EXISTS (SELECT * FROM sysobjects WHERE name='ExamViolations' AND xtype='U')
            CREATE TABLE ExamViolations (
                Id INT IDENTITY(1,1) PRIMARY KEY,
                SessionId INT NOT NULL,
                SessionClassroomId INT NOT NULL,
                ClassroomId INT NULL,
                ClassroomName NVARCHAR(100) NULL,
                ViolationType NVARCHAR(50) NOT NULL,
                Severity NVARCHAR(20) DEFAULT 'medium',
                Description NVARCHAR(500) NULL,
                ImagePath NVARCHAR(500) NULL,
                ConfidenceScore FLOAT NULL,
                TeacherNotified BIT DEFAULT 0,
                SupervisorNotified BIT DEFAULT 0,
                PrincipalNotified BIT DEFAULT 0,
                IsRead BIT DEFAULT 0,
                ReviewStatus NVARCHAR(20) DEFAULT 'pending',
                ReviewNotes NVARCHAR(500) NULL,
                CreatedAt DATETIME DEFAULT GETDATE()
            )
        """)

        cursor.execute("""
            IF NOT EXISTS (SELECT * FROM sysobjects WHERE name='ExamViolationVideos' AND xtype='U')
            CREATE TABLE ExamViolationVideos (
                Id INT IDENTITY(1,1) PRIMARY KEY,
                ViolationId INT NOT NULL,
                VideoPath NVARCHAR(500) NOT NULL,
                Duration INT DEFAULT 20,
                FileSizeMB FLOAT NULL,
                CreatedAt DATETIME DEFAULT GETDATE()
            )
        """)

        for col_def in [("MaxPeriodsPerDay", "INT DEFAULT 7"), ("WorkingDays", "NVARCHAR(50) NULL")]:
            col_name, col_type = col_def
            cursor.execute(f"""
                IF NOT EXISTS (SELECT * FROM sys.columns
                            WHERE name='{col_name}' AND object_id=OBJECT_ID('Users'))
                ALTER TABLE Users ADD {col_name} {col_type}
            """)

        os.makedirs('uploads/exams/violations', exist_ok=True)
        os.makedirs('uploads/exams/videos', exist_ok=True)
        conn.commit()
        # ✅ إنشاء مجلدات مطلوبة
        os.makedirs('uploads/alerts/videos', exist_ok=True)
        os.makedirs('uploads/alerts/images', exist_ok=True)
        os.makedirs('uploads/faces', exist_ok=True)
        os.makedirs('uploads/excuses', exist_ok=True)
        os.makedirs('exports', exist_ok=True)

        conn.commit()
        conn.close()
        log_success("✅ تم إنشاء الجداول بنجاح.")
    except Exception as e:
        log_error(f"❌ فشل إنشاء الجداول: {e}")
        traceback.print_exc()

    # ====== فحص الإنترنت الأولي ======
    log_separator()
    log_info("🌐 فحص الاتصال بالإنترنت...")
    is_online = check_internet_available()
    app.config['INTERNET_AVAILABLE'] = is_online
    if is_online:
        log_success("✅ الإنترنت متصل — كل الميزات مفعّلة.")
    else:
        log_warning("⚠️ لا يوجد إنترنت — الإشعارات ستُخزن مؤقتاً وتُرسل عند عودة الاتصال.")

    # ====== تحميل الكاشات ======
    log_separator()
    log_info("🚀 بدء تشغيل نظام الحضور الذكي...")
    log_info(f"📅 التاريخ والوقت: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}")
    log_separator()

    log_info("📋 إعدادات النظام:")
    log_info(f"   📧 البريد: {EMAIL_SENDER}")
    log_info(f"   🤖 توكن التيليجرام: {TELEGRAM_TOKEN[:10] if TELEGRAM_TOKEN else 'فارغ'}...")
    log_info(f"   🔗 رابط الخادم: {BASE_URL}")
    log_info(f"   🖥️  خادم SQL: {os.getenv('DB_SERVER')}")
    log_info(f"   📁 قاعدة البيانات: {os.getenv('DB_NAME')}")
    log_separator()

    load_notification_cache()
    load_users_cache()

    # ====== تشغيل الخيوط ======
    scheduler_thread = threading.Thread(target=run_scheduler, daemon=True, name="Scheduler")
    scheduler_thread.start()
    log_info("⏰ تم تشغيل المجدول.")

    attendance_thread = threading.Thread(target=process_attendance_queue, daemon=True, name="AttendanceQueue")
    attendance_thread.start()
    log_info("📊 تم تشغيل طابعة الحضور.")

    video_thread = threading.Thread(target=video_buffer_worker, daemon=True, name="VideoBuffer")
    video_thread.start()
    log_info("🎥 تم تشغيل خدمة تسجيل الفيديو.")

    # ⬇️⬇️⬇️⬇️⬇️⬇️ أضف هذه الأسطر هنا ⬇️⬇️⬇️⬇️⬇️⬇️

    exam_thread = threading.Thread(target=exam_monitor_worker, daemon=True, name="ExamMonitor")
    exam_thread.start()
    log_info("🎥 تم تشغيل خيط مراقبة الاختبارات")

    exam_scheduler_thread = threading.Thread(target=exam_scheduler_worker, daemon=True, name="ExamScheduler")
    exam_scheduler_thread.start()
    log_info("⏰ تم تشغيل خيط المؤقت التلقائي للاختبارات")

    # ⬆️⬆️⬆️⬆️⬆️⬆️ نهاية الإضافة ⬆️⬆️⬆️⬆️⬆️⬆️

    if is_online:
        try:
            set_telegram_webhook()
        except Exception as e:
            log_warning(f"⚠️ خطأ Webhook: {e}")

    log_separator()
    log_info("🚀 التحسينات المُفعّلة:")
    log_info("   ✅ InsightFace buffalo_l @ 320x320")
    log_info("   ✅ فلتر الحركة (توفير ~70%)")
    log_info("   ✅ تدوير الديتكتورات (واحد/إطار)")
    log_info("   ✅ كاش الوجوه (TTL 3s)")
    log_info("   ✅ Request Coalescer")
    log_info("   ✅ MAX_CONCURRENT_RECORDINGS = 1")
    log_info("   ✅ ThreadPoolExecutor = 2")
    log_info(f"   🎯 YOLO Backend: {YOLO_BACKEND.upper()}")
    log_info("   ✅ Cache-Control قوي للـ static")
    log_info("   ✅ Gzip pre-compression")
    log_info("   ✅ Service Worker ذكي")
    log_info("   📊 راقب الأداء: /api/system/performance")
    log_separator()
    log_success("🚀 نظام الحضور الذكي - الخادم يعمل")
    log_info("🌐 الخادم يعمل على: http://0.0.0.0:5000")
    log_info("💡 افتح المتصفح على http://localhost:5000")
    log_info("🛑 للإيقاف: اضغط Ctrl+C")
    log_separator()

    # ====== فحص المنفذ 5000 ======
    def is_port_in_use(port):
        sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        result = sock.connect_ex(('127.0.0.1', port))
        sock.close()
        return result == 0

    if is_port_in_use(5000):
        log_error("🚨 المنفذ 5000 مستخدم بالفعل من عملية أخرى!")
        log_info("🔍 لمعرفة العملية:")
        log_info("   netstat -ano | findstr :5000")
        log_info("   taskkill /F /PID <رقم_العملية>")
        try:
            choice = input("\n❓ هل تريد المتابعة على منفذ آخر (5001)؟ (y/n): ").strip().lower()
            if choice == 'y':
                PORT = 5001
                log_info(f"🔄 سيتم التشغيل على المنفذ {PORT}")
            else:
                log_info("🛑 تم الإلغاء. أغلق العملية الأخرى ثم أعد المحاولة.")
                sys.exit(1)
        except EOFError:
            PORT = 5001
            log_warning(f"⚠️ لا يمكن السؤال — سيتم استخدام المنفذ {PORT}")
    else:
        PORT = 5000

    # ====== تشغيل الخادم ======
    try:
        from waitress import serve
        log_info(f"🚀 تشغيل Waitress على المنفذ {PORT}...")
        log_info("📡 في انتظار الطلبات...")
        log_separator()
        serve(app, host='0.0.0.0', port=PORT, threads=8)
    except ImportError as ie:
        log_warning(f"⚠️ Waitress غير مثبت: {ie}")
        log_info("📦 للتثبيت: pip install waitress")
        log_info("🔄 تشغيل Flask مباشرة...")
        app.run(host='0.0.0.0', port=PORT, debug=False, threaded=True, use_reloader=False)
    except OSError as ose:
        log_error(f"❌ فشل فتح المنفذ {PORT}: {ose}")
        log_error("💡 تأكد من إغلاق أي خادم آخر على نفس المنفذ")
        traceback.print_exc()
        sys.exit(1)
    except KeyboardInterrupt:
        log_warning("\n🛑 تم إيقاف الخادم بواسطة المستخدم (Ctrl+C).")
    except Exception as e:
        log_separator()
        log_error(f"❌ خطأ فادح: {type(e).__name__}: {e}")
        print("\n📋 التفاصيل الكاملة:", flush=True)
        traceback.print_exc()
        log_separator()
        log_info("🔄 محاولة التشغيل بـ Flask...")
        try:
            app.run(host='0.0.0.0', port=PORT, debug=False, threaded=True, use_reloader=False)
        except Exception as e2:
            log_error(f"❌ فشل Flask أيضاً: {e2}")
            traceback.print_exc()
    finally:
        log_separator()
        log_info("🧹 إيقاف فوري...")
        try:
            cv2.destroyAllWindows()
        except Exception:
            pass
        # ✅ لا ننتظر الخيوط — نخرج فوراً
        # الخيوط daemon وستُقتل مع العملية
        log_success("✅ تم الإيقاف")
        os._exit(0)