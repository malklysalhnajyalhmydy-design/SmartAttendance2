# ======================== دوال الاتصال بقاعدة البيانات ========================
def get_db_connection():
    """الحصول على اتصال من الـ Pool"""
    try:
        db_pool._init_pool()
        conn = db_pool.pool.get(timeout=5)
        # اختبار
        try:
            conn.cursor().execute("SELECT 1")
        except Exception:
            try:
                conn.close()
            except Exception:
                pass
            conn = pyodbc.connect(DB_CONNECTION_STRING)
        return conn
    except Exception:
        return pyodbc.connect(DB_CONNECTION_STRING)

def get_user_by_id(uid):
    """جلب بيانات المستخدم حسب الـ ID — تُستخدم للأفاتار والبروفايل"""
    if not uid:
        return None
    try:
        conn = get_db_connection()
        cursor = conn.cursor()
        cursor.execute("""
            SELECT Id, Name, Role, Class, ProfileImage
            FROM Users
            WHERE Id = ? AND IsActive = 1
        """, (uid,))
        row = cursor.fetchone()
        conn.close()
        if not row:
            return None
        return {
            'id': row.Id,
            'name': row.Name,
            'role': row.Role,
            'class': row.Class or '',
            'profile_image': row.ProfileImage or ''
        }
    except Exception as e:
        print(f"⚠️ خطأ في get_user_by_id({uid}): {e}", flush=True)
        return None
from contextlib import contextmanager

@contextmanager
def db_conn():
    """Context manager لاتصالات DB — يغلق تلقائياً حتى عند الخطأ"""
    conn = None
    try:
        conn = get_db_connection()
        yield conn
    finally:
        if conn:
            try:
                conn.close()
            except Exception:
                pass


# ✅ Connection Pool للأداء
class DBPool:
    """مخزن اتصالات DB — يقلل زمن الاتصال 3-5x"""
    def __init__(self, conn_string, size=5):
        self.conn_string = conn_string
        self.pool = queue.Queue(maxsize=size)
        self.size = size
        self.lock = threading.Lock()
        self._initialized = False

    def _init_pool(self):
        with self.lock:
            if self._initialized:
                return
            for _ in range(self.size):
                try:
                    self.pool.put(pyodbc.connect(self.conn_string), block=False)
                except Exception as e:
                    print(f"⚠️ فشل إنشاء اتصال في pool: {e}", flush=True)
            self._initialized = True
            print(f"✅ Connection Pool جاهز ({self.pool.qsize()} اتصال)", flush=True)

    @contextmanager
    def get(self, timeout=10):
        if not self._initialized:
            self._init_pool()
        conn = None
        try:
            conn = self.pool.get(timeout=timeout)
            # اختبار الاتصال
            try:
                conn.cursor().execute("SELECT 1")
            except Exception:
                try:
                    conn.close()
                except Exception:
                    pass
                conn = pyodbc.connect(self.conn_string)
            yield conn
        except queue.Empty:
            # Pool ممتلئ → أنشئ اتصالاً مؤقتاً
            conn = pyodbc.connect(self.conn_string)
            try:
                yield conn
            finally:
                try:
                    conn.close()
                except Exception:
                    pass
        finally:
            if conn:
                try:
                    self.pool.put(conn, block=False)
                except queue.Full:
                    try:
                        conn.close()
                    except Exception:
                        pass


db_pool = DBPool(DB_CONNECTION_STRING, size=5)

# ======================== دوال إعدادات النظام ========================
def load_settings():
    if os.path.exists(SETTINGS_FILE):
        with open(SETTINGS_FILE, "r", encoding="utf-8") as f:
            try:
                return json.load(f)
            except Exception:
                pass
    return {
        "start_time": "08:00", "absence_time": "08:30", "end_time": "12:00",
        "academic_year_start": "", "academic_year_end": "",
        "weekly_holidays": [], "annual_holidays": [],
        "student_threshold": 20, "teacher_threshold": 15,
        "admin_email": EMAIL_SENDER, "admin_telegram_chat_id": None,
        "rtsp_url": "", "is_24h_mode": False,
        "guard_email": "", "guard_telegram_chat_id": ""
    }


def save_settings(settings):
    with open(SETTINGS_FILE, "w", encoding="utf-8") as f:
        json.dump(settings, f, indent=4)


# ======================== دوال الأوقات والعطل ========================
def is_within_attendance_time():
    settings = load_settings()
    if settings.get('is_24h_mode', False):
        return True
    now = datetime.now().strftime("%H:%M")
    start = settings.get("start_time", "08:00")
    end = settings.get("end_time", "12:00")
    if start <= end:
        return start <= now <= end
    else:
        return now >= start or now <= end


def is_guard_mode():
    settings = load_settings()
    today = datetime.now().strftime("%Y-%m-%d")
    if is_holiday(today):
        return True
    now = datetime.now().strftime("%H:%M")
    start = settings.get("start_time", "08:00")
    end = settings.get("end_time", "12:00")
    if start <= end:
        is_inside = start <= now <= end
    else:
        is_inside = now >= start or now <= end
    return not is_inside


def is_annual_holiday(today_date):
    settings = load_settings()
    try:
        dt = datetime.strptime(today_date, "%Y-%m-%d")
        month_day = dt.strftime("%m-%d")
        for item in settings.get("annual_holidays", []):
            if item.startswith(month_day):
                return True
    except Exception:
        pass
    return False


def is_individual_holiday(user_id, today_date):
    conn = get_db_connection()
    cursor = conn.cursor()
    cursor.execute("SELECT COUNT(*) FROM IndividualHolidays WHERE UserId = ? AND HolidayDate = ?", (user_id, today_date))
    count = cursor.fetchone()[0]
    conn.close()
    return count > 0


def is_holiday(today_date, user_id=None):
    if is_annual_holiday(today_date):
        return True
    try:
        dt = datetime.strptime(today_date, "%Y-%m-%d")
        if WEEKDAYS_AR[dt.weekday()] in load_settings().get("weekly_holidays", []):
            return True
    except Exception:
        pass
    acs = load_settings().get("academic_year_start", "")
    ace = load_settings().get("academic_year_end", "")
    if acs and ace and (today_date < acs or today_date > ace):
        return True
    conn = get_db_connection()
    cursor = conn.cursor()
    cursor.execute("SELECT COUNT(*) FROM Holidays WHERE HolidayDate <= ? AND (EndDate >= ? OR EndDate IS NULL) AND (HolidayType IS NULL OR HolidayType = N'عامة')", (today_date, today_date))
    if cursor.fetchone()[0] > 0:
        conn.close()
        return True
    conn.close()
    if user_id and is_individual_holiday(user_id, today_date):
        return True
    return False


# ======================== دوال تيليجرام والإيميل (آمنة بدون إنترنت) ========================
def set_telegram_webhook():
    """تعيين Webhook — لا يفشل النظام إذا انقطع الإنترنت"""
    if not TELEGRAM_TOKEN:
        log_warning("⚠️ TELEGRAM_TOKEN غير معرّف — تم تخطي Webhook")
        return
    url = f"https://api.telegram.org/bot{TELEGRAM_TOKEN}/setWebhook"
    webhook_url = f"{BASE_URL}/webhook"
    try:
        print(f"📤 محاولة تعيين Webhook إلى: {webhook_url}", flush=True)
        response = requests.post(url, json={"url": webhook_url}, timeout=NETWORK_TIMEOUT)
        result = response.json()
        if result.get('ok'):
            log_success("✅ تم تعيين Webhook بنجاح.")
        else:
            log_warning(f"⚠️ فشل تعيين Webhook: {result.get('description')}")
    except requests.exceptions.ConnectionError:
        log_warning("⚠️ لا يوجد إنترنت — تم تخطي Webhook (النظام يعمل بشكل عادي)")
    except requests.exceptions.Timeout:
        log_warning("⚠️ انتهت مهلة الاتصال بـ Telegram (تم التخطي)")
    except Exception as e:
        log_warning(f"⚠️ خطأ Webhook: {type(e).__name__}: {str(e)[:100]}")


def _send_telegram_raw(chat_id, message, retries=2):
    """نسخة داخلية من send_telegram بدون فحص الإنترنت"""
    if not TELEGRAM_TOKEN or not chat_id:
        return False
    url = f"https://api.telegram.org/bot{TELEGRAM_TOKEN}/sendMessage"
    payload = {"chat_id": chat_id, "text": message, "parse_mode": "HTML"}
    for attempt in range(retries):
        try:
            response = requests.post(url, json=payload, timeout=NETWORK_TIMEOUT)
            result = response.json()
            if response.status_code == 200 and result.get('ok'):
                return True
            else:
                time.sleep(2)
        except requests.exceptions.ConnectionError:
            return False
        except Exception:
            time.sleep(2)
    return False


def send_telegram(chat_id, message, retries=3):
    """إرسال رسالة تيليجرام — آمن عند انقطاع الإنترنت"""
    if not chat_id:
        print("❌ chat_id فارغ، لا يمكن الإرسال.", flush=True)
        return False
    if not TELEGRAM_TOKEN:
        return False

    if not app.config.get('INTERNET_AVAILABLE', True):
        if not check_internet_available():
            save_pending_notification('telegram', str(chat_id), message)
            return False
        app.config['INTERNET_AVAILABLE'] = True

    print(f"📤 محاولة إرسال تيليجرام إلى: {chat_id} (الرسالة: {message[:30]}...)", flush=True)
    try:
        success = _send_telegram_raw(chat_id, message, retries)
        if success:
            print(f"✅ تم إرسال الرسالة إلى {chat_id}", flush=True)
            return True
        else:
            print(f"⚠️ فشل الإرسال إلى {chat_id}", flush=True)
            save_pending_notification('telegram', str(chat_id), message)
            return False
    except requests.exceptions.ConnectionError:
        mark_internet_unavailable()
        save_pending_notification('telegram', str(chat_id), message)
        return False
    except requests.exceptions.Timeout:
        print("⚠️ انتهت مهلة إرسال التيليجرام", flush=True)
        save_pending_notification('telegram', str(chat_id), message)
        return False
    except Exception as e:
        print(f"❌ استثناء في send_telegram: {type(e).__name__}: {e}", flush=True)
        return False


def _send_email_raw(to_email, subject, body, attachment_path=None):
    """نسخة داخلية من send_email"""
    try:
        msg = MIMEMultipart()
        msg['From'], msg['To'], msg['Subject'] = EMAIL_SENDER, to_email, subject
        msg.attach(MIMEText(body, 'plain', 'utf-8'))
        if attachment_path and os.path.exists(attachment_path):
            with open(attachment_path, 'rb') as f:
                part = MIMEBase('application', 'pdf')
                part.set_payload(f.read())
                encoders.encode_base64(part)
                part.add_header('Content-Disposition', f'attachment; filename={os.path.basename(attachment_path)}')
                msg.attach(part)
        server = smtplib.SMTP('smtp.gmail.com', 587, timeout=NETWORK_TIMEOUT)
        server.starttls()
        server.login(EMAIL_SENDER, EMAIL_PASSWORD)
        server.send_message(msg)
        server.quit()
        return True
    except Exception:
        return False


def send_email(to_email, subject, body, attachment_path=None):
    """إرسال بريد — آمن عند انقطاع الإنترنت"""
    if not to_email:
        return False
    if not app.config.get('INTERNET_AVAILABLE', True):
        if not check_internet_available():
            save_pending_notification('email', to_email, f"{subject}\n\n{body}")
            return False
        app.config['INTERNET_AVAILABLE'] = True

    try:
        success = _send_email_raw(to_email, subject, body, attachment_path)
        if success:
            print(f"✅ بريد إلى {to_email}", flush=True)
            return True
        else:
            print(f"⚠️ فشل إرسال بريد إلى {to_email}", flush=True)
            save_pending_notification('email', to_email, f"{subject}\n\n{body}")
            return False
    except smtplib.SMTPAuthenticationError as e:
        print(f"❌ خطأ مصادقة البريد: {e}", flush=True)
        return False
    except (smtplib.SMTPConnectError, OSError):
        mark_internet_unavailable()
        save_pending_notification('email', to_email, f"{subject}\n\n{body}")
        return False
    except Exception as e:
        print(f"❌ استثناء في send_email: {type(e).__name__}: {e}", flush=True)
        return False


