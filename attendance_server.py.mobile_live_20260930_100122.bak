@app.errorhandler(400)
def handle_400(e):
    print(f"\n{'='*60}", flush=True)
    print(f"⚠️ [400] طلب سيئ: {request.method} {request.path}", flush=True)
    print(f"   البيانات: {request.get_json(silent=True)}", flush=True)
    print(f"{'='*60}\n", flush=True)
    return jsonify({"success": False, "message": "طلب غير صالح"}), 400


@app.errorhandler(401)
def handle_401(e):
    print(f"\n{'='*60}", flush=True)
    print(f"🔒 [401] غير مصرح: {request.method} {request.path}", flush=True)
    print(f"   Session: {dict(session)}", flush=True)
    print(f"{'='*60}\n", flush=True)
    return jsonify({"success": False, "message": "غير مصرح"}), 401


@app.errorhandler(404)
def handle_404(e):
    print(f"\n{'='*60}", flush=True)
    print(f"❓ [404] غير موجود: {request.method} {request.path}", flush=True)
    print(f"{'='*60}\n", flush=True)
    return jsonify({"success": False, "message": "غير موجود"}), 404


@app.errorhandler(500)
def handle_500(e):
    print(f"\n{'='*60}", flush=True)
    print(f"🔥 [500] خطأ داخلي: {request.method} {request.path}", flush=True)
    print(f"   الخطأ: {e}", flush=True)
    print(f"   التفاصيل:", flush=True)
    import traceback as _tb
    _tb.print_exc()
    print(f"{'='*60}\n", flush=True)
    return jsonify({"success": False, "message": "خطأ داخلي في السيرفر"}), 500


@app.errorhandler(Exception)
def handle_any_exception(e):
    """يلتقط أي خطأ غير معالج"""
    print(f"\n{'='*60}", flush=True)
    print(f"💥 خطأ غير متوقع: {request.method} {request.path}", flush=True)
    print(f"   النوع: {type(e).__name__}", flush=True)
    print(f"   الرسالة: {e}", flush=True)
    print(f"   التفاصيل الكاملة:", flush=True)
    import traceback as _tb
    _tb.print_exc()
    print(f"{'='*60}\n", flush=True)
    return jsonify({"success": False, "message": f"خطأ: {str(e)}"}), 500

