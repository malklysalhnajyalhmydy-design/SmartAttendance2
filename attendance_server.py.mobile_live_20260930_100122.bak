@app.route('/api/exams/sessions/<int:sid>/live')
def api_exam_session_live(sid):
    if session.get('role') not in ['مدير', 'مشرف']: return jsonify({"error": "غير مصرح"}), 401
    conn = get_db_connection(); cursor = conn.cursor()
    cursor.execute("SELECT Status, ExamName, TotalViolations FROM ExamSessions WHERE Id=?", (sid,))
    srow = cursor.fetchone()
    if not srow: conn.close(); return jsonify({"error": "غير موجود"}), 404
    cursor.execute("""SELECT esc.Id, esc.ClassroomId, esc.ClassroomName, esc.Subject,
                      esc.TeacherId, t.Name as TeacherName, esc.SupervisorId, s.Name as SupervisorName,
                      esc.ViolationCount, esc.Status as ClassStatus
                      FROM ExamSessionClassrooms esc
                      LEFT JOIN Users t ON esc.TeacherId = t.Id
                      LEFT JOIN Users s ON esc.SupervisorId = s.Id WHERE esc.SessionId = ?""", (sid,))
    cls_rows = cursor.fetchall()
    cursor.execute("""SELECT TOP 30 Id, ClassroomId, ClassroomName, ViolationType, Severity, Description,
                      ImagePath, IsRead, ReviewStatus, CreatedAt, TeacherNotified, SupervisorNotified, PrincipalNotified
                      FROM ExamViolations WHERE SessionId=? ORDER BY CreatedAt DESC""", (sid,))
    viol_rows = cursor.fetchall(); conn.close()
    return jsonify({
        'status': srow.Status, 'exam_name': srow.ExamName, 'total_violations': srow.TotalViolations or 0,
        'classrooms': [{'sc_id': c.Id, 'classroom_id': c.ClassroomId, 'classroom_name': c.ClassroomName,
                        'subject': c.Subject, 'teacher_name': c.TeacherName, 'supervisor_name': c.SupervisorName,
                        'violation_count': c.ViolationCount or 0, 'class_status': c.ClassStatus or 'idle'} for c in cls_rows],
        'recent_violations': [{'id': v.Id, 'classroom_id': v.ClassroomId, 'classroom_name': v.ClassroomName,
                               'type': v.ViolationType, 'severity': v.Severity, 'description': v.Description,
                               'image_path': v.ImagePath, 'is_read': bool(v.IsRead),
                               'review_status': v.ReviewStatus,
                               'teacher_notified': bool(v.TeacherNotified),
                               'supervisor_notified': bool(v.SupervisorNotified),
                               'principal_notified': bool(v.PrincipalNotified),
                               'created_at': str(v.CreatedAt) if v.CreatedAt else None} for v in viol_rows]
    })


@app.route('/api/exams/sessions/<int:sid>/classrooms-status')
def api_exam_classrooms_status(sid):
    if session.get('role') not in ['مدير', 'مشرف']: return jsonify({"error": "غير مصرح"}), 401
    conn = get_db_connection(); cursor = conn.cursor()
    cursor.execute("""SELECT esc.Id, esc.ClassroomId, esc.ClassroomName, esc.Subject,
                      esc.TeacherId, t.Name as TeacherName, esc.SupervisorId, s.Name as SupervisorName,
                      esc.StartTime, esc.EndTime, esc.Status as ClassStatus, esc.AutoStart, esc.AutoStop,
                      esc.ViolationCount, esc.ExamDate
                      FROM ExamSessionClassrooms esc
                      LEFT JOIN Users t ON esc.TeacherId = t.Id
                      LEFT JOIN Users s ON esc.SupervisorId = s.Id WHERE esc.SessionId = ?""", (sid,))
    rows = cursor.fetchall(); conn.close()
    now = datetime.now(); result = []
    for r in rows:
        remaining = None; progress = 0
        if r.ClassStatus == 'running' and r.EndTime:
            try:
                end_dt = datetime.strptime(f"{r.ExamDate} {r.EndTime}", "%Y-%m-%d %H:%M")
                remaining = max(0, int((end_dt - now).total_seconds()))
                if r.StartTime:
                    start_dt = datetime.strptime(f"{r.ExamDate} {r.StartTime}", "%Y-%m-%d %H:%M")
                    total = (end_dt - start_dt).total_seconds()
                    elapsed = (now - start_dt).total_seconds()
                    if total > 0: progress = min(100, max(0, int((elapsed/total)*100)))
            except Exception: pass
        elif r.ClassStatus == 'idle' and r.StartTime:
            try:
                start_dt = datetime.strptime(f"{r.ExamDate} {r.StartTime}", "%Y-%m-%d %H:%M")
                remaining = max(0, int((start_dt - now).total_seconds()))
            except Exception: pass
        result.append({
            'sc_id': r.Id, 'classroom_id': r.ClassroomId, 'classroom_name': r.ClassroomName,
            'subject': r.Subject, 'teacher_name': r.TeacherName, 'supervisor_name': r.SupervisorName,
            'start_time': r.StartTime, 'end_time': r.EndTime, 'class_status': r.ClassStatus or 'idle',
            'auto_start': bool(r.AutoStart), 'auto_stop': bool(r.AutoStop),
            'violation_count': r.ViolationCount or 0,
            'remaining_seconds': remaining, 'progress': progress
        })
    return jsonify(result)


