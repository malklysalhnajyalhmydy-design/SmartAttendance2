@app.route('/api/teachers/<int:tid>', methods=['PUT'])
def api_teacher_update(tid):
    if session.get('role') not in ['مدير', 'مشرف']: return jsonify({"error": "غير مصرح"}), 401
    data = request.get_json()
    conn = get_db_connection(); cursor = conn.cursor()
    working = ','.join(str(x) for x in data.get('working_days', [0,1,2,3,4]))
    cursor.execute("""UPDATE Users SET Name=?, Email=?, Phone=?, WorkingDays=?, MaxPeriodsPerDay=?
                      WHERE Id=? AND Role=N'معلم'""",
                   (data['name'], data.get('email'), data.get('phone'), working,
                    data.get('max_periods', 7), tid))
    if 'subjects' in data:
        cursor.execute("DELETE FROM TeacherSubjects WHERE TeacherId=?", (tid,))
        for sub in data['subjects']:
            cursor.execute("INSERT INTO TeacherSubjects (TeacherId, Subject) VALUES (?, ?)", (tid, sub))
    conn.commit(); conn.close()
    return jsonify({"success": True, "message": "✅ تم التحديث"})


