def send_absence_notifications(today, now_time):
    """
    إرسال إشعارات الغياب تلقائياً.
    ✅ التعديل:
      - تجاهل المعلمين في أيام عدم دوامهم
    """
    conn = get_db_connection()
    cursor = conn.cursor()

    roles = [
        {
            "role": "طالب",
            "email_field": "ParentEmail",
            "email_subject": "إشعار غياب - مدارس المنال الأهلية",
            "email_body": "عزيزي ولي الأمر، تم رصد غياب ابنكم ({name}) اليوم.\n\nإدارة المدرسة",
            "telegram_text": "❌ تنبيه غياب\n\nالطالب: {name}\nالتاريخ: {today}\nلم يحضر حتى {now_time}."
        },
        {
            "role": "معلم",
            "email_field": "Email",
            "email_subject": "إشعار غياب - مدارس المنال الأهلية",
            "email_body": "الأستاذ الفاضل، تم تسجيل غيابكم اليوم.\n\nإدارة المدرسة",
            "telegram_text": "❌ تنبيه غياب\n\nالمعلم: {name}\nالتاريخ: {today}\nلم يحضر حتى {now_time}."
        },
        {
            "role": "مشرف",
            "email_field": "Email",
            "email_subject": "متابعة الغياب - مدارس المنال الأهلية",
            "email_body": "سيدي المشرف، تم تسجيل حالات غياب.\n\nإدارة المدرسة",
            "telegram_text": "❌ تنبيه غياب\n\nالمشرف: {name}\nالتاريخ: {today}\nلم يحضر حتى {now_time}."
        },
        {
            "role": "حارس",
            "email_field": "Email",
            "email_subject": "تنبيه حراسة - مدارس المنال الأهلية",
            "email_body": "حارس المدرسة، حركة دخول في وقت غير معتاد.\n\nإدارة المدرسة",
            "telegram_text": "❌ تنبيه غياب\n\nالحارس: {name}\nالتاريخ: {today}\nلم يحضر حتى {now_time}."
        }
    ]

    for role_info in roles:
        role = role_info["role"]
        email_field = role_info["email_field"]

        query = f"""
            SELECT u.Id, u.Name, u.{email_field} as Email, u.TelegramChatID
            FROM Users u
            WHERE u.Role = ? AND u.IsActive = 1
              AND u.Id NOT IN (SELECT DISTINCT UserId FROM Attendance WHERE AttendanceDate = ?)
              AND u.Id NOT IN (SELECT UserId FROM IndividualHolidays WHERE HolidayDate = ?)
        """
        cursor.execute(query, (role, today, today))

        for person in cursor.fetchall():
            user_id = person.Id
            name = person.Name
            email = person.Email
            chat_id = person.TelegramChatID

            # ✅ 🆕 تجاهل المعلم في أيام عدم دوامه
            if role == 'معلم':
                if not is_teacher_working_day(user_id, today):
                    print(f"📅 {name} (معلم) - ليس يوم دوامه - تجاهل إشعار الغياب", flush=True)
                    continue

            # هل تم إرسال إشعار الغياب سابقاً؟
            if has_notification_been_sent(user_id, 'absence', today):
                continue

            # إرسال الإيميل
            if email:
                body = role_info["email_body"].format(name=name)
                send_email(email, role_info["email_subject"], body)

            # إرسال تلجرام
            if chat_id:
                text = role_info["telegram_text"].format(name=name, today=today, now_time=now_time)
                send_telegram(chat_id, text)

            mark_notification_sent(user_id, 'absence')

    conn.close()

def automated_finalize():
    try:
        settings = load_settings()
        if settings.get('is_24h_mode', False):
            return
        now_time = datetime.now().strftime("%H:%M")
        today = datetime.now().strftime("%Y-%m-%d")
        if is_holiday(today):
            return
        absence_time = settings.get("absence_time", "08:30")
        if now_time == absence_time:
            with app.app_context():
                try:
                    send_absence_notifications(today, now_time)
                except Exception as e:
                    print(f"❌ فشل إشعارات الغياب: {e}", flush=True)
        end_time = settings.get("end_time", "12:00")
        if now_time == end_time:
            with app.app_context():
                try:
                    conn = get_db_connection()
                    cursor = conn.cursor()
                    cursor.execute("UPDATE Attendance SET CheckOutTime = ? WHERE AttendanceDate = ? AND CheckOutTime IS NULL",
                                   (datetime.now().strftime("%H:%M:%S"), today))
                    conn.commit()
                    conn.close()
                except Exception as e:
                    print(f"❌ فشل إنهاء الدوام: {e}", flush=True)
        if now_time == "12:05":
            with app.app_context():
                send_daily_absent_report()
    except Exception as e:
        print(f"❌ خطأ في automated_finalize: {e}", flush=True)
        traceback.print_exc()


# ============================================================
# ✅ [الجزء 5-أ] استبدل run_scheduler + أضف cleanup_memory_periodic
# ============================================================
def run_scheduler():
    schedule.every().minute.at(":00").do(automated_finalize)
    schedule.every().friday.at("10:00").do(weekly_dropout_check)
    schedule.every(10).minutes.do(clean_expired_codes)
    schedule.every().day.at("03:00").do(cleanup_old_videos, days=30)
    schedule.every().day.at("03:05").do(cleanup_empty_folders)
    schedule.every().hour.do(cleanup_memory_periodic)
    schedule.every().day.at("00:00").do(reset_guard_notification_counters)
    schedule.every().day.at("00:01").do(reset_daily_notifications)
    schedule.every(15).minutes.do(
        lambda: flush_pending_notifications() if app.config.get('INTERNET_AVAILABLE', True) else None
    )
   
    # ✅ هذان السطران — تأكد من وجودهما
    
    schedule.every(5).minutes.do(cleanup_exam_trackers_periodic)
    schedule.every().day.at("02:00").do(cleanup_old_exam_sessions)
    schedule.every(5).minutes.do(check_camera_health)
    schedule.every().day.at("02:00").do(backup_database)
   
    print("⏰ المجدول يعمل.", flush=True)
    while True:
        try:
            schedule.run_pending()
        except Exception as e:
            print(f"⚠️ خطأ في المجدول: {e}", flush=True)
            traceback.print_exc()
        time.sleep(30)
def cleanup_memory_periodic():
    """تنظيف الذاكرة الدوري"""
    try:
        conn = get_db_connection()
        cursor = conn.cursor()
        cursor.execute("SELECT Id, CameraIP FROM Classrooms WHERE IsActive = 1")
        classrooms_cache = cursor.fetchall()
        conn.close()
        cleanup_orphan_cameras(classrooms_cache)
    except Exception as e:
        print(f"⚠️ فشل cleanup_memory_periodic: {e}", flush=True)
# ============================================================


# ======================== دوال الأمان ========================
def is_account_locked(user_id):
    conn = get_db_connection()
    cursor = conn.cursor()
    cursor.execute("SELECT IsLocked, LockUntil FROM LoginAttempts WHERE UserId = ? AND IsLocked = 1", (user_id,))
    row = cursor.fetchone()
    conn.close()
    if row:
        if row.LockUntil and datetime.now() < row.LockUntil:
            return True
        else:
            conn = get_db_connection()
            cursor = conn.cursor()
            cursor.execute("UPDATE LoginAttempts SET IsLocked = 0, LockUntil = NULL WHERE UserId = ?", (user_id,))
            conn.commit()
            conn.close()
            return False
    return False


def log_login_attempt(user_id, success):
    conn = get_db_connection()
    cursor = conn.cursor()
    if success:
        cursor.execute("DELETE FROM LoginAttempts WHERE UserId = ?", (user_id,))
        conn.commit()
        conn.close()
        return False
    else:
        cursor.execute("INSERT INTO LoginAttempts (UserId, AttemptTime) VALUES (?, GETDATE())", (user_id,))
        conn.commit()
        cursor.execute("""
            SELECT COUNT(*) FROM LoginAttempts
            WHERE UserId = ? AND AttemptTime > DATEADD(MINUTE, -15, GETDATE()) AND IsLocked = 0
        """, (user_id,))
        count = cursor.fetchone()[0]
        if count >= 5:
            lock_until = datetime.now() + timedelta(minutes=10)
            cursor.execute("UPDATE LoginAttempts SET IsLocked = 1, LockUntil = ? WHERE UserId = ? AND IsLocked = 0", (lock_until, user_id))
            conn.commit()
            conn.close()
            return True
        conn.close()
        return False


def generate_reset_token(user_id):
    token = ''.join(random.choices(string.ascii_uppercase + string.digits + string.ascii_lowercase, k=64))
    expiry = datetime.now() + timedelta(minutes=10)
    conn = get_db_connection()
    cursor = conn.cursor()
    cursor.execute("INSERT INTO PasswordResetTokens (UserId, Token, ExpiryDate) VALUES (?, ?, ?)", (user_id, token, expiry))
    conn.commit()
    conn.close()
    return token


def verify_reset_token(token):
    conn = get_db_connection()
    cursor = conn.cursor()
    cursor.execute("SELECT UserId, ExpiryDate FROM PasswordResetTokens WHERE Token = ? AND IsUsed = 0", (token,))
    row = cursor.fetchone()
    conn.close()
    if row and row.ExpiryDate > datetime.now():
        return row.UserId
    return None


def mark_token_used(token):
    conn = get_db_connection()
    cursor = conn.cursor()
    cursor.execute("UPDATE PasswordResetTokens SET IsUsed = 1 WHERE Token = ?", (token,))
    conn.commit()
    conn.close()


