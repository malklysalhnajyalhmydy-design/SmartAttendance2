# ======================== 🎓 إنذارات الاختبارات ========================
@app.route('/api/alerts/exam-summary')
def api_alerts_exam_summary():
    """ملخص إنذارات كل جلسات الاختبارات"""
    if session.get('role') not in ['مدير', 'مشرف']:
        return jsonify({"error": "غير مصرح"}), 401
    try:
        conn = get_db_connection()
        cursor = conn.cursor()
        cursor.execute("""
            SELECT es.Id, es.ExamName, es.ExamDate, es.Status,
                   (SELECT COUNT(*) FROM ExamViolations
                    WHERE SessionId = es.Id AND (IsRead = 0 OR IsRead IS NULL)) as unread,
                   (SELECT TOP 1 CreatedAt FROM ExamViolations
                    WHERE SessionId = es.Id ORDER BY CreatedAt DESC) as last_violation,
                   (SELECT COUNT(*) FROM ExamViolations WHERE SessionId = es.Id) as real_count
            FROM ExamSessions es
            WHERE EXISTS (SELECT 1 FROM ExamViolations WHERE SessionId = es.Id)
            ORDER BY es.CreatedAt DESC
        """)
        sessions = cursor.fetchall()
        total_unread = sum((s.unread or 0) for s in sessions)
        total_violations = sum((s.real_count or 0) for s in sessions)
        result = {
            'total_sessions': len(sessions),
            'total_violations': total_violations,
            'unread': total_unread,
            'sessions': [{
                'id': s.Id,
                'exam_name': s.ExamName or '—',
                'exam_date': str(s.ExamDate) if s.ExamDate else '',
                'status': s.Status or 'idle',
                'violations': s.real_count or 0,
                'unread': s.unread or 0,
                'last_violation': str(s.last_violation) if s.last_violation else None
            } for s in sessions]
        }
        conn.close()
        return jsonify(result)
    except Exception as e:
        print(f"❌ خطأ في exam-summary: {e}", flush=True)
        traceback.print_exc()
        return jsonify({"error": str(e)}), 500


@app.route('/api/alerts/exam-session/<int:sid>/violations')
def api_alerts_exam_session_violations(sid):
    """جلب كل مخالفات جلسة اختبار محددة"""
    if session.get('role') not in ['مدير', 'مشرف']:
        return jsonify({"error": "غير مصرح"}), 401
    try:
        conn = get_db_connection()
        cursor = conn.cursor()
        cursor.execute("""
            SELECT ev.Id, ev.SessionId, ev.SessionClassroomId, ev.ClassroomId,
                   ev.ClassroomName, ev.ViolationType, ev.Severity, ev.Description,
                   ev.ImagePath, ev.ConfidenceScore, ev.IsRead, ev.ReviewStatus,
                   ev.CreatedAt, av.VideoPath
            FROM ExamViolations ev
            LEFT JOIN ExamViolationVideos av ON ev.Id = av.ViolationId
            WHERE ev.SessionId = ?
            ORDER BY ev.CreatedAt DESC
        """, (sid,))
        rows = cursor.fetchall()
        conn.close()
        return jsonify([{
            'id': r.Id, 'session_id': r.SessionId, 'sc_id': r.SessionClassroomId,
            'classroom_id': r.ClassroomId, 'classroom_name': r.ClassroomName or '—',
            'type': r.ViolationType, 'severity': r.Severity or 'medium',
            'description': r.Description or '', 'image_path': r.ImagePath,
            'video_path': r.VideoPath, 'confidence': r.ConfidenceScore,
            'is_read': bool(r.IsRead) if r.IsRead is not None else False,
            'review_status': r.ReviewStatus or 'pending',
            'created_at': str(r.CreatedAt) if r.CreatedAt else None
        } for r in rows])
    except Exception as e:
        print(f"❌ خطأ في exam violations: {e}", flush=True)
        return jsonify({"error": str(e)}), 500


