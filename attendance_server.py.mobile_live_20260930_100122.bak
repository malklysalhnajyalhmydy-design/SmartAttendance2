@app.route('/api/messages/<int:msg_id>/reply', methods=['POST'])
def api_message_reply(msg_id):
    """المدير/المشرف يرد على رسالة — مع اختيار قنوات الإرسال"""
    if session.get('role') not in ['مدير', 'مشرف']:
        return jsonify({"error": "غير مصرح"}), 401

    try:
        data = request.get_json() or {}
        reply_text = (data.get('message') or '').strip()
        send_inapp = data.get('send_inapp', True)
        send_email_flag = data.get('send_email', True)
        send_telegram_flag = data.get('send_telegram', True)

        if not reply_text or len(reply_text) < 3:
            return jsonify({"success": False, "message": "نص الرد قصير جداً"}), 400
        if not (send_inapp or send_email_flag or send_telegram_flag):
            return jsonify({"success": False, "message": "اختر قناة إرسال واحدة على الأقل"}), 400

        conn = get_db_connection()
        cursor = conn.cursor()
        cursor.execute("""
            SELECT Id, ThreadId, SenderUserId, SenderName, SenderRole, Subject
            FROM Messages WHERE Id = ?
        """, (msg_id,))
        root = cursor.fetchone()
        if not root:
            conn.close()
            return jsonify({"success": False, "message": "الرسالة غير موجودة"}), 404

        thread_id = root.ThreadId or root.Id
        admin_name = session.get('role', 'الإدارة')
        admin_user_id = session.get('user_id')

        # جلب اسم المدير/المشرف الحقيقي
        cursor.execute("SELECT Name FROM Users WHERE Id = ?", (admin_user_id,))
        admin_row = cursor.fetchone()
        if admin_row:
            admin_name = admin_row.Name

        cursor.execute("""
            INSERT INTO Messages
            (ThreadId, SenderUserId, SenderName, SenderRole, IsFromAdmin,
             Subject, MessageText, Status, SentViaInApp, SentViaEmail, SentViaTelegram, CreatedAt)
            OUTPUT INSERTED.Id
            VALUES (?, ?, ?, ?, 1, ?, ?, 'replied', ?, ?, ?, GETDATE())
        """, (
            thread_id,
            admin_user_id,
            admin_name,
            session.get('role'),
            f"رد على: {root.Subject}",
            reply_text,
            1 if send_inapp else 0,
            1 if send_email_flag else 0,
            1 if send_telegram_flag else 0
        ))
        reply_row = cursor.fetchone()
        if not reply_row:
            conn.rollback()
            conn.close()
            return jsonify({"success": False, "message": "فشل حفظ الرد"}), 500

        reply_id = int(reply_row[0])

        # تحديث حالة الرسالة الأصلية
        cursor.execute("UPDATE Messages SET Status = 'replied' WHERE Id = ? AND Status IN ('new', 'read')", (root.Id,))
        conn.commit()
        conn.close()

        # إرسال الإشعار للطرف الأول (تيليجرام + إيميل)
        target_info = _get_user_contact_info(root.SenderUserId)
        sent_channels = ['💬 داخل الصفحة'] if send_inapp else []

        if target_info:
            now_str = datetime.now().strftime("%Y-%m-%d %H:%M")

            if send_telegram_flag and target_info['chat_id']:
                tg_msg = (
                    f"📥 <b>رد من إدارة المدرسة</b>\n\n"
                    f"📌 <b>الموضوع:</b> {root.Subject}\n"
                    f"🕐 <b>الوقت:</b> {now_str}\n"
                    f"👤 <b>من:</b> {admin_name}\n\n"
                    f"📝 <b>الرد:</b>\n{reply_text}"
                )
                if send_telegram(str(target_info['chat_id']), tg_msg):
                    sent_channels.append('📱 تيليجرام')

            if send_email_flag:
                to_email = target_info['parent_email'] or target_info['email']
                if to_email:
                    subj = f"📥 رد من الإدارة: {root.Subject}"
                    body = (
                        f"عزيزي/عزيزتي {target_info['name']},\n\n"
                        f"رد على رسالتك بخصوص: {root.Subject}\n\n"
                        f"{reply_text}\n\n"
                        f"مع تحية إدارة المدرسة\n{now_str}"
                    )
                    if send_email(to_email, subj, body):
                        sent_channels.append('📧 إيميل')

        return jsonify({
            "success": True,
            "message": f"✅ تم إرسال الرد عبر: {' + '.join(sent_channels) if sent_channels else 'لا توجد قناة'}",
            "id": reply_id
        })
    except Exception as e:
        print(f"❌ خطأ في api_message_reply: {e}", flush=True)
        traceback.print_exc()
        return jsonify({"success": False, "message": str(e)}), 500


@app.route('/api/messages/<int:msg_id>', methods=['DELETE'])
def api_message_delete(msg_id):
    """حذف الرسالة وكل ردودها"""
    if session.get('role') not in ['مدير', 'مشرف']:
        return jsonify({"error": "غير مصرح"}), 401
    try:
        conn = get_db_connection()
        cursor = conn.cursor()
        cursor.execute("SELECT ThreadId FROM Messages WHERE Id = ?", (msg_id,))
        r = cursor.fetchone()
        if not r:
            conn.close()
            return jsonify({"success": False, "message": "غير موجود"}), 404
        thread_id = r.ThreadId or msg_id
        cursor.execute("DELETE FROM Messages WHERE ThreadId = ? OR Id = ?", (thread_id, thread_id))
        conn.commit()
        conn.close()
        return jsonify({"success": True, "message": "✅ تم حذف الرسالة وكل ردودها"})
    except Exception as e:
        return jsonify({"success": False, "message": str(e)}), 500


