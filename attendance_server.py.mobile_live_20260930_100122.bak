@app.route('/api/alerts/by-classroom')
def api_alerts_by_classroom():
    """قائمة الفصول مع عدّاد الإنذارات لكل نوع"""
    if session.get('role') not in ['مدير', 'مشرف']:
        return jsonify({"error": "غير مصرح"}), 401
    try:
        conn = get_db_connection()
        cursor = conn.cursor()

        cursor.execute("SELECT Id, Name FROM Classrooms WHERE IsActive = 1 ORDER BY Name")
        classrooms = cursor.fetchall()

        result = []
        for cls in classrooms:
            cursor.execute("SELECT COUNT(*) FROM Alerts WHERE ClassroomId = ?", (cls.Id,))
            total = cursor.fetchone()[0]

            cursor.execute("SELECT COUNT(*) FROM Alerts WHERE ClassroomId = ? AND IsRead = 0", (cls.Id,))
            unread = cursor.fetchone()[0]

            cursor.execute("SELECT TOP 1 CreatedAt FROM Alerts WHERE ClassroomId = ? ORDER BY CreatedAt DESC", (cls.Id,))
            last_row = cursor.fetchone()
            last_alert = str(last_row.CreatedAt) if last_row and last_row.CreatedAt else None

            cursor.execute("""
                SELECT AlertType, COUNT(*) as cnt
                FROM Alerts
                WHERE ClassroomId = ?
                GROUP BY AlertType
            """, (cls.Id,))
            counts = {r.AlertType: r.cnt for r in cursor.fetchall()}

            result.append({
                'classroom_id': cls.Id,
                'classroom_name': cls.Name,
                'total': total,
                'unread': unread,
                'last_alert': last_alert,
                'counts': {
                    'fire': counts.get('fire', 0),
                    'stranger': counts.get('stranger', 0),
                    'wrong_class': counts.get('wrong_class', 0),
                    'banned_item': counts.get('banned_item', 0),
                    'unauthorized_entry': counts.get('unauthorized_entry', 0)
                }
            })
        conn.close()
        return jsonify(result)
    except Exception as e:
        print(f"❌ خطأ في by-classroom: {e}", flush=True)
        traceback.print_exc()
        return jsonify({"error": str(e)}), 500


@app.route('/api/alerts/classroom/<int:cid>')
def api_alerts_for_classroom(cid):
    """جلب كل إنذارات فصل معيّن (مع حالة المراجعة + الفيديو)"""
    if session.get('role') not in ['مدير', 'مشرف']:
        return jsonify({"error": "غير مصرح"}), 401
    try:
        alert_type = request.args.get('type', '')
        status_filter = request.args.get('status', 'all')
        days = request.args.get('days', 0, type=int)
        limit = request.args.get('limit', 200, type=int)

        conditions = ["ClassroomId = ?"]
        params = [cid]

        if alert_type:
            conditions.append("AlertType = ?")
            params.append(alert_type)

        if status_filter == 'unread':
            conditions.append("IsRead = 0")

        if days > 0:
            conditions.append("CreatedAt >= DATEADD(DAY, -?, GETDATE())")
            params.append(days)

        where_clause = " AND ".join(conditions)

        conn = get_db_connection()
        cursor = conn.cursor()
        query = f"""
            SELECT TOP {limit}
                Id, ClassroomId, ClassroomName, UserId, UserName,
                AlertType, Description, ImagePath, IsRead, CreatedAt,
                ReviewStatus, ReviewNotes, ReviewedByName, ReviewedAt,
                VideoPath
            FROM Alerts
            WHERE {where_clause}
            ORDER BY CreatedAt DESC
        """
        cursor.execute(query, params)
        rows = cursor.fetchall()

        cursor.execute("SELECT Name FROM Classrooms WHERE Id = ?", (cid,))
        cls_row = cursor.fetchone()
        classroom_name = cls_row.Name if cls_row else '—'
        conn.close()

        return jsonify({
            'classroom_id': cid,
            'classroom_name': classroom_name,
            'alerts': [{
                'id': r.Id,
                'alert_type': r.AlertType,
                'description': r.Description,
                'image_path': r.ImagePath,
                'user_id': r.UserId,
                'user_name': r.UserName,
                'is_read': bool(r.IsRead),
                'created_at': str(r.CreatedAt) if r.CreatedAt else None,
                'review_status': r.ReviewStatus or 'pending',
                'review_notes': r.ReviewNotes,
                'reviewed_by': r.ReviewedByName,
                'reviewed_at': str(r.ReviewedAt) if r.ReviewedAt else None,
                'video_path': r.VideoPath
            } for r in rows]
        })
    except Exception as e:
        print(f"❌ خطأ في alerts classroom: {e}", flush=True)
        traceback.print_exc()
        return jsonify({"error": str(e)}), 500


@app.route('/api/alerts/<int:alert_id>/delete', methods=['POST'])
def api_alert_delete(alert_id):
    """حذف إنذار واحد + صورته + فيديوهاته + إشعاراته"""
    if session.get('role') not in ['مدير', 'مشرف']:
        return jsonify({"error": "غير مصرح"}), 401
    try:
        conn = get_db_connection()
        cursor = conn.cursor()

        # 1. جلب الصورة
        cursor.execute("SELECT ImagePath FROM Alerts WHERE Id = ?", (alert_id,))
        row = cursor.fetchone()
        if not row:
            conn.close()
            return jsonify({"success": False, "message": "الإنذار غير موجود"}), 404
        image_path = row.ImagePath

        # 2. جلب كل الفيديوهات
        cursor.execute("SELECT VideoPath FROM AlertVideos WHERE AlertId = ?", (alert_id,))
        video_paths = [r.VideoPath for r in cursor.fetchall() if r.VideoPath]

        # 3. حذف كل السجلات المرتبطة
        cursor.execute("DELETE FROM AlertNotifications WHERE AlertId = ?", (alert_id,))
        cursor.execute("DELETE FROM AlertVideos WHERE AlertId = ?", (alert_id,))
        cursor.execute("DELETE FROM Alerts WHERE Id = ?", (alert_id,))
        conn.commit()
        conn.close()

        # 4. حذف الملفات
        for path in [image_path] + video_paths:
            if path and os.path.exists(path):
                try:
                    os.remove(path)
                    print(f"🗑️ حذف: {path}", flush=True)
                except Exception as e:
                    print(f"⚠️ فشل حذف {path}: {e}", flush=True)

        return jsonify({"success": True, "message": "✅ تم حذف الإنذار وكل بياناته"})
    except Exception as e:
        print(f"❌ خطأ في حذف الإنذار: {e}", flush=True)
        traceback.print_exc()
        return jsonify({"success": False, "message": str(e)}), 500


@app.route('/api/alerts/delete-bulk', methods=['POST'])
def api_alerts_delete_bulk():
    """حذف مجموعة من الإنذارات مع كل ملفاتها وسجلاتها"""
    if session.get('role') not in ['مدير', 'مشرف']:
        return jsonify({"error": "غير مصرح"}), 401
    try:
        data = request.get_json()
        alert_ids = data.get('alert_ids', [])
        classroom_id = data.get('classroom_id')
        alert_type = data.get('alert_type')

        conn = get_db_connection()
        cursor = conn.cursor()

        # 1. تحديد قائمة IDs
        target_ids = []
        if alert_ids:
            target_ids = alert_ids
        elif classroom_id:
            conditions = ["ClassroomId = ?"]
            params = [classroom_id]
            if alert_type:
                conditions.append("AlertType = ?")
                params.append(alert_type)
            where_clause = " AND ".join(conditions)
            cursor.execute(f"SELECT Id FROM Alerts WHERE {where_clause}", params)
            target_ids = [r.Id for r in cursor.fetchall()]
        else:
            conn.close()
            return jsonify({"success": False, "message": "لم يتم تحديد إنذارات"}), 400

        if not target_ids:
            conn.close()
            return jsonify({"success": True, "message": "لا توجد إنذارات لحذفها", "deleted": 0})

        # 2. جمع كل الملفات
        placeholders = ','.join(['?'] * len(target_ids))

        cursor.execute(f"SELECT ImagePath FROM Alerts WHERE Id IN ({placeholders})", target_ids)
        image_paths = [r.ImagePath for r in cursor.fetchall() if r.ImagePath]

        cursor.execute(f"SELECT VideoPath FROM AlertVideos WHERE AlertId IN ({placeholders})", target_ids)
        video_paths = [r.VideoPath for r in cursor.fetchall() if r.VideoPath]

        # 3. حذف السجلات
        cursor.execute(f"DELETE FROM AlertNotifications WHERE AlertId IN ({placeholders})", target_ids)
        cursor.execute(f"DELETE FROM AlertVideos WHERE AlertId IN ({placeholders})", target_ids)
        cursor.execute(f"DELETE FROM Alerts WHERE Id IN ({placeholders})", target_ids)
        deleted_count = cursor.rowcount
        conn.commit()
        conn.close()

        # 4. حذف الملفات
        for path in image_paths + video_paths:
            try:
                if path and os.path.exists(path):
                    os.remove(path)
            except Exception:
                pass

        return jsonify({"success": True, "message": f"✅ تم حذف {deleted_count} إنذار وكل ملفاته", "deleted": deleted_count})
    except Exception as e:
        print(f"❌ خطأ في الحذف الجماعي: {e}", flush=True)
        traceback.print_exc()
        return jsonify({"success": False, "message": str(e)}), 500


@app.route('/api/alerts/export/<int:cid>')
def api_alerts_export(cid):
    """تصدير إنذارات فصل إلى Excel"""
    if session.get('role') not in ['مدير', 'مشرف']:
        return jsonify({"error": "غير مصرح"}), 401
    try:
        conn = get_db_connection()
        cursor = conn.cursor()

        cursor.execute("SELECT Name FROM Classrooms WHERE Id = ?", (cid,))
        cls_row = cursor.fetchone()
        if not cls_row:
            conn.close()
            return jsonify({"error": "الفصل غير موجود"}), 404
        classroom_name = cls_row.Name

        cursor.execute("""
            SELECT AlertType, Description, UserName, ImagePath, IsRead, CreatedAt
            FROM Alerts
            WHERE ClassroomId = ?
            ORDER BY CreatedAt DESC
        """, (cid,))
        rows = cursor.fetchall()
        conn.close()

        type_labels = {
            'fire': 'حريق/دخان',
            'stranger': 'شخص غريب',
            'wrong_class': 'طالب في فصل خطأ',
            'banned_item': 'مادة ممنوعة',
            'unauthorized_entry': 'دخول غير مصرح'
        }

        wb = openpyxl.Workbook()
        ws = wb.active
        ws.title = f"إنذارات {classroom_name}"
        ws.append(['التاريخ', 'النوع', 'الوصف', 'الشخص', 'الحالة', 'مسار الصورة'])
        for r in rows:
            ws.append([
                str(r.CreatedAt) if r.CreatedAt else '-',
                type_labels.get(r.AlertType, r.AlertType),
                r.Description or '-',
                r.UserName or '-',
                'مقروء' if r.IsRead else 'غير مقروء',
                r.ImagePath or '-'
            ])

        filename = f"alerts_{classroom_name}_{datetime.now().strftime('%Y%m%d%H%M%S')}.xlsx"
        filepath = os.path.join('exports', filename)
        os.makedirs('exports', exist_ok=True)
        wb.save(filepath)
        return send_file(filepath, as_attachment=True, download_name=filename)
    except Exception as e:
        print(f"❌ خطأ في تصدير الإنذارات: {e}", flush=True)
        return jsonify({"error": str(e)}), 500


