        return jsonify({"error": str(e)}), 500


@app.route('/health')
def health_check():
    """فحص صحة النظام"""
    result = {
        'status': 'ok',
        'uptime_seconds': int(time.time() - _START_TIME),
        'timestamp': datetime.now().isoformat(),
    }
    try:
        conn = get_db_connection()
        conn.cursor().execute("SELECT 1")
        conn.close()
        result['database'] = 'ok'
    except Exception as e:
        result['database'] = f'error: {str(e)[:50]}'
        result['status'] = 'degraded'

    result['internet'] = app.config.get('INTERNET_AVAILABLE', False)

    try:
        with persistent_captures_lock:
            result['cameras_active'] = len(persistent_captures)
        with video_buffers_lock:
            result['video_buffers'] = len(video_buffers)
        with users_cache_lock:
            result['users_cached'] = len(users_cache)
        with _exam_trackers_lock:
            result['exam_trackers'] = len(_exam_trackers)
    except Exception:
        pass

    return jsonify(result)


@app.route('/api/attendance/today-stats')
def api_attendance_today_stats():
    if session.get('role') not in ['مدير', 'مشرف']:
        return jsonify({"error": "غير مصرح"}), 401
    today = datetime.now().strftime("%Y-%m-%d")
    if is_holiday(today):
        return jsonify({"present": 0, "absent": 0, "late": 0, "total": 0, "absent_list": [], "present_list": [], "is_holiday": True})
    settings = load_settings()
    start_time = settings.get("start_time", "08:00")
    conn = get_db_connection()
    cursor = conn.cursor()
    cursor.execute("SELECT COUNT(DISTINCT a.UserId) FROM Attendance a JOIN Users u ON a.UserId = u.Id WHERE a.AttendanceDate = ? AND u.Role = N'طالب'", (today,))
    present_count = cursor.fetchone()[0]
    cursor.execute("SELECT COUNT(*) FROM Users WHERE Role = N'طالب' AND IsActive = 1")
    total_students = cursor.fetchone()[0]
    absent_count = total_students - present_count
    cursor.execute("SELECT COUNT(DISTINCT a.UserId) FROM Attendance a JOIN Users u ON a.UserId = u.Id WHERE a.AttendanceDate = ? AND u.Role = N'طالب' AND a.CheckInTime > ?", (today, start_time))
    late_count = cursor.fetchone()[0]
    cursor.execute("""
        SELECT u.Name, u.Class, u.ProfileImage
        FROM Users u
        WHERE u.Role = N'طالب' AND u.IsActive = 1
          AND u.Id NOT IN (SELECT DISTINCT UserId FROM Attendance WHERE AttendanceDate = ?)
          AND u.Id NOT IN (SELECT UserId FROM IndividualHolidays WHERE HolidayDate = ?)
    """, (today, today))
    absent_list = [{"name": r.Name, "class": r.Class or "-", "profile_image": r.ProfileImage or ""} for r in cursor.fetchall()]

    cursor.execute("""
        SELECT u.Name, u.Class, u.ProfileImage, MIN(a.CheckInTime) as FirstCheckIn
        FROM Users u
        JOIN Attendance a ON u.Id = a.UserId
        WHERE a.AttendanceDate = ? AND u.Role = N'طالب'
        GROUP BY u.Name, u.Class, u.ProfileImage
    """, (today,))
    present_list = [{"name": r.Name, "class": r.Class or "-", "time": str(r.FirstCheckIn), "profile_image": r.ProfileImage or ""} for r in cursor.fetchall()]
    conn.close()
    return jsonify({"present": present_count, "absent": absent_count, "late": late_count, "total": total_students, "absent_list": absent_list, "present_list": present_list, "is_holiday": False})


@app.route('/api/reports/send-bulk', methods=['POST'])
def api_reports_send_bulk():
    if session.get('role') not in ['مدير', 'مشرف']:
        return jsonify({"success": False, "message": "غير مصرح"}), 401
    data = request.get_json()
    start_date = data.get('start_date')
    end_date = data.get('end_date')
    role_filter = data.get('role_filter', 'all')
    if not start_date or not end_date:
        return jsonify({"success": False, "message": "يرجى تحديد تاريخ البداية والنهاية."}), 400
    try:
        datetime.strptime(start_date, "%Y-%m-%d")
        datetime.strptime(end_date, "%Y-%m-%d")
    except ValueError:
        return jsonify({"success": False, "message": "تنسيق التاريخ غير صحيح."}), 400
    conn = get_db_connection()
    cursor = conn.cursor()
    if role_filter == 'all':
        cursor.execute("SELECT Id, Name, Email, ParentEmail, Role FROM Users WHERE IsActive = 1")
    else:
        cursor.execute("SELECT Id, Name, Email, ParentEmail, Role FROM Users WHERE Role = ? AND IsActive = 1", (role_filter,))
    users = cursor.fetchall()
    conn.close()
    sent_count = 0
    errors = []
    for user in users:
        user_id, name, email, parent_email, role = user
        target_email = parent_email if role == 'طالب' else email
        if not target_email:
            errors.append(f"{name} ليس لديه بريد إلكتروني.")
            continue
        conn = get_db_connection()
        cursor = conn.cursor()
        cursor.execute("SELECT AttendanceDate, CheckInTime, CheckOutTime, Status, ExcuseReason FROM Attendance WHERE UserId = ? AND AttendanceDate BETWEEN ? AND ? ORDER BY AttendanceDate", (user_id, start_date, end_date))
        rows = cursor.fetchall()
        conn.close()
        pdf_path = generate_custom_report(name, role, rows, start_date, end_date)
        if pdf_path:
            subject = f"تقرير الحضور للفترة من {start_date} إلى {end_date}"
            body = f"السيد/ة {name}،\n\nمرفق تقرير الحضور.\n\nنظام الحضور الذكي"
            if send_email(target_email, subject, body, pdf_path):
                sent_count += 1
                try:
                    os.remove(pdf_path)
                except Exception:
                    pass
            else:
                errors.append(f"فشل إرسال بريد إلى {target_email}")
        else:
            errors.append(f"فشل إنشاء تقرير لـ {name}")
    return jsonify({"success": True, "message": f"✅ تم إرسال {sent_count} تقرير من أصل {len(users)} مستخدم.", "errors": errors[:5]})


@app.route('/api/stats')
def api_stats():
    if session.get('role') not in ['مدير', 'مشرف']:
        return jsonify({"error": "غير مصرح"}), 401
    conn = get_db_connection()
    cursor = conn.cursor()
    cursor.execute("SELECT Role, COUNT(*) as cnt FROM Users WHERE IsActive = 1 GROUP BY Role")
    stats = {'managers': 0, 'supervisors': 0, 'teachers': 0, 'students': 0}
    for r in cursor.fetchall():
        if r.Role == 'مدير': stats['managers'] = r.cnt
        elif r.Role == 'مشرف': stats['supervisors'] = r.cnt
        elif r.Role == 'معلم': stats['teachers'] = r.cnt
        elif r.Role == 'طالب': stats['students'] = r.cnt
    cursor.execute("SELECT COUNT(DISTINCT ParentEmail) FROM Users WHERE Role = N'طالب' AND IsActive = 1 AND ParentEmail IS NOT NULL")
    stats['parents'] = cursor.fetchone()[0] or 0
    cursor.execute("SELECT COUNT(*) FROM Users WHERE IsActive = 0")
    stats['inactive'] = cursor.fetchone()[0]
    conn.close()
    return jsonify(stats)


@app.route('/api/settings', methods=['GET', 'POST'])
def api_settings():
    if session.get('role') not in ['مدير', 'مشرف']:
        return jsonify({"error": "غير مصرح"}), 401
    if request.method == 'GET':
        return jsonify(load_settings())
    data = request.get_json()
    old_settings = load_settings()
    settings = {
        "start_time": data.get('start_time', '08:00'),
        "absence_time": data.get('absence_time', '08:30'),
        "end_time": data.get('end_time', '12:00'),
        "academic_year_start": data.get('academic_year_start', ''),
        "academic_year_end": data.get('academic_year_end', ''),
        "weekly_holidays": data.get('weekly_holidays', []),
        "annual_holidays": data.get('annual_holidays', []),
        "student_threshold": data.get('student_threshold', 20),
        "teacher_threshold": data.get('teacher_threshold', 15),
        "admin_email": data.get('admin_email', EMAIL_SENDER),
        "admin_telegram_chat_id": data.get('admin_telegram_chat_id', None),
        "rtsp_url": data.get('rtsp_url', ''),
        "is_24h_mode": data.get('is_24h_mode', False),
        "guard_email": data.get('guard_email', ''),
        "guard_telegram_chat_id": data.get('guard_telegram_chat_id', '')
    }
    save_settings(settings)
    old_weekly = old_settings.get('weekly_holidays', [])
    new_weekly = settings.get('weekly_holidays', [])
    if set(old_weekly) != set(new_weekly):
        send_holiday_notification({'days': new_weekly}, is_weekly=True)
    return jsonify({"success": True, "message": "تم حفظ الإعدادات."})


@app.route('/api/reports/send-single', methods=['POST'])
def api_reports_send_single():
    if session.get('role') not in ['مدير', 'مشرف']:
        return jsonify({"error": "غير مصرح"}), 401
    data = request.get_json()
    user_id = data.get('user_id')
    month = data.get('month')
    year = data.get('year')
    if not user_id:
        return jsonify({"success": False, "message": "معرف المستخدم مطلوب"}), 400
    try:
        if month is not None: month = int(month)
        if year is not None: year = int(year)
    except ValueError:
        return jsonify({"success": False, "message": "الشهر والسنة يجب أن يكونا أرقاماً"}), 400
    today = datetime.now()
    if month is None or year is None:
        first_of_month = today.replace(day=1)
        last_month = first_of_month - timedelta(days=1)
        month = last_month.month
        year = last_month.year
    conn = get_db_connection()
    cursor = conn.cursor()
    cursor.execute("SELECT Name, Role, Email, ParentEmail FROM Users WHERE Id = ? AND IsActive = 1", (user_id,))
    user = cursor.fetchone()
    conn.close()
    if not user:
        return jsonify({"success": False, "message": "المستخدم غير موجود"}), 404
    recipient_email = user.ParentEmail if user.Role == 'طالب' else user.Email
    if not recipient_email:
        return jsonify({"success": False, "message": "لا يوجد بريد إلكتروني"}), 400
    month_str = f"{year}-{str(month).zfill(2)}"
    conn = get_db_connection()
    cursor = conn.cursor()
    cursor.execute("SELECT AttendanceDate, CheckInTime, CheckOutTime, Status, ExcuseReason FROM Attendance WHERE UserId = ? AND AttendanceDate LIKE ? ORDER BY AttendanceDate", (user_id, f"{month_str}%"))
    rows = cursor.fetchall()
    conn.close()
    start_date = f"{year}-{str(month).zfill(2)}-01"
    if month == 12:
        end_date = f"{year}-12-31"
    else:
        next_month = month + 1
        next_year = year
        if next_month > 12:
            next_month = 1
            next_year = year + 1
        end_date = (datetime(next_year, next_month, 1) - timedelta(days=1)).strftime("%Y-%m-%d")
    pdf_path = generate_custom_report(user.Name, user.Role, rows, start_date, end_date)
    if not pdf_path:
        return jsonify({"success": False, "message": "لا توجد سجلات حضور."}), 400
    month_name = ['يناير', 'فبراير', 'مارس', 'أبريل', 'مايو', 'يونيو', 'يوليو', 'أغسطس', 'سبتمبر', 'أكتوبر', 'نوفمبر', 'ديسمبر'][month - 1]
    subject = f"تقرير الحضور الشهري - {month_name} {year}"
    body = f"السيد/ة {user.Name}،\n\nمرفق التقرير لشهر {month_name} {year}.\n\nنظام الحضور الذكي"
    if send_email(recipient_email, subject, body, pdf_path):
        try:
            os.remove(pdf_path)
        except Exception:
            pass
        return jsonify({"success": True, "message": f"✅ تم الإرسال إلى {recipient_email}."})
    else:
        return jsonify({"success": False, "message": "❌ فشل الإرسال."}), 500


