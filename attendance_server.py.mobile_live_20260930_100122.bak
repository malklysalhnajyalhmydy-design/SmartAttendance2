@app.route('/api/exams/violations/<int:vid>', methods=['DELETE'])
def api_exam_violation_delete(vid):
    if session.get('role') != 'مدير': return jsonify({"error": "غير مصرح"}), 401
    conn = get_db_connection(); cursor = conn.cursor()
    cursor.execute("SELECT ImagePath FROM ExamViolations WHERE Id=?", (vid,))
    r = cursor.fetchone()
    if r and r.ImagePath and os.path.exists(r.ImagePath):
        try: os.remove(r.ImagePath)
        except Exception: pass
    cursor.execute("SELECT VideoPath FROM ExamViolationVideos WHERE ViolationId=?", (vid,))
    for rv in cursor.fetchall():
        if rv.VideoPath and os.path.exists(rv.VideoPath):
            try: os.remove(rv.VideoPath)
            except Exception: pass
    cursor.execute("DELETE FROM ExamViolationVideos WHERE ViolationId=?", (vid,))
    cursor.execute("DELETE FROM ExamViolations WHERE Id=?", (vid,))
    conn.commit(); conn.close()
    return jsonify({"success": True, "message": "✅ تم الحذف"})


@app.route('/api/exams/<int:sid>/export')
def api_exam_export(sid):
    if session.get('role') not in ['مدير', 'مشرف']: return jsonify({"error": "غير مصرح"}), 401
    conn = get_db_connection(); cursor = conn.cursor()
    cursor.execute("SELECT ExamName FROM ExamSessions WHERE Id=?", (sid,))
    r = cursor.fetchone(); exam_name = r.ExamName if r else f'session_{sid}'
    cursor.execute("""SELECT CreatedAt, ViolationType, Severity, Description, ClassroomName, ReviewStatus
                      FROM ExamViolations WHERE SessionId=? ORDER BY CreatedAt""", (sid,))
    rows = cursor.fetchall(); conn.close()
    wb = openpyxl.Workbook(); ws = wb.active; ws.title = "المخالفات"
    ws.append(['التاريخ', 'النوع', 'الخطورة', 'الوصف', 'الفصل', 'الحالة'])
    type_ar = {'looking_around':'التفات','looking_down':'نظر للأسفل','passing_papers':'تمرير أوراق','phone':'جوال','approaching':'اقتراب'}
    sev_ar = {'low':'منخفضة','medium':'متوسطة','high':'عالية','critical':'حرجة'}
    for r in rows:
        ws.append([str(r.CreatedAt), type_ar.get(r.ViolationType, r.ViolationType),
                   sev_ar.get(r.Severity, r.Severity), r.Description, r.ClassroomName, r.ReviewStatus])
    fn = f"exam_{exam_name}_{datetime.now().strftime('%Y%m%d%H%M%S')}.xlsx"
    fp = os.path.join('exports', fn)
    os.makedirs('exports', exist_ok=True); wb.save(fp)
    return send_file(fp, as_attachment=True, download_name=fn)

# ======================== 🚀 تشغيل الخادم ========================


# ═══════════════════════════════════════════════════════════════
# 💬 [Private Messages] هجرة قاعدة البيانات
# ═══════════════════════════════════════════════════════════════
try:
    _pm_conn = get_db_connection()
    _pm_cursor = _pm_conn.cursor()

    # إضافة أعمدة إلى جدول Messages
    for _col, _type in [
        ("RecipientUserId", "INT NULL"),
        ("MessageType", "NVARCHAR(20) DEFAULT 'thread'"),
        ("ReadAt", "DATETIME NULL"),
    ]:
        _pm_cursor.execute(f"""
            IF NOT EXISTS (SELECT * FROM sys.columns
                           WHERE name='{_col}' AND object_id=OBJECT_ID('Messages'))
            ALTER TABLE Messages ADD {_col} {_type}
        """)

    # فهرس للصادرة
    _pm_cursor.execute("""
        IF NOT EXISTS (SELECT * FROM sys.indexes WHERE name='IX_Messages_Outbox')
        CREATE INDEX IX_Messages_Outbox ON Messages(IsFromAdmin, CreatedAt DESC)
    """)

    _pm_conn.commit()
    _pm_conn.close()
    print("✅ [Private Messages] تم تحديث قاعدة البيانات", flush=True)
except Exception as _pm_err:
    print(f"⚠️ [Private Messages] فشل الهجرة: {_pm_err}", flush=True)



