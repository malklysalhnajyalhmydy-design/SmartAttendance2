@app.route('/api/users/<int:uid>/delete', methods=['POST'])
def api_delete_user(uid):
    if session.get('role') not in ['مدير', 'مشرف']:
        return jsonify({"error": "غير مصرح"}), 401
    try:
        conn = get_db_connection()
        cursor = conn.cursor()
        cursor.execute("DELETE FROM Attendance WHERE UserId = ?", (uid,))
        cursor.execute("DELETE FROM IndividualHolidays WHERE UserId = ?", (uid,))
        cursor.execute("DELETE FROM Notifications WHERE UserId = ?", (uid,))
        cursor.execute("DELETE FROM LoginAttempts WHERE UserId = ?", (uid,))
        cursor.execute("DELETE FROM PasswordResetTokens WHERE UserId = ?", (uid,))
        cursor.execute("DELETE FROM Users WHERE Id = ?", (uid,))
        conn.commit()
        conn.close()
        import shutil
        folder_path = f"uploads/faces/user_{uid}"
        if os.path.exists(folder_path):
            shutil.rmtree(folder_path)
