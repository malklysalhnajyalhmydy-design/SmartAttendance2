@app.before_request
def log_request():
    """يطبع كل طلب يصل للسيرفر"""
    if request.path.startswith('/static/'):
        return  # تجاهل الملفات الثابتة
    print(f"\n📨 [{datetime.now().strftime('%H:%M:%S')}] {request.method} {request.path}", flush=True)
    if request.method == 'POST':
        try:
            data = request.get_json(silent=True)
            if data and not request.path.startswith('/api/exams/sessions'):
                print(f"   📦 البيانات: {str(data)[:200]}", flush=True)
        except Exception:
            pass


@app.after_request
def log_response(response):
    """يطبع حالة كل رد"""
    if request.path.startswith('/static/'):
        return response
    status_icon = "✅" if response.status_code < 400 else "❌"
    print(f"{status_icon} [{response.status_code}] {request.method} {request.path}", flush=True)
    return response
