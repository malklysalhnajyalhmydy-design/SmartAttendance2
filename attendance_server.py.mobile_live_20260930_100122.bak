# ======================== 📤 مسارات الإرسال لولي الأمر + حالة المراجعة + الفيديو ========================

@app.route('/api/alerts/<int:alert_id>/review-status', methods=['POST'])
def api_update_review_status(alert_id):
    """تحديث حالة مراجعة الإنذار"""
    if session.get('role') not in ['مدير', 'مشرف']:
        return jsonify({"error": "غير مصرح"}), 401
    try:
        data = request.get_json()
        new_status = data.get('status', 'pending')
        notes = (data.get('notes') or '').strip() or None

        if new_status not in ['pending', 'handled', 'unresolved']:
            return jsonify({"success": False, "message": "حالة غير صحيحة"}), 400

        conn = get_db_connection()
        cursor = conn.cursor()
        cursor.execute("""
            UPDATE Alerts
            SET ReviewStatus = ?,
                ReviewNotes = ?,
                ReviewedByUserId = ?,
                ReviewedByName = ?,
                ReviewedAt = GETDATE()
            WHERE Id = ?
        """, (new_status, notes, session.get('user_id'), session.get('role', '—'), alert_id))
        conn.commit()
        conn.close()
        return jsonify({"success": True, "message": "✅ تم تحديث حالة المراجعة"})
    except Exception as e:
        print(f"❌ خطأ في تحديث الحالة: {e}", flush=True)
        traceback.print_exc()
        return jsonify({"success": False, "message": str(e)}), 500


@app.route('/api/alerts/review-stats')
def api_review_stats():
    """إحصائيات حالات المراجعة"""
    if session.get('role') not in ['مدير', 'مشرف']:
        return jsonify({"error": "غير مصرح"}), 401
    try:
        conn = get_db_connection()
        cursor = conn.cursor()
        cursor.execute("""
            SELECT
                SUM(CASE WHEN ReviewStatus = 'pending' OR ReviewStatus IS NULL THEN 1 ELSE 0 END) as pending_count,
                SUM(CASE WHEN ReviewStatus = 'handled' THEN 1 ELSE 0 END) as handled_count,
                SUM(CASE WHEN ReviewStatus = 'unresolved' THEN 1 ELSE 0 END) as unresolved_count,
                COUNT(*) as total
            FROM Alerts
        """)
        row = cursor.fetchone()
        conn.close()
        return jsonify({
            'pending': row.pending_count or 0,
            'handled': row.handled_count or 0,
            'unresolved': row.unresolved_count or 0,
            'total': row.total or 0
        })
    except Exception as e:
        return jsonify({"error": str(e)}), 500


