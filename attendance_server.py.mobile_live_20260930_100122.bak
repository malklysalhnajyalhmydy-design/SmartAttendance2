    return send_telegram(chat_id, msg)


# ======================== دوال الكشف والتعرف على الوجه ========================
def load_users_cache():
    """تحميل بصمات المستخدمين إلى الذاكرة"""
    global users_cache
    with users_cache_lock:
        try:
            conn = get_db_connection()
            cursor = conn.cursor()
            cursor.execute("""
                SELECT Id, Name, FaceEncoding, Role, TelegramChatID
                FROM Users
                WHERE IsActive = 1
                  AND FaceEncoding IS NOT NULL
                  AND FaceEncoding != '[]'
                  AND FaceEncoding != 'null'
            """)
            rows = cursor.fetchall()
            conn.close()
        except Exception as e:
            print(f"⚠️ فشل تحميل المستخدمين: {e}", flush=True)
            return

        new_cache = []
        all_embeddings_list = []
        user_indices = []

        for row in rows:
            try:
                enc_data = json.loads(row.FaceEncoding)
                if isinstance(enc_data, list) and len(enc_data) > 0:
                    if isinstance(enc_data[0], list):
                        embeddings = [np.array(emb) for emb in enc_data]
                    else:
                        embeddings = [np.array(enc_data)]
                    for emb in embeddings:
                        all_embeddings_list.append(emb)
                        user_indices.append(row.Id)
                    new_cache.append({
                        'id': row.Id, 'name': row.Name, 'role': row.Role,
                        'embeddings': embeddings, 'telegram_chat_id': row.TelegramChatID
                    })
            except Exception as e:
                print(f"⚠️ خطأ في تحميل بصمة {row.Name}: {e}", flush=True)

        if all_embeddings_list:
            users_cache = new_cache
            app.config['EMBEDDINGS_MATRIX'] = np.array(all_embeddings_list)
            app.config['EMBEDDINGS_USER_IDS'] = np.array(user_indices)
            print(f"✅ تم تحميل {len(new_cache)} مستخدم ({len(all_embeddings_list)} بصمة).", flush=True)
        else:
            users_cache = []
            app.config['EMBEDDINGS_MATRIX'] = np.array([])
            app.config['EMBEDDINGS_USER_IDS'] = np.array([])
            print("⚠️ لا توجد بصمات محملة.", flush=True)


def detect_and_extract_faces(image_rgb):
    """استخراج الوجوه والبصمات (image_rgb هي RGB صحيحة)"""
    image_bgr = cv2.cvtColor(image_rgb, cv2.COLOR_RGB2BGR)
    faces = face_app.get(image_bgr)
    if not faces:
        return [], []
    h, w = image_rgb.shape[:2]
    locations, embeddings = [], []
    for face in faces:
        bbox = face.bbox.astype(int)
        left, top, right, bottom = bbox[0], bbox[1], bbox[2], bbox[3]
        top, left = max(0, top), max(0, left)
        bottom, right = min(h, bottom), min(w, right)
        locations.append((top, right, bottom, left))
        embeddings.append(face.normed_embedding)
    return locations, embeddings


def find_best_match_vectorized(target_embedding):
    """البحث عن أفضل تطابق — نسخة مُصلَحة تقبل pyodbc"""
    matrix = app.config.get('EMBEDDINGS_MATRIX')
    user_ids = app.config.get('EMBEDDINGS_USER_IDS')
    if matrix is None or len(matrix) == 0:
        return None, None, 1.0
    distances = np.linalg.norm(matrix - target_embedding, axis=1)
    min_idx = np.argmin(distances)
    min_dist = float(distances[min_idx])
    if min_dist < FACE_THRESHOLD:
        user_id = int(user_ids[min_idx])
        for user in users_cache:
            if user['id'] == user_id:
                return user_id, user['name'], min_dist
    return None, None, min_dist


def recognize_faces_in_image(image_np):
    """التعرف على الوجوه — نسخة مُصلَحة (RGB صحيح)"""
    global users_cache
    if len(users_cache) == 0:
        return [], [], "لا يوجد مستخدمين مسجلين"

    if len(image_np.shape) == 2:
        rgb = cv2.cvtColor(image_np, cv2.COLOR_GRAY2RGB)
    elif image_np.shape[2] == 4:
        rgb = cv2.cvtColor(image_np, cv2.COLOR_RGBA2RGB)
    else:
        rgb = image_np.copy()

    # ✅ ملاحظة: تم إزالة CLAHE لضمان توافق المعالجة مع التسجيل
    # (التسجيل يستخدم الصورة الأصلية، فلا يجب أن نغير التعرف)
    image_bgr = cv2.cvtColor(rgb, cv2.COLOR_RGB2BGR)
    faces = face_app.get(image_bgr)

    # ✅ محاولة ثانية بـ CLAHE إن لم نجد وجوهاً
    if not faces:
        try:
            lab = cv2.cvtColor(rgb, cv2.COLOR_RGB2LAB)
            l, a, b = cv2.split(lab)
            clahe = cv2.createCLAHE(clipLimit=2.0, tileGridSize=(8, 8))
            l = clahe.apply(l)
            lab = cv2.merge((l, a, b))
            rgb_enhanced = cv2.cvtColor(lab, cv2.COLOR_LAB2RGB)
            image_bgr_enhanced = cv2.cvtColor(rgb_enhanced, cv2.COLOR_RGB2BGR)
            faces = face_app.get(image_bgr_enhanced)
        except Exception as e:
            print(f"⚠️ فشل CLAHE fallback: {e}", flush=True)

    if not faces:
        return [], [], "لم يتم اكتشاف أي وجه"
    h, w = rgb.shape[:2]
    locations, names = [], []
    for face in faces:
        bbox = face.bbox.astype(int)
        left, top, right, bottom = bbox[0], bbox[1], bbox[2], bbox[3]
        top, left = max(0, top), max(0, left)
        bottom, right = min(h, bottom), min(w, right)
        locations.append((top, right, bottom, left))
        emb = face.normed_embedding

        user_id, name, dist = find_best_match_vectorized(emb)

        found_in_cache = False
        if user_id is not None:
            with recent_lock:
                if user_id in recent_faces:
                    if time.time() - recent_faces[user_id] < RECENT_TIMEOUT:
                        found_in_cache = True
                        recent_faces[user_id] = time.time()

        if found_in_cache:
            names.append(name)
            continue

        if user_id is not None:
            names.append(name)
            with recent_lock:
                recent_faces[user_id] = time.time()
            user_role = None
            for u in users_cache:
                if u['id'] == user_id:
                    user_role = u['role']
                    break
            if user_role == 'حارس':
                if is_guard_mode():
                    mark_attendance(user_id, name)
                continue
            if is_guard_mode():
                send_guard_notification(name, user_role, user_id, True)
            else:
                with today_notifications_lock:
                    if user_id not in today_notifications:
                        mark_attendance(user_id, name)
                        today_notifications.add(user_id)
                        save_notification_cache()
                    else:
                        mark_attendance(int(user_id), name)
        else:
            names.append("غير معروف")
            if is_guard_mode():
                send_guard_notification(None, None, None, False)
    if 'dist' in locals():
        status = "✅ تم التعرف" if dist < FACE_THRESHOLD else "❌ غير معروف"
        print(f"🔍 {status} | مسافة: {dist:.4f} | عتبة: {FACE_THRESHOLD}", flush=True)
        if dist < FACE_THRESHOLD + 0.15 and dist >= FACE_THRESHOLD:
            print(f"   💡 قريب جداً! جرّب رفع العتبة إلى {dist + 0.05:.2f}", flush=True)
    else:
        print("🔍 لم يتم العثور على وجه", flush=True)
    return names, locations, None


# ======================== دوال الحضور والإشعارات ========================

# ======================== دوال الحضور والإشعارات ========================
def mark_attendance(user_id, name):
    """
    تسجيل الحضور لمستخدم.
    ✅ التعديلات:
      - تجاهل تسجيل الحضور للمعلم في أيام عدم دوامه
      - تجاهل تسجيل الحضور في العطل الرسمية/الأسبوعية/الفردية
    """
    user_id = int(user_id)
    now = datetime.now()
    today = now.strftime("%Y-%m-%d")
    current_time = now.strftime("%H:%M:%S")
    date_str = now.strftime("%Y-%m-%d")
    time_str = now.strftime("%I:%M %p")

    # ==================== 1. فحص وقت الحضور ====================
    if not is_within_attendance_time():
        print(f"⏰ {name} - خارج وقت الحضور (الآن {current_time})", flush=True)
        return

    # ==================== 2. فحص وقت الغياب ====================
    settings = load_settings()
    absence_time_str = settings.get("absence_time", "08:30")
    status = 'حاضر'  # ✅ القيمة الافتراضية
    try:
        absence_time = datetime.strptime(absence_time_str, "%H:%M").time()
        current_time_obj = datetime.strptime(current_time, "%H:%M:%S").time()
        if current_time_obj > absence_time:
            status = 'متأخر'  # ✅ علّم كمتأخر بدل ما ترفض
            print(f"⏰ {name} - متأخر ({current_time} > {absence_time_str})", flush=True)
    except Exception as e:
        print(f"⚠️ خطأ في تحليل وقت الغياب: {e}", flush=True)

    # ==================== 3. 🆕 فحص أيام دوام المعلم ====================
    # إذا كان المستخدم معلماً ولا يعمل اليوم → لا تسجّل حضوره ولا غيابه
    user_role_of_current = None
    for u in users_cache:
        if u['id'] == user_id:
            user_role_of_current = u.get('role')
            break

    if user_role_of_current == 'معلم':
        if not is_teacher_working_day(user_id, today):
            print(f"📅 {name} (معلم) - ليس يوم دوامه (اليوم: {today})", flush=True)
            return

    # ==================== 4. فحص العطلة ====================
    if is_holiday(today, user_id):
        print(f"📅 {name} - يوم عطلة", flush=True)
        return

    # ==================== 5. فحص آخر تسجيل (منع التكرار < 30 دقيقة) ====================
    conn = get_db_connection()
    cursor = conn.cursor()

    cursor.execute("""
        SELECT MAX(CheckInTime) FROM Attendance
        WHERE UserId = ? AND AttendanceDate = ?
    """, (user_id, today))
    last_checkin_str = cursor.fetchone()[0]

    if last_checkin_str:
        try:
            last_dt = datetime.strptime(str(last_checkin_str), "%H:%M:%S")
            current_dt = datetime.strptime(current_time, "%H:%M:%S")
            diff_min = (current_dt - last_dt).total_seconds() / 60
            if diff_min < 30:
                conn.close()
                print(f"⏳ {name} - تم التسجيل قبل {int(diff_min)} دقيقة", flush=True)
                return
        except Exception as e:
            print(f"⚠️ خطأ في تحليل وقت آخر تسجيل: {e}", flush=True)

    # ==================== 6. هل هذا أول تسجيل اليوم؟ ====================
    cursor.execute("""
        SELECT COUNT(*) FROM Attendance
        WHERE UserId = ? AND AttendanceDate = ?
    """, (user_id, today))
    is_first_today = cursor.fetchone()[0] == 0

    # ==================== 7. جلب chat_id للإشعار ====================
    chat_id = None
    if is_first_today:
        for u in users_cache:
            if u['id'] == user_id:
                chat_id = u.get('telegram_chat_id')
                break
        if not chat_id:
            cursor.execute("SELECT TelegramChatID FROM Users WHERE Id = ?", (user_id,))
            row = cursor.fetchone()
            chat_id = row.TelegramChatID if row else None

    conn.close()

    # ==================== 8. إضافة إلى طابعة الحضور ====================
    attendance_queue.put((user_id, name, today, current_time))
    print(f"📥 تم إضافة {name} إلى طابعة الحضور.", flush=True)

    # ==================== 9. إرسال إشعار الترحيب (فقط أول مرة) ====================
    if is_first_today and not has_notification_been_sent(user_id, 'attendance', today):
        if chat_id:
            # تحديد الدور
            role = ''
            for u in users_cache:
                if u['id'] == user_id:
                    role = u.get('role', '')
                    break

            # تخصيص نص الرسالة حسب الدور
            if role == 'طالب':
                msg = (
                    f"✅ <b>تأكيد الحضور</b>\n\n"
                    f"👤 الطالب: {name}\n"
                    f"📅 التاريخ: {date_str}\n"
                    f"⏰ الوقت: {time_str}"
                )
            elif role == 'معلم':
                msg = (
                    f"✅ <b>تأكيد الحضور</b>\n\n"
                    f"👨‍🏫 المعلم: {name}\n"
                    f"📅 التاريخ: {date_str}\n"
                    f"⏰ الوقت: {time_str}"
                )
            elif role == 'مشرف':
                msg = (
                    f"✅ <b>تأكيد الحضور</b>\n\n"
                    f"🛡️ المشرف: {name}\n"
                    f"📅 التاريخ: {date_str}\n"
                    f"⏰ الوقت: {time_str}"
                )
            elif role == 'حارس':
                msg = (
                    f"✅ <b>تأكيد الحضور</b>\n\n"
                    f"🔒 الحارس: {name}\n"
                    f"📅 التاريخ: {date_str}\n"
                    f"⏰ الوقت: {time_str}"
                )
            else:
                msg = (
                    f"✅ <b>تأكيد الحضور</b>\n\n"
                    f"👤 {name}\n"
                    f"📅 {date_str}\n"
                    f"⏰ {time_str}"
                )

            send_telegram(chat_id, msg)
            mark_notification_sent(user_id, 'attendance')


def get_last_attendance(user_id, today_date):
    conn = get_db_connection()
    cursor = conn.cursor()
    cursor.execute(
        "SELECT TOP 1 CheckInTime FROM Attendance WHERE UserId = ? AND AttendanceDate = ? ORDER BY CheckInTime DESC",
        (user_id, today_date)
    )
    row = cursor.fetchone()
    conn.close()
    if row and row[0]:
        return {'time': str(row[0])}
    return None


def has_notification_been_sent(user_id, notif_type, today_date):
    conn = get_db_connection()
    cursor = conn.cursor()
    cursor.execute("SELECT COUNT(*) FROM Notifications WHERE UserId = ? AND NotificationType = ? AND SentDate = ?", (user_id, notif_type, today_date))
    count = cursor.fetchone()[0]
    conn.close()
    return count > 0


def mark_notification_sent(user_id, notif_type):
    conn = get_db_connection()
    cursor = conn.cursor()
    cursor.execute("INSERT INTO Notifications (UserId, NotificationType, SentDate, SentTime) VALUES (?, ?, ?, ?)",
                   (user_id, notif_type, datetime.now().strftime("%Y-%m-%d"), datetime.now().strftime("%H:%M:%S")))
    conn.commit()
    conn.close()


def get_guard_notification_limit(is_known):
    return 5 if is_known else 10


def can_send_guard_notification(user_id, is_known):
    if not user_id:
        user_id = f"unknown_{datetime.now().strftime('%Y-%m-%d')}"
    cache_key = f"guard_{user_id}_{datetime.now().strftime('%Y-%m-%d')}"
    with guard_counter_lock:
        now = datetime.now()
        record = guard_notification_counter.get(cache_key)
        if not record:
            guard_notification_counter[cache_key] = {'count': 1, 'last_sent': now, 'max_limit': get_guard_notification_limit(is_known)}
            return True
        if record['count'] >= record['max_limit']:
            print(f"⏳ تم الوصول للحد الأقصى ({record['max_limit']}) لإشعارات {user_id}.", flush=True)
            return False
        time_diff = (now - record['last_sent']).total_seconds() / 60
        if time_diff < 10:
            print(f"⏳ انتظر {int(10 - time_diff)} دقيقة قبل الإشعار التالي.", flush=True)
            return False
        record['count'] += 1
        record['last_sent'] = now
        return True


def reset_guard_notification_counters():
    with guard_counter_lock:
        guard_notification_counter.clear()
    print("🔄 تم إعادة تعيين عدادات إشعارات الحراسة.", flush=True)


def send_guard_notification(user_name, user_role, user_id, is_known):
    if not can_send_guard_notification(user_id, is_known):
        return
    now = datetime.now()
    time_str = now.strftime("%I:%M %p")
    date_str = now.strftime("%Y-%m-%d")
    if is_known:
        message = (
            f"🚨 <b>تنبيه دخول في غير أوقات الدوام</b> 🚨\n\n"
            f"📅 التاريخ: {date_str}\n⏰ الساعة: {time_str}\n\n"
            f"👤 <b>الاسم:</b> {user_name}\n📌 <b>الدور:</b> {user_role}\n\n"
            f"⚠️ تم تسجيل دخول هذا الشخص في <b>وقت الحراسة</b>."
        )
        email_subject = f"🚨 تنبيه دخول غير مصرح به - {user_name}"
        email_body = f"تنبيه دخول\n\nالتاريخ: {date_str}\nالوقت: {time_str}\n\nالاسم: {user_name}\nالدور: {user_role}"
    else:
        message = (
            f"🚨🚨 <b>إنذار أمني عاجل</b> 🚨🚨\n\n"
            f"📅 التاريخ: {date_str}\n⏰ الساعة: {time_str}\n\n"
            f"👤 <b>شخص غير معروف</b>\n\n"
            f"⚠️ شخص مجهول في <b>وقت الحراسة</b>!"
        )
        email_subject = "🚨🚨 إنذار أمني عاجل - شخص غير معروف"
        email_body = f"إنذار أمني\n\nالتاريخ: {date_str}\nالوقت: {time_str}\n\nشخص غير معروف في وقت الحراسة!"
    settings = load_settings()
    admin_email = settings.get("admin_email", EMAIL_SENDER)
    admin_chat = settings.get("admin_telegram_chat_id")
    guard_chat = settings.get("guard_telegram_chat_id")
    if not guard_chat:
        try:
            conn = get_db_connection()
            cursor = conn.cursor()
            cursor.execute("SELECT TOP 1 TelegramChatID FROM Users WHERE Role = N'حارس' AND IsActive = 1")
            row = cursor.fetchone()
            conn.close()
            if row and row.TelegramChatID:
                guard_chat = row.TelegramChatID
        except Exception as e:
            print(f"⚠️ فشل جلب الحارس: {e}", flush=True)
    try:
        conn = get_db_connection()
        cursor = conn.cursor()
        cursor.execute("SELECT Email, TelegramChatID FROM Users WHERE Role = N'مشرف' AND IsActive = 1")
        supervisors = cursor.fetchall()
        conn.close()
    except Exception as e:
        print(f"⚠️ فشل جلب المشرفين: {e}", flush=True)
        supervisors = []
    if admin_chat:
        send_telegram(admin_chat, message)
    for sup in supervisors:
        if sup.TelegramChatID:
            send_telegram(sup.TelegramChatID, message)
    if guard_chat:
        send_telegram(guard_chat, message)
    if not is_known:
        guard_email = settings.get("guard_email", "")
        send_email(admin_email, email_subject, email_body)
        for sup in supervisors:
            if sup.Email:
                send_email(sup.Email, email_subject, email_body)
        if guard_email:
            send_email(guard_email, email_subject, email_body)
    print(f"📨 تم إرسال إشعارات الحراسة لـ {'شخص معروف' if is_known else 'شخص غير معروف'}", flush=True)


# ======================== دوال التقارير والتسرب ========================
def reshape_arabic(text):
    if not text:
        return ""
    reshaped = arabic_reshaper.reshape(str(text))
    return get_display(reshaped)


def get_dropout_alerts():
    settings = load_settings()
    st, tt = settings.get("student_threshold", 20), settings.get("teacher_threshold", 15)
    conn = get_db_connection()
    cursor = conn.cursor()

    # ✅ الطلاب
    cursor.execute("""
        SELECT u.Id, u.Name, u.Class, u.ParentEmail, u.ProfileImage,
               SUM(CASE WHEN a.Status = N'حاضر' THEN 1 ELSE 0 END) as PresentDays,
               COUNT(a.Id) as TotalDays
        FROM Users u
        LEFT JOIN Attendance a ON u.Id = a.UserId
        WHERE u.Role = N'طالب' AND u.IsActive = 1
        GROUP BY u.Id, u.Name, u.Class, u.ParentEmail, u.ProfileImage
    """)
    student_alerts, teacher_alerts = [], []
    for r in cursor.fetchall():
        total = r.TotalDays or 0
        present = r.PresentDays or 0
        absent = total - present
        rate = round((absent / total) * 100, 1) if total > 0 else 0
        if rate >= st:
            student_alerts.append({
                'id': r.Id,
                'name': r.Name,
                'class': r.Class or '-',
                'absent_days': absent,
                'total_days': total,
                'rate': rate,
                'email': r.ParentEmail,
                'profile_image': r.ProfileImage or ''  # ✅
            })

    # ✅ المعلمون
    cursor.execute("""
        SELECT u.Id, u.Name, u.Email, u.ProfileImage,
               SUM(CASE WHEN a.Status = N'حاضر' THEN 1 ELSE 0 END) as PresentDays,
               COUNT(a.Id) as TotalDays
        FROM Users u
        LEFT JOIN Attendance a ON u.Id = a.UserId
        WHERE u.Role = N'معلم' AND u.IsActive = 1
        GROUP BY u.Id, u.Name, u.Email, u.ProfileImage
    """)
    for r in cursor.fetchall():
        total = r.TotalDays or 0
        present = r.PresentDays or 0
        absent = total - present
        rate = round((absent / total) * 100, 1) if total > 0 else 0
        if rate >= tt:
            teacher_alerts.append({
                'id': r.Id,
                'name': r.Name,
                'absent_days': absent,
                'total_days': total,
                'rate': rate,
                'email': r.Email,
                'profile_image': r.ProfileImage or ''  # ✅
            })
    conn.close()
    return student_alerts, teacher_alerts


def get_all_users_by_role(roles):
    conn = get_db_connection()
    cursor = conn.cursor()
    placeholders = ','.join(['?'] * len(roles))
    query = f"SELECT Name, Email, TelegramChatID, Role FROM Users WHERE Role IN ({placeholders}) AND IsActive = 1"
    cursor.execute(query, roles)
    rows = cursor.fetchall()
    conn.close()
    return [{'name': r.Name, 'email': r.Email, 'chat_id': r.TelegramChatID, 'role': r.Role} for r in rows]


def get_all_parents():
    conn = get_db_connection()
    cursor = conn.cursor()
    cursor.execute("""
        SELECT DISTINCT ParentEmail, TelegramChatID FROM Users
        WHERE Role = N'طالب' AND IsActive = 1
          AND (ParentEmail IS NOT NULL OR TelegramChatID IS NOT NULL)
    """)
    rows = cursor.fetchall()
    conn.close()
    parents = []
    for row in rows:
        if row.ParentEmail or row.TelegramChatID:
            parents.append({'email': row.ParentEmail, 'chat_id': row.TelegramChatID})
    return parents


def send_holiday_notification(holiday_data, is_weekly=False):
    settings = load_settings()
    admin_email = settings.get('admin_email', EMAIL_SENDER)
    admin_chat = settings.get('admin_telegram_chat_id')
    if is_weekly:
        days_list = holiday_data.get('days', [])
        days_formatted = '، '.join(days_list)
        telegram_msg = (
            f"📅 <b>تحديث أيام الإجازة الأسبوعية</b>\n\n"
            f"☀️ تم تحديد أيام الراحة الأسبوعية على النحو التالي:\n"
            f"🕊️ <b>{days_formatted}</b>\n\n"
            f"✅ سيتم اعتبار هذه الأيام عطلًا رسمية، ولن يتم احتساب الغياب فيها.\n\n"
            f"✨ نتمنى للجميع أوقاتًا سعيدة ومريحة.\n\n🤖 نظام الحضور الذكي"
        )
        email_subject = "📅 تحديث أيام الإجازة الأسبوعية"
        email_body = (
            f"السادة أعضاء الهيئة التعليمية والإدارية،\nالسادة أولياء الأمور الكرام،\n\n"
            f"نود إعلامكم بأنه تم تحديد أيام الإجازة الأسبوعية على النحو التالي:\n\n"
            f"📌 الأيام: {days_formatted}\n\n"
            f"🔹 سيتم اعتبار هذه الأيام عطلًا رسمية، ولن يُحتسب الغياب فيها.\n"
            f"🔹 نتمنى لكم قضاء أوقات ممتعة.\n\nمع خالص التحية,\nنظام الحضور الذكي"
        )
    else:
        start = holiday_data.get('start_date', '')
        end = holiday_data.get('end_date', '')
        desc = holiday_data.get('description', '').strip()
        htype = holiday_data.get('type', 'عامة')
        if 'عيد' in desc or 'عيد' in htype:
            occasion = f"🎉 بمناسبة {desc or 'العيد السعيد'}"
        elif 'مناسبة' in desc or 'احتفال' in desc:
            occasion = f"🎊 بمناسبة {desc}"
        else:
            occasion = f"📌 عطلة رسمية ({desc or htype})"
        date_range = f"{start} إلى {end}" if end else start
        telegram_msg = (
            f"🌟 <b>إضافة عطلة جديدة</b> 🌟\n\n{occasion}\n\n"
            f"📅 <b>التاريخ:</b> {date_range}\n📌 <b>النوع:</b> {htype}\n\n"
            f"💫 نتمنى للجميع عطلة سعيدة.\n🤖 نظام الحضور الذكي"
        )
        email_subject = f"🌟 {occasion} - إشعار عطلة"
        email_body = (
            f"السادة أعضاء الهيئة التعليمية والإدارية،\nالسادة أولياء الأمور الكرام،\n\n"
            f"نود إعلامكم بأنه تقرر اعتماد ما يلي:\n\n{occasion}\n\n"
            f"📅 التاريخ: {date_range}\n📌 النوع: {htype}\n\n"
            f"مع جزيل الشكر والتقدير،\nإدارة المدرسة - نظام الحضور الذكي"
        )
    staff = get_all_users_by_role(['مشرف', 'معلم', 'حارس'])
    parents = get_all_parents()
    if admin_email:
        send_email(admin_email, email_subject, email_body)
    if admin_chat:
        send_telegram(admin_chat, telegram_msg)
    for user in staff:
        if user['email']:
            send_email(user['email'], email_subject, email_body)
        if user['chat_id']:
            send_telegram(user['chat_id'], telegram_msg)
    parent_count = 0
    for parent in parents:
        sent = False
        if parent['email']:
            send_email(parent['email'], email_subject, email_body)
            sent = True
        if parent['chat_id']:
            send_telegram(parent['chat_id'], telegram_msg)
            sent = True
        if sent:
            parent_count += 1
    total = len(staff) + parent_count + 1
    print(f"📨 تم إرسال إشعار الإجازة إلى {total} مستخدم.", flush=True)


def generate_random_code():
    while True:
        code = ''.join(random.choices(string.ascii_uppercase + string.digits, k=6))
        conn = get_db_connection()
        cursor = conn.cursor()
        cursor.execute("SELECT COUNT(*) FROM TelegramCodes WHERE Code = ?", (code,))
        if cursor.fetchone()[0] == 0:
            conn.close()
            return code
        conn.close()


def is_code_valid(code):
    conn = get_db_connection()
    cursor = conn.cursor()
    cursor.execute("SELECT CreatedAt FROM TelegramCodes WHERE Code = ?", (code,))
    row = cursor.fetchone()
    conn.close()
    if not row:
        return False
    created_at = row[0]
    if isinstance(created_at, str):
        try:
            created_at = datetime.strptime(created_at, "%Y-%m-%d %H:%M:%S.%f")
        except Exception:
            try:
                created_at = datetime.strptime(created_at, "%Y-%m-%d %H:%M:%S")
            except Exception:
                return False
    delta = datetime.now() - created_at
    return delta.total_seconds() < 600


def get_chat_id_from_code(code):
    if not is_code_valid(code):
        return None
    conn = get_db_connection()
    cursor = conn.cursor()
    cursor.execute("SELECT ChatId FROM TelegramCodes WHERE Code = ?", (code,))
    row = cursor.fetchone()
    conn.close()
    return row[0] if row and row[0] else None


def clean_expired_codes():
    try:
        conn = get_db_connection()
        cursor = conn.cursor()
        cursor.execute("DELETE FROM TelegramCodes WHERE DATEDIFF(MINUTE, CreatedAt, GETDATE()) > 10")
        conn.commit()
        conn.close()
        print("🧹 تم تنظيف الرموز.", flush=True)
    except Exception as e:
        print(f"⚠️ فشل تنظيف الرموز: {e}", flush=True)


def cleanup_old_videos(days=30):
    """حذف الفيديوهات الأقدم من X يوم (افتراضياً 30)"""
    try:
        cutoff = datetime.now() - timedelta(days=days)
        conn = get_db_connection()
        cursor = conn.cursor()

        # ابحث عن الفيديوهات القديمة
        cursor.execute("""
            SELECT Id, VideoPath FROM AlertVideos
            WHERE CreatedAt < ?
        """, (cutoff,))
        old_videos = cursor.fetchall()

        deleted_count = 0
        for v in old_videos:
            # احذف الملف
            if v.VideoPath and os.path.exists(v.VideoPath):
                try:
                    os.remove(v.VideoPath)
                except Exception:
                    pass
            # احذف السجل
            cursor.execute("DELETE FROM AlertVideos WHERE Id = ?", (v.Id,))
            # امسح مسار الفيديو من جدول Alerts
            cursor.execute("UPDATE Alerts SET VideoPath = NULL WHERE VideoPath = ?", (v.VideoPath,))
            deleted_count += 1

        conn.commit()
        conn.close()

        if deleted_count > 0:
            print(f"🧹 تم حذف {deleted_count} فيديو قديم (أقدم من {days} يوم)", flush=True)
    except Exception as e:
        print(f"⚠️ فشل تنظيف الفيديوهات: {e}", flush=True)


def cleanup_empty_folders():
    """حذف المجلدات الفارغة داخل uploads/alerts/videos"""
    try:
        videos_dir = 'uploads/alerts/videos'
        if not os.path.exists(videos_dir):
            return
        for entry in os.listdir(videos_dir):
            full_path = os.path.join(videos_dir, entry)
            if os.path.isdir(full_path) and not os.listdir(full_path):
                os.rmdir(full_path)
    except Exception:
        pass


def send_broadcast_message(role_filter, message, send_email_flag=True, send_telegram_flag=True):
    conn = get_db_connection()
    cursor = conn.cursor()
    if role_filter == 'all':
        cursor.execute("SELECT Id, Name, Email, ParentEmail, TelegramChatID, Role FROM Users WHERE IsActive = 1")
    else:
        cursor.execute("SELECT Id, Name, Email, ParentEmail, TelegramChatID, Role FROM Users WHERE Role = ? AND IsActive = 1", (role_filter,))
    users = cursor.fetchall()
    conn.close()
    email_count = 0
    telegram_count = 0
    errors = []
    for user in users:
        user_id, name, email, parent_email, telegram_chat_id, role = user
        actual_chat_id = None
        if telegram_chat_id:
            telegram_chat_id_str = str(telegram_chat_id)
            if telegram_chat_id_str.isdigit():
                actual_chat_id = telegram_chat_id_str
            else:
                actual_chat_id = get_chat_id_from_code(telegram_chat_id_str)
        target_email = parent_email if role == 'طالب' else email
        if send_email_flag and target_email:
            subject = "📢 إعلان من إدارة المدرسة"
            full_body = f"{message}\n\n---\nرسالة عامة من مدارس المنال الأهلية.\n{datetime.now().strftime('%Y-%m-%d %H:%M')}"
            if send_email(target_email, subject, full_body):
                email_count += 1
            else:
                errors.append(f"فشل بريد إلى {target_email}")
        if send_telegram_flag and actual_chat_id:
            telegram_msg = f"📢 *إعلان من إدارة المدرسة*\n\n{message}\n\n---\n{datetime.now().strftime('%Y-%m-%d %H:%M')}"
            if send_telegram(actual_chat_id, telegram_msg):
                telegram_count += 1
            else:
                errors.append(f"فشل تيليجرام إلى {actual_chat_id}")
    return {'email_count': email_count, 'telegram_count': telegram_count, 'total_users': len(users), 'errors': errors}


def get_user_monthly_details(user_id, month, year):
    conn = get_db_connection()
    cursor = conn.cursor()
    cursor.execute("SELECT Name, Role, ProfileImage FROM Users WHERE Id = ? AND IsActive = 1", (user_id,))
    user = cursor.fetchone()
    if not user:
        conn.close()
        return {"error": "المستخدم غير موجود"}
    month_str = f"{year}-{str(month).zfill(2)}"
    cursor.execute("""
        SELECT AttendanceDate, CheckInTime, CheckOutTime, Status, ExcuseReason
        FROM Attendance WHERE UserId = ? AND AttendanceDate LIKE ?
        ORDER BY AttendanceDate
    """, (user_id, f"{month_str}%"))
    rows = cursor.fetchall()
    conn.close()
    days_dict = {}
    present_count = 0
    absent_count = 0
    excused_count = 0
    for r in rows:
        date_str = str(r.AttendanceDate)
        status = r.Status or 'غائب'
        checkin_time = None
        checkout_time = None
        if r.CheckInTime:
            try:
                dt_obj = datetime.strptime(str(r.CheckInTime), "%H:%M:%S")
                checkin_time = dt_obj.strftime("%I:%M %p").lstrip('0')
            except Exception:
                checkin_time = str(r.CheckInTime)
        if r.CheckOutTime:
            try:
                dt_obj = datetime.strptime(str(r.CheckOutTime), "%H:%M:%S")
                checkout_time = dt_obj.strftime("%I:%M %p").lstrip('0')
            except Exception:
                checkout_time = str(r.CheckOutTime)
        days_dict[date_str] = {'status': status, 'checkin': checkin_time, 'checkout': checkout_time, 'excuse_reason': r.ExcuseReason}
        if status == 'حاضر':
            present_count += 1
        elif status == 'معذور':
            excused_count += 1
        else:
            absent_count += 1
    holidays_list = get_holidays_for_month(month, year)
    conn = get_db_connection()
    cursor = conn.cursor()
    cursor.execute("SELECT HolidayDate FROM IndividualHolidays WHERE UserId = ? AND HolidayDate LIKE ?", (user_id, f"{month_str}%"))
    individual_rows = cursor.fetchall()
    conn.close()
    for r in individual_rows:
        holidays_list.append(str(r.HolidayDate))
    holidays_list = list(set(holidays_list))
    days_list = []
    for date_str, info in days_dict.items():
        days_list.append({'date': date_str, 'status': info['status'], 'checkin': info['checkin'], 'checkout': info['checkout'], 'excuse_reason': info['excuse_reason']})
    return {
        'name': user.Name, 'role': user.Role, 'profile_image': user.ProfileImage,
        'month': month, 'year': year,
        'present_count': present_count, 'absent_count': absent_count, 'excused_count': excused_count,
        'days': days_list, 'holidays': holidays_list,
        'today': datetime.now().strftime("%Y-%m-%d")
    }


def get_holidays_for_month(month, year):
    settings = load_settings()
    holidays_list = []
    weekly_holidays = settings.get('weekly_holidays', [])
    weekdays_map = {'الإثنين': 0, 'الثلاثاء': 1, 'الأربعاء': 2, 'الخميس': 3, 'الجمعة': 4, 'السبت': 5, 'الأحد': 6}
    weekly_numbers = [weekdays_map.get(day) for day in weekly_holidays if day in weekdays_map]
    for day in range(1, 32):
        try:
            date_obj = datetime(year, month, day)
            if date_obj.weekday() in weekly_numbers:
                holidays_list.append(date_obj.strftime("%Y-%m-%d"))
        except ValueError:
            pass
    conn = get_db_connection()
    cursor = conn.cursor()
    cursor.execute("""
        SELECT HolidayDate, EndDate FROM Holidays
        WHERE (HolidayType IS NULL OR HolidayType = N'عامة')
          AND (EndDate IS NULL OR EndDate >= ?)
    """, (f"{year}-{str(month).zfill(2)}-01",))
    holidays_rows = cursor.fetchall()
    conn.close()
    for r in holidays_rows:
        start_date = str(r.HolidayDate)
        if r.EndDate:
            current = r.HolidayDate
            end = r.EndDate
            while current <= end:
                holidays_list.append(str(current))
                current += timedelta(days=1)
        else:
            holidays_list.append(start_date)
    return holidays_list


def generate_dropout_pdf(user_name, user_role, data):
    pdf = FPDF()
    pdf.add_page()
    pdf.add_font('Arial', '', 'fonts/arial.ttf', uni=True)
    pdf.set_font('Arabic', '', 16)
    pdf.cell(0, 10, reshape_arabic('تقرير إنذار مبكر'), align='C', ln=True)
    pdf.ln(10)
    pdf.set_font('Arabic', '', 14)
    pdf.cell(0, 10, reshape_arabic(f'الاسم: {user_name}'), ln=True)
    pdf.cell(0, 10, reshape_arabic(f'الدور: {user_role}'), ln=True)
    pdf.cell(0, 10, reshape_arabic(f'نسبة الغياب: {data["rate"]}%'), ln=True)
    pdf.cell(0, 10, reshape_arabic(f'أيام الغياب: {data["absent_days"]} من {data["total_days"]}'), ln=True)
    pdf.ln(10)
    pdf.set_font('Arabic', '', 12)
    pdf.multi_cell(0, 10, reshape_arabic('هذا إنذار رسمي من النظام الذكي.'))
    filename = f"dropout_{user_name}_{datetime.now().strftime('%Y%m%d%H%M%S')}.pdf"
    filepath = os.path.join('exports', filename)
    os.makedirs('exports', exist_ok=True)
    pdf.output(filepath)
    return filepath


def generate_custom_report(user_name, user_role, rows, start_date, end_date):
    if not rows:
        return None
    pdf = FPDF()
    pdf.add_page()
    try:
        pdf.add_font('Arial', '', 'fonts/arial.ttf', uni=True)
        pdf.set_font('Arial', '', 16)
    except Exception:
        pdf.set_font('Helvetica', '', 16)
    pdf.cell(0, 10, reshape_arabic(f'تقرير الحضور - {user_name}'), align='C', ln=True)
    pdf.ln(5)
    pdf.set_font('Arial', '', 12)
    pdf.cell(0, 10, reshape_arabic(f'الفترة: {start_date} إلى {end_date}'), align='C', ln=True)
    pdf.cell(0, 10, reshape_arabic(f'الدور: {user_role}'), align='C', ln=True)
    pdf.ln(10)
    pdf.set_font('Arial', '', 10)
    pdf.cell(40, 10, reshape_arabic('التاريخ'), border=1)
    pdf.cell(40, 10, reshape_arabic('الحالة'), border=1)
    pdf.cell(40, 10, reshape_arabic('وقت الدخول'), border=1)
    pdf.cell(40, 10, reshape_arabic('وقت الخروج'), border=1)
    pdf.ln()
    for row in rows:
        pdf.cell(40, 8, reshape_arabic(str(row.AttendanceDate)), border=1)
        status = row.Status or 'غائب'
        pdf.cell(40, 8, reshape_arabic(status), border=1)
        checkin = str(row.CheckInTime) if row.CheckInTime else '-'
        pdf.cell(40, 8, reshape_arabic(checkin), border=1)
        checkout = str(row.CheckOutTime) if row.CheckOutTime else '-'
        pdf.cell(40, 8, reshape_arabic(checkout), border=1)
        pdf.ln()
    filename = f"report_{user_name}_{datetime.now().strftime('%Y%m%d%H%M%S')}.pdf"
    filepath = os.path.join('exports', filename)
    os.makedirs('exports', exist_ok=True)
    pdf.output(filepath)
    return filepath


def send_daily_absent_report():
    settings = load_settings()
    today = datetime.now().strftime("%Y-%m-%d")
    conn = get_db_connection()
    cursor = conn.cursor()
    cursor.execute("""
        SELECT u.Name, u.Role, u.Class FROM Users u
        WHERE u.Role = N'طالب' AND u.IsActive = 1
          AND u.Id NOT IN (SELECT DISTINCT UserId FROM Attendance WHERE AttendanceDate = ?)
          AND u.Id NOT IN (SELECT UserId FROM IndividualHolidays WHERE HolidayDate = ?)
    """, (today, today))
    absent_rows = cursor.fetchall()
    cursor.execute("""
        SELECT u.Name, u.Role FROM Users u
        WHERE u.Role = N'معلم' AND u.IsActive = 1
          AND u.Id NOT IN (SELECT DISTINCT UserId FROM Attendance WHERE AttendanceDate = ?)
          AND u.Id NOT IN (SELECT UserId FROM IndividualHolidays WHERE HolidayDate = ?)
    """, (today, today))
    absent_teachers = cursor.fetchall()
    conn.close()
    wb = openpyxl.Workbook()
    ws = wb.active
    ws.title = f"الغائبون {today}"
    ws.append(['الاسم', 'الدور', 'الصف'])
    for r in absent_rows:
        ws.append([r.Name, r.Role, r.Class or '-'])
    for r in absent_teachers:
        ws.append([r.Name, r.Role, '-'])
    filename = f"absent_{today}.xlsx"
    filepath = os.path.join('exports', filename)
    os.makedirs('exports', exist_ok=True)
    wb.save(filepath)
    admin_email = settings.get("admin_email", EMAIL_SENDER)
    send_email(admin_email, f"تقرير الغائبين - {today}", "تقرير الغائبين مرفق.", filepath)


