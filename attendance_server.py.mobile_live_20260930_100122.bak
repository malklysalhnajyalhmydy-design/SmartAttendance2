    data = request.get_json()
    conn = get_db_connection(); cursor = conn.cursor()
    cursor.execute("UPDATE Periods SET StartTime=?, EndTime=?, Name=?, IsBreak=? WHERE Id=?",
                   (data.get('start'), data.get('end'), data.get('name'),
                    1 if data.get('is_break') else 0, pid))
    conn.commit(); conn.close()
    return jsonify({"success": True, "message": "✅ تم التحديث"})


@app.route('/api/periods/reset', methods=['POST'])
def api_periods_reset():
    if session.get('role') != 'مدير': return jsonify({"error": "غير مصرح"}), 401
    conn = get_db_connection(); cursor = conn.cursor()
    cursor.execute("DELETE FROM Periods")
    defaults = [('07:30','08:15'),('08:20','09:05'),('09:10','09:55'),
                ('10:15','11:00'),('11:05','11:50'),('11:55','12:40'),('12:45','13:30')]
    for i, (s,e) in enumerate(defaults, 1):
        cursor.execute("""INSERT INTO Periods (PeriodNumber, StartTime, EndTime, Name, IsBreak, IsActive)
                          VALUES (?, ?, ?, ?, 0, 1)""", (i, s, e, f'الحصة {i}'))
    conn.commit(); conn.close()
    return jsonify({"success": True, "message": "✅ 7 حصص افتراضية"})


@app.route('/api/schedule', methods=['GET', 'POST'])
def api_schedule():
    if session.get('role') not in ['مدير', 'مشرف']: return jsonify({"error": "غير مصرح"}), 401
    if request.method == 'GET':
        view = request.args.get('view', 'teacher')
        target_id = request.args.get('id', type=int)
        day = request.args.get('day', type=int)
        conn = get_db_connection(); cursor = conn.cursor()
        conditions, params = [], []
        if view == 'teacher' and target_id: conditions.append("cs.TeacherId=?"); params.append(target_id)
        elif view == 'classroom' and target_id: conditions.append("cs.ClassroomId=?"); params.append(target_id)
        elif view == 'day' and day is not None: conditions.append("cs.DayOfWeek=?"); params.append(day)
        where = ("WHERE " + " AND ".join(conditions)) if conditions else ""
        cursor.execute(f"""SELECT cs.Id, cs.TeacherId, u.Name as TeacherName, cs.Subject,
                           cs.ClassroomId, cs.ClassroomName, cs.DayOfWeek, cs.PeriodNumber,
                           cs.SupervisorId, sup.Name as SupervisorName
                           FROM ClassSchedule cs
                           LEFT JOIN Users u ON cs.TeacherId = u.Id
                           LEFT JOIN Users sup ON cs.SupervisorId = sup.Id
                           {where} ORDER BY cs.DayOfWeek, cs.PeriodNumber""", params)
        rows = cursor.fetchall(); conn.close()
        return jsonify([{'id': r.Id, 'teacher_id': r.TeacherId, 'teacher_name': r.TeacherName,
                         'subject': r.Subject, 'classroom_id': r.ClassroomId,
                         'classroom_name': r.ClassroomName, 'day': r.DayOfWeek,
                         'period': r.PeriodNumber, 'supervisor_id': r.SupervisorId,
                         'supervisor_name': r.SupervisorName} for r in rows])
    data = request.get_json()
     # ✅ 🆕 Validation
    if not data.get('teacher_id'):
        return jsonify({"success": False, "message": "⚠️ اختر المعلم"}), 400
    if not data.get('subject'):
        return jsonify({"success": False, "message": "⚠️ أدخل المادة"}), 400
    if not data.get('day') and data.get('day') != 0:
        return jsonify({"success": False, "message": "⚠️ اختر اليوم"}), 400
    if not data.get('period'):
        return jsonify({"success": False, "message": "⚠️ اختر رقم الحصة (تأكد من إعداد الحصص)"}), 400
   
    try:
        data['period'] = int(data['period'])
        if data['period'] < 1:
            return jsonify({"success": False, "message": "⚠️ رقم الحصة يجب أن يكون 1 أو أكثر"}), 400
    except (ValueError, TypeError):
        return jsonify({"success": False, "message": "⚠️ رقم الحصة غير صالح"}), 400
    err = check_schedule_conflicts(data.get('teacher_id'), data.get('classroom_id'),
                                    data.get('day'), data.get('period'))
    if err: return jsonify({"success": False, "message": err}), 400
    conn = get_db_connection(); cursor = conn.cursor()
    cursor.execute("""INSERT INTO ClassSchedule (TeacherId, Subject, ClassroomId, ClassroomName,
                       DayOfWeek, PeriodNumber, SupervisorId) VALUES (?, ?, ?, ?, ?, ?, ?)""",
                   (data['teacher_id'], data['subject'], data.get('classroom_id'),
                    data.get('classroom_name'), data['day'], data['period'], data.get('supervisor_id')))
    conn.commit(); conn.close()
    return jsonify({"success": True, "message": "✅ تم إضافة الحصة"})


@app.route('/api/schedule/<int:sid>', methods=['PUT', 'DELETE'])
def api_schedule_edit(sid):
    if session.get('role') not in ['مدير', 'مشرف']: return jsonify({"error": "غير مصرح"}), 401
    conn = get_db_connection(); cursor = conn.cursor()
    if request.method == 'DELETE':
        cursor.execute("DELETE FROM ClassSchedule WHERE Id=?", (sid,))
        conn.commit(); conn.close(); return jsonify({"success": True, "message": "✅ تم الحذف"})
    data = request.get_json()
    err = check_schedule_conflicts(data.get('teacher_id'), data.get('classroom_id'),
                                    data.get('day'), data.get('period'), exclude_id=sid)
    if err: conn.close(); return jsonify({"success": False, "message": err}), 400
    cursor.execute("""UPDATE ClassSchedule SET TeacherId=?, Subject=?, ClassroomId=?, ClassroomName=?,
                       DayOfWeek=?, PeriodNumber=?, SupervisorId=? WHERE Id=?""",
                   (data['teacher_id'], data['subject'], data.get('classroom_id'),
                    data.get('classroom_name'), data['day'], data['period'], data.get('supervisor_id'), sid))
    conn.commit(); conn.close()
    return jsonify({"success": True, "message": "✅ تم التحديث"})


@app.route('/api/schedule/random', methods=['POST'])
def api_schedule_random():
    if session.get('role') != 'مدير': return jsonify({"error": "غير مصرح"}), 401
    data = request.get_json() or {}
    periods = get_periods()
    if not periods: return jsonify({"success": False, "message": "أضف الحصص أولاً"}), 400
    conn = get_db_connection(); cursor = conn.cursor()
    cursor.execute("SELECT Id, Name, WorkingDays, MaxPeriodsPerDay FROM Users WHERE Role=N'معلم' AND IsActive=1")
    teachers = cursor.fetchall()
    cursor.execute("SELECT Id, Name FROM Classrooms WHERE IsActive=1")
    classrooms = cursor.fetchall()
    cursor.execute("DELETE FROM ClassSchedule")
    import random
    added = 0
    busy_teachers, busy_classrooms, teacher_daily, subj_cache = defaultdict(set), defaultdict(set), defaultdict(int), {}
    for day in range(6):
        for p in periods:
            if p['is_break']: continue
            random.shuffle(teachers); placed = False
            for t in teachers:
                working = [int(x) for x in (t.WorkingDays or "0,1,2,3,4").split(',') if x.isdigit()]
                if data.get('smart', True) and day not in working: continue
                if data.get('smart', True) and teacher_daily[t.Id] >= (t.MaxPeriodsPerDay or 7): continue
                if t.Id in busy_teachers[(day, p['number'])]: continue
                random.shuffle(classrooms)
                for c in classrooms:
                    if c.Id in busy_classrooms[(day, p['number'])]: continue
                    if t.Id not in subj_cache: subj_cache[t.Id] = get_teacher_subjects(t.Id)
                    subs = subj_cache[t.Id]
                    subject = random.choice(subs) if subs else 'عامة'
                    cursor.execute("""INSERT INTO ClassSchedule (TeacherId, Subject, ClassroomId, ClassroomName,
                                       DayOfWeek, PeriodNumber) VALUES (?, ?, ?, ?, ?, ?)""",
                                   (t.Id, subject, c.Id, c.Name, day, p['number']))
                    busy_teachers[(day, p['number'])].add(t.Id); busy_classrooms[(day, p['number'])].add(c.Id)
                    teacher_daily[t.Id] += 1; added += 1; placed = True; break
                if placed: break
    conn.commit(); conn.close()
    return jsonify({"success": True, "message": f"✅ تم ترتيب {added} حصة"})


@app.route('/api/schedule/check-conflicts')
def api_schedule_check_conflicts():
    if session.get('role') not in ['مدير', 'مشرف']: return jsonify({"error": "غير مصرح"}), 401
    conn = get_db_connection(); cursor = conn.cursor()
    cursor.execute("""SELECT TeacherId, DayOfWeek, PeriodNumber FROM ClassSchedule
                      GROUP BY TeacherId, DayOfWeek, PeriodNumber HAVING COUNT(*) > 1""")
    tc = cursor.fetchall()
    cursor.execute("""SELECT ClassroomId, DayOfWeek, PeriodNumber FROM ClassSchedule
                      WHERE ClassroomId IS NOT NULL GROUP BY ClassroomId, DayOfWeek, PeriodNumber
                      HAVING COUNT(*) > 1""")
    cc = cursor.fetchall(); conn.close()
    return jsonify({'teacher_conflicts': [{'teacher_id': r.TeacherId, 'day': r.DayOfWeek, 'period': r.PeriodNumber} for r in tc],
                    'classroom_conflicts': [{'classroom_id': r.ClassroomId, 'day': r.DayOfWeek, 'period': r.PeriodNumber} for r in cc]})


