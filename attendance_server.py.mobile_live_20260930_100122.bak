# ======================== Login ========================
def safe_check_password(stored_hash, password):
    """فحص آمن يدعم الـ hash القديم والنصي"""
    if not stored_hash:
        return False
    try:
        return werkzeug.security.check_password_hash(stored_hash, password)
    except Exception:
        # كلمة مرور قديمة نصية (من fix_old_students.py)
        return stored_hash == password



@app.route('/api/login', methods=['POST'])
def api_login():
    data = request.get_json()
    username = data.get('username', '').strip()
    password = data.get('password', '')
    if not username or not password:
        return jsonify({"success": False, "message": "يرجى ملء جميع الحقول."})

    conn = get_db_connection()
    cursor = conn.cursor()

    # ========== المحاولة 1: البحث بـ Username ==========
    cursor.execute(
        """SELECT Id, PasswordHash, Role, Name, ProfileImage, ParentPassword
           FROM Users WHERE Username = ? AND IsActive = 1""",
        (username,)
    )
    user = cursor.fetchone()

    # ✅ حالة الطالب: اسم المستخدم = اسم الطالب → يتحقق من ParentPassword
    if user and user[2] == 'طالب':
        parent_password_hash = user[5]

        if not parent_password_hash:
            conn.close()
            return jsonify({
                "success": False,
                "message": "⚠️ لم يتم تعيين كلمة مرور لولي الأمر بعد. تواصل مع الإدارة."
            })

        if not safe_check_password(parent_password_hash, password):
            log_login_attempt(user[0], False)
            conn.close()
            return jsonify({"success": False, "message": "كلمة المرور غير صحيحة."})

        log_login_attempt(user[0], True)
        session['user_id'] = user[0]
        session['role'] = 'parent'
        conn.close()
        return jsonify({
            "success": True,
            "role": 'parent',
            "name": user[3] or '',
            "profile_image": user[4] or ''
        })

    # ✅ حالة المستخدمين الآخرين (مدير / مشرف / معلم / حارس)
    if user:
        if not safe_check_password(user[1], password):
            log_login_attempt(user[0], False)
            conn.close()
            return jsonify({"success": False, "message": "كلمة المرور غير صحيحة."})

        log_login_attempt(user[0], True)
        session['user_id'] = user[0]
        session['role'] = user[2]
        conn.close()
        return jsonify({
            "success": True,
            "role": user[2],
            "name": user[3] or '',
            "profile_image": user[4] or ''
        })

    # ========== المحاولة 2: البحث بـ ParentUsername (fallback) ==========
    cursor.execute(
        """SELECT Id, ParentPassword, N'parent', Name, ProfileImage
           FROM Users WHERE ParentUsername = ? AND Role = N'طالب' AND IsActive = 1""",
        (username,)
    )
    parent_user = cursor.fetchone()

    if parent_user:
        if not parent_user[1]:
            conn.close()
            return jsonify({
                "success": False,
                "message": "⚠️ لم يتم تعيين كلمة مرور لولي الأمر بعد. تواصل مع الإدارة."
            })

        if not safe_check_password(parent_user[1], password):
            log_login_attempt(parent_user[0], False)
            conn.close()
            return jsonify({"success": False, "message": "بيانات الدخول غير صحيحة."})

        log_login_attempt(parent_user[0], True)
        session['user_id'] = parent_user[0]
        session['role'] = 'parent'
        conn.close()
        return jsonify({
            "success": True,
            "role": 'parent',
            "name": parent_user[3] or '',
            "profile_image": parent_user[4] or ''
        })

    conn.close()
    return jsonify({"success": False, "message": "اسم المستخدم غير صحيح."})
    
    
    
@app.route('/api/logout')
def logout():
    session.clear()
    # ✅ دعم AJAX
    if request.headers.get('X-Requested-With') == 'XMLHttpRequest' or \
       request.headers.get('Accept', '').find('application/json') >= 0:
        return jsonify({"success": True, "message": "تم تسجيل الخروج"})
    return redirect(url_for('index'))


@app.route('/test-login')
def test_login():
    conn = get_db_connection()
    cursor = conn.cursor()
    cursor.execute("SELECT Id, Name, Role FROM Users WHERE Role = N'مدير' AND IsActive = 1")
    row = cursor.fetchone()
    if not row:
        from werkzeug.security import generate_password_hash
        pw_hash = generate_password_hash('abubuker')
        cursor.execute("INSERT INTO Users (Name, Role, Username, PasswordHash, IsActive) VALUES (N'مدير النظام', N'مدير', N'admin', ?, 1)", (pw_hash,))
        conn.commit()
        cursor.execute("SELECT Id, Name, Role FROM Users WHERE Role = N'مدير' AND IsActive = 1")
        row = cursor.fetchone()
    conn.close()
    if row:
        session['user_id'] = row.Id
        session['role'] = row.Role
        return redirect(url_for('admin_dashboard'))
    return "فشل الدخول"


@app.route('/video_feed')
def video_feed():
    src_param = request.args.get('src')
    res_param = request.args.get('res')

    def generate():
        if src_param:
            rtsp_url = src_param
        else:
            settings = load_settings()
            rtsp_url = settings.get("rtsp_url", "")
            if not rtsp_url:
                rtsp_url = 'rtsp://admin:aden%401122@192.168.1.65:554/Streaming/Channels/102'

        print(f"📹 محاولة الاتصال بالكاميرا: {rtsp_url} (الدقة: {res_param or 'افتراضي'})", flush=True)
        os.environ["OPENCV_FFMPEG_CAPTURE_OPTIONS"] = "rtsp_transport;tcp"

        target_w, target_h = 640, 480
        if res_param:
            try:
                requested_w = int(res_param)
                ratio_map = {3840: 2160, 3200: 1800, 2688: 1520, 1920: 1080, 1280: 720}
                target_w = requested_w
                target_h = ratio_map.get(requested_w, int(requested_w * 9 / 16))
            except Exception:
                pass

        while True:
            cap = None
            try:
                cap = cv2.VideoCapture(rtsp_url, cv2.CAP_FFMPEG)
                if not cap.isOpened():
                    print("❌ فشل فتح الكاميرا، إعادة بعد 3 ثوانٍ...", flush=True)
                    time.sleep(3)
                    continue
                cap.set(cv2.CAP_PROP_BUFFERSIZE, 1)
                cap.set(cv2.CAP_PROP_FRAME_WIDTH, target_w)
                cap.set(cv2.CAP_PROP_FRAME_HEIGHT, target_h)
                actual_w = int(cap.get(cv2.CAP_PROP_FRAME_WIDTH))
                actual_h = int(cap.get(cv2.CAP_PROP_FRAME_HEIGHT))
                print(f"✅ تم فتح الكاميرا: {actual_w}x{actual_h}", flush=True)
                while True:
                    ret, frame = cap.read()
                    if not ret:
                        print("⚠️ انقطاع الإشارة...", flush=True)
                        break
                    jpeg_quality = 75 if target_w <= 1280 else 60
                    ret, jpeg = cv2.imencode('.jpg', frame, [cv2.IMWRITE_JPEG_QUALITY, jpeg_quality])
                    frame_bytes = jpeg.tobytes()
                    yield (b'--frame\r\nContent-Type: image/jpeg\r\n\r\n' + frame_bytes + b'\r\n\r\n')
            except Exception as e:
                print(f"❌ خطأ في البث: {e}", flush=True)
                traceback.print_exc()
            finally:
                if cap:
                    cap.release()
            time.sleep(3)

    return Response(generate(), mimetype='multipart/x-mixed-replace; boundary=frame')


@app.route('/api/capture_frame', methods=['GET'])
def api_capture_frame():
    settings = load_settings()
    rtsp_url = settings.get("rtsp_url", "")
    if not rtsp_url:
        rtsp_url = 'rtsp://admin:aden%401122@192.168.1.65:554/Streaming/Channels/102'
    cap = None
    try:
        cap = cv2.VideoCapture(rtsp_url, cv2.CAP_FFMPEG)
        if not cap.isOpened():
            return jsonify({"success": False, "message": "تعذر فتح الكاميرا"}), 500
        cap.set(cv2.CAP_PROP_BUFFERSIZE, 1)
        ret, frame = cap.read()
        if not ret:
            return jsonify({"success": False, "message": "تعذر قراءة الإطار"}), 500
        ret, jpeg = cv2.imencode('.jpg', frame, [cv2.IMWRITE_JPEG_QUALITY, 95])
        img_base64 = base64.b64encode(jpeg.tobytes()).decode('utf-8')
        return jsonify({"success": True, "image": f"data:image/jpeg;base64,{img_base64}", "message": "تم الالتقاط"})
    except Exception as e:
        return jsonify({"success": False, "message": str(e)}), 500
    finally:
        if cap:
            cap.release()

@app.route('/api/parent/monthly-pdf')
def api_parent_monthly_pdf():
    """تحميل PDF لتقرير الشهر لولي الأمر (لابنه فقط)"""
    if session.get('role') != 'parent':
        return jsonify({"error": "غير مصرح"}), 401

    child_id = session.get('user_id')
    month = request.args.get('month', type=int)
    year = request.args.get('year', type=int)
    today = datetime.now()
    if not month: month = today.month
    if not year:  year  = today.year

    try:
        conn = get_db_connection()
        cursor = conn.cursor()
        cursor.execute("SELECT Name, Role FROM Users WHERE Id = ? AND IsActive = 1", (child_id,))
        user = cursor.fetchone()
        if not user:
            conn.close()
            return jsonify({"error": "المستخدم غير موجود"}), 404

        month_str = f"{year}-{str(month).zfill(2)}"
        cursor.execute("""
            SELECT AttendanceDate, CheckInTime, CheckOutTime, Status, ExcuseReason
            FROM Attendance WHERE UserId = ? AND AttendanceDate LIKE ?
            ORDER BY AttendanceDate
        """, (child_id, f"{month_str}%"))
        rows = cursor.fetchall()
        conn.close()

        if not rows:
            return jsonify({"error": "لا توجد بيانات لهذا الشهر"}), 404

        start_date = f"{year}-{str(month).zfill(2)}-01"
        next_month = month + 1 if month < 12 else 1
        next_year = year if month < 12 else year + 1
        end_date = (datetime(next_year, next_month, 1) - timedelta(days=1)).strftime("%Y-%m-%d")

        pdf_path = generate_custom_report(user.Name, user.Role, rows, start_date, end_date)
        if not pdf_path:
            return jsonify({"error": "فشل إنشاء التقرير"}), 500

        month_name = ['يناير','فبراير','مارس','أبريل','مايو','يونيو','يوليو','أغسطس','سبتمبر','أكتوبر','نوفمبر','ديسمبر'][month-1]
        download_name = f"تقرير_{user.Name}_{month_name}_{year}.pdf"

        return send_file(pdf_path, as_attachment=True, download_name=download_name)
    except Exception as e:
        print(f"❌ خطأ في PDF ولي الأمر: {e}", flush=True)
        traceback.print_exc()
        return jsonify({"error": str(e)}), 500


@app.route('/api/parent/send-message', methods=['POST'])
def api_parent_send_message():
    """ولي الأمر يرسل رسالة لإدارة المدرسة (تصل للمدير والمشرفين عبر تيليجرام/إيميل)"""
    if session.get('role') != 'parent':
        return jsonify({"error": "غير مصرح"}), 401

    try:
        data = request.get_json() or {}
        subject_text = (data.get('subject') or 'استفسار').strip()
        message_text = (data.get('message') or '').strip()

        if not message_text or len(message_text) < 5:
            return jsonify({"success": False, "message": "الرسالة قصيرة جداً"}), 400

        child_id = session.get('user_id')
        conn = get_db_connection()
        cursor = conn.cursor()
        cursor.execute("SELECT Name, Class FROM Users WHERE Id = ? AND IsActive = 1", (child_id,))
        child = cursor.fetchone()
        if not child:
            conn.close()
            return jsonify({"success": False, "message": "الطالب غير موجود"}), 404

        child_name = child.Name
        child_class = child.Class or '—'
        now_str = datetime.now().strftime("%Y-%m-%d %H:%M")

        tg_msg = (
            f"💬 <b>رسالة من ولي أمر</b>\n\n"
            f"👤 <b>الطالب:</b> {child_name}\n"
            f"🏫 <b>الصف:</b> {child_class}\n"
            f"📌 <b>الموضوع:</b> {subject_text}\n"
            f"🕐 <b>الوقت:</b> {now_str}\n\n"
            f"📝 <b>الرسالة:</b>\n{message_text}"
        )

        # جلب المديرين والمشرفين
        cursor.execute("""
            SELECT TelegramChatID, Email FROM Users
            WHERE Role IN (N'مدير', N'مشرف') AND IsActive = 1
              AND (TelegramChatID IS NOT NULL OR Email IS NOT NULL)
        """)
        staff = cursor.fetchall()
        conn.close()

        # fallback من الإعدادات
        settings = load_settings()
        admin_chat = settings.get('admin_telegram_chat_id')
        admin_email = settings.get('admin_email') or EMAIL_SENDER

        sent_tg = 0
        sent_email = 0
        chat_ids = set()
        emails = set()
        for s in staff:
            if s.TelegramChatID: chat_ids.add(str(s.TelegramChatID))
            if s.Email:          emails.add(s.Email)
        if admin_chat: chat_ids.add(str(admin_chat))
        if admin_email: emails.add(admin_email)

        for cid in chat_ids:
            try:
                if send_telegram(cid, tg_msg): sent_tg += 1
            except Exception: pass

        email_subject = f"💬 رسالة من ولي أمر الطالب {child_name} — {subject_text}"
        email_body = (
            f"الطالب: {child_name}\nالصف: {child_class}\n"
            f"الموضوع: {subject_text}\nالوقت: {now_str}\n\n"
            f"الرسالة:\n{message_text}"
        )
        for em in emails:
            try:
                if send_email(em, email_subject, email_body): sent_email += 1
            except Exception: pass

        if sent_tg == 0 and sent_email == 0:
            return jsonify({
                "success": False,
                "message": "⚠️ لم يتم إرسال الرسالة — تحقق من إعدادات الإدارة"
            }), 500

        print(f"✅ رسالة ولي أمر من {child_name}: tg={sent_tg}, email={sent_email}", flush=True)
        return jsonify({
            "success": True,
            "message": f"✅ تم إرسال رسالتك إلى الإدارة ({sent_tg} تيليجرام، {sent_email} إيميل)"
        })
    except Exception as e:
        print(f"❌ خطأ في send-message: {e}", flush=True)
        traceback.print_exc()
        return jsonify({"success": False, "message": str(e)}), 500


@app.route('/api/parent/notifications')
def api_parent_notifications():
    """آخر إشعارات/تنبيهات تخص الطالب (غياب، عذر، تنبيهات أمنية)"""
    if session.get('role') != 'parent':
        return jsonify({"error": "غير مصرح"}), 401

    child_id = session.get('user_id')
    try:
        conn = get_db_connection()
        cursor = conn.cursor()

        # 1. آخر إشعارات المراسلة
        cursor.execute("""
            SELECT TOP 10 Id, RecipientName, MessageText, SentAt, Status
            FROM AlertNotifications
            WHERE RecipientUserId = ?
            ORDER BY SentAt DESC
        """, (child_id,))
        notifs = [{
            'type': 'message',
            'title': '📨 رسالة من المدرسة',
            'body': r.MessageText[:120] if r.MessageText else '',
            'time': str(r.SentAt) if r.SentAt else ''
        } for r in cursor.fetchall()]

        # 2. آخر غيابات (آخر 7 أيام)
        cursor.execute("""
            SELECT TOP 5 AttendanceDate, Status, ExcuseReason
            FROM Attendance
            WHERE UserId = ? AND Status != N'حاضر'
              AND AttendanceDate >= DATEADD(DAY, -7, GETDATE())
            ORDER BY AttendanceDate DESC
        """, (child_id,))
        for r in cursor.fetchall():
            if r.Status == 'معذور':
                notifs.append({
                    'type': 'excused',
                    'title': '🟡 يوم معذور',
                    'body': f"{r.AttendanceDate} — {r.ExcuseReason or 'بدون سبب'}",
                    'time': str(r.AttendanceDate)
                })
            else:
                notifs.append({
                    'type': 'absence',
                    'title': '❌ غياب مسجل',
                    'body': f"{r.AttendanceDate} — لم يتم تسجيل حضور",
                    'time': str(r.AttendanceDate)
                })

        # 3. تنبيهات أمنية للطالب (فصل خطأ مثلاً)
        cursor.execute("""
            SELECT TOP 5 Id, AlertType, Description, CreatedAt
            FROM Alerts
            WHERE UserId = ?
            ORDER BY CreatedAt DESC
        """, (child_id,))
        for r in cursor.fetchall():
            if r.AlertType == 'wrong_class':
                notifs.append({
                    'type': 'alert',
                    'title': '🚨 تنبيه أمني',
                    'body': r.Description or '',
                    'time': str(r.CreatedAt) if r.CreatedAt else ''
                })

        conn.close()

        # ترتيب حسب الوقت
        notifs.sort(key=lambda x: x['time'], reverse=True)
        notifs = notifs[:15]

        return jsonify({
            'success': True,
            'count': len(notifs),
            'unread': len([n for n in notifs if n['type'] in ('absence','alert')]),
            'items': notifs
        })
    except Exception as e:
        print(f"❌ خطأ في notifications: {e}", flush=True)
        return jsonify({'success': True, 'count': 0, 'unread': 0, 'items': []})
# ============================================================
# 📨 نظام الرسائل ثنائي الاتجاه (ولي الأمر / المعلم ↔ الإدارة)
# ============================================================

def _get_user_contact_info(user_id):
    """جلب بيانات التواصل لمستخدم (للإشعارات)"""
    try:
        conn = get_db_connection()
        cursor = conn.cursor()
        cursor.execute("""
            SELECT Id, Name, Role, Email, ParentEmail, TelegramChatID
            FROM Users WHERE Id = ? AND IsActive = 1
        """, (user_id,))
        row = cursor.fetchone()
        conn.close()
        if not row:
            return None
        return {
            'id': row.Id,
            'name': row.Name,
            'role': row.Role,
            'email': row.Email,
            'parent_email': row.ParentEmail,
            'chat_id': row.TelegramChatID
        }
    except Exception as e:
        print(f"⚠️ خطأ _get_user_contact_info: {e}", flush=True)
        return None


@app.route('/api/messages/send', methods=['POST'])
def api_messages_send():
    """ولي الأمر / المعلم يُرسِل رسالة جديدة للمدرسة"""
    if 'user_id' not in session:
        return jsonify({"error": "غير مصرح"}), 401
    if session.get('role') not in ['parent', 'معلم', 'حارس']:
        return jsonify({"error": "هذه الخدمة متاحة لأولياء الأمور والمعلمين فقط"}), 403

    try:
        data = request.get_json() or {}
        subject_text = (data.get('subject') or 'استفسار عام').strip()
        message_text = (data.get('message') or '').strip()

        if not message_text or len(message_text) < 5:
            return jsonify({"success": False, "message": "الرسالة قصيرة جداً"}), 400

        user_id = session.get('user_id')
        user_info = _get_user_contact_info(user_id)
        if not user_info:
            return jsonify({"success": False, "message": "المستخدم غير موجود"}), 404

        sender_role = user_info['role']
        if session.get('role') == 'parent':
            sender_role = 'ولي أمر'

        # ✅ 1. إدراج الرسالة في DB
        conn = get_db_connection()
        cursor = conn.cursor()
        cursor.execute("""
            INSERT INTO Messages
            (SenderUserId, SenderName, SenderRole, SenderEmail, SenderChatId,
             IsFromAdmin, Subject, MessageText, Status, SentViaInApp, CreatedAt)
            OUTPUT INSERTED.Id
            VALUES (?, ?, ?, ?, ?, 0, ?, ?, 'new', 1, GETDATE())
        """, (
            user_id,
            user_info['name'],
            sender_role,
            user_info['parent_email'] or user_info['email'],
            user_info['chat_id'],
            subject_text,
            message_text
        ))
        row = cursor.fetchone()
        if not row:
            conn.rollback()
            conn.close()
            return jsonify({"success": False, "message": "فشل حفظ الرسالة"}), 500

        msg_id = int(row[0])
        cursor.execute("UPDATE Messages SET ThreadId = ? WHERE Id = ?", (msg_id, msg_id))
        conn.commit()
        conn.close()

        # ✅ 2. إشعار الإدارة (تيليجرام + إيميل)
        now_str = datetime.now().strftime("%Y-%m-%d %H:%M")
        admin_msg = (
            f"📨 <b>رسالة جديدة من {sender_role}</b>\n\n"
            f"👤 <b>الاسم:</b> {user_info['name']}\n"
            f"📌 <b>الموضوع:</b> {subject_text}\n"
            f"🕐 <b>الوقت:</b> {now_str}\n\n"
            f"📝 <b>الرسالة:</b>\n{message_text}\n\n"
            f"<i>➡️ للرد: افتح صفحة الرسائل الواردة</i>"
        )

        try:
            conn = get_db_connection()
            cursor = conn.cursor()
            cursor.execute("""
                SELECT TelegramChatID, Email FROM Users
                WHERE Role IN (N'مدير', N'مشرف') AND IsActive = 1
                AND (TelegramChatID IS NOT NULL OR Email IS NOT NULL)
            """)
            staff = cursor.fetchall()
            conn.close()

            settings = load_settings()
            chat_ids = set()
            emails = set()
            for s in staff:
                if s.TelegramChatID: chat_ids.add(str(s.TelegramChatID))
                if s.Email: emails.add(s.Email)
            if settings.get('admin_telegram_chat_id'): chat_ids.add(str(settings['admin_telegram_chat_id']))
            if settings.get('admin_email') or EMAIL_SENDER: emails.add(settings.get('admin_email') or EMAIL_SENDER)

            for cid in chat_ids:
                try: send_telegram(cid, admin_msg)
                except Exception: pass

            email_subject = f"📨 رسالة جديدة من {sender_role}: {user_info['name']}"
            email_body = f"الموضوع: {subject_text}\n\nمن: {user_info['name']} ({sender_role})\nالوقت: {now_str}\n\n{message_text}"
            for em in emails:
                try: send_email(em, email_subject, email_body)
                except Exception: pass
        except Exception as e:
            print(f"⚠️ فشل إشعار الإدارة: {e}", flush=True)

        print(f"✅ رسالة جديدة #{msg_id} من {user_info['name']}", flush=True)
        return jsonify({"success": True, "message": "✅ تم إرسال رسالتك إلى الإدارة", "id": msg_id})
    except Exception as e:
        print(f"❌ خطأ في api_messages_send: {e}", flush=True)
        traceback.print_exc()
        return jsonify({"success": False, "message": str(e)}), 500


@app.route('/api/messages/my-messages')
def api_my_messages():
    """عرض رسائل المُستخدم الحالي (ولي أمر/معلم) مع الردود"""
    if 'user_id' not in session:
        return jsonify({"error": "غير مصرح"}), 401

    try:
        user_id = session.get('user_id')
        conn = get_db_connection()
        cursor = conn.cursor()

        cursor.execute("""
            SELECT Id, ThreadId, Subject, MessageText, Status, IsFromAdmin,
                   SenderName, SenderRole, CreatedAt, ReadAt
            FROM Messages
            WHERE SenderUserId = ? AND IsFromAdmin = 0
            ORDER BY CreatedAt DESC
        """, (user_id,))
        roots = cursor.fetchall()

        result = []
        for r in roots:
            thread_id = r.ThreadId or r.Id
            cursor.execute("""
                SELECT Id, SenderName, SenderRole, MessageText, CreatedAt,
                       IsFromAdmin, SentViaEmail, SentViaTelegram, SentViaInApp
                FROM Messages
                WHERE ThreadId = ? AND Id != ?
                ORDER BY CreatedAt ASC
            """, (thread_id, r.Id))
            replies = cursor.fetchall()

            result.append({
                'id': r.Id,
                'thread_id': thread_id,
                'subject': r.Subject,
                'message': r.MessageText,
                'status': r.Status,
                'created_at': str(r.CreatedAt) if r.CreatedAt else '',
                'replies': [{
                    'id': rp.Id,
                    'sender_name': rp.SenderName,
                    'sender_role': rp.SenderRole,
                    'message': rp.MessageText,
                    'created_at': str(rp.CreatedAt) if rp.CreatedAt else '',
                    'is_from_admin': bool(rp.IsFromAdmin),
                    'sent_via_email': bool(rp.SentViaEmail),
                    'sent_via_telegram': bool(rp.SentViaTelegram),
                    'sent_via_inapp': bool(rp.SentViaInApp)
                } for rp in replies]
            })

        conn.close()
        return jsonify({'success': True, 'messages': result})
    except Exception as e:
        print(f"❌ خطأ في api_my_messages: {e}", flush=True)
        traceback.print_exc()
        return jsonify({'success': False, 'message': str(e)}), 500


@app.route('/api/messages/inbox')
def api_messages_inbox():
    """صندوق الوارد للمدير/المشرف"""
    if session.get('role') not in ['مدير', 'مشرف']:
        return jsonify({"error": "غير مصرح"}), 401

    try:
        status_filter = request.args.get('status', 'all')
        search_q = (request.args.get('q') or '').strip()

        conn = get_db_connection()
        cursor = conn.cursor()

        conditions = ["IsFromAdmin = 0"]
        params = []
        if status_filter == 'unread':
            conditions.append("Status = 'new'")
        elif status_filter == 'read':
            conditions.append("Status IN ('read', 'replied')")
        if search_q:
            conditions.append("(SenderName LIKE ? OR Subject LIKE ? OR MessageText LIKE ?)")
            s = f"%{search_q}%"
            params.extend([s, s, s])

        where = " AND ".join(conditions)
        query = f"""
            SELECT Id, ThreadId, SenderUserId, SenderName, SenderRole,
                   Subject, MessageText, Status, CreatedAt, ReadAt
            FROM Messages
            WHERE {where}
            ORDER BY CreatedAt DESC
        """
        cursor.execute(query, params)
        rows = cursor.fetchall()

        result = []
        for r in rows:
            thread_id = r.ThreadId or r.Id
            cursor.execute("SELECT COUNT(*) FROM Messages WHERE ThreadId = ? AND IsFromAdmin = 1", (thread_id,))
            replies_count = cursor.fetchone()[0]
            result.append({
                'id': r.Id,
                'thread_id': thread_id,
                'sender_user_id': r.SenderUserId,
                'sender_name': r.SenderName,
                'sender_role': r.SenderRole,
                'subject': r.Subject,
                'message': r.MessageText,
                'status': r.Status,
                'created_at': str(r.CreatedAt) if r.CreatedAt else '',
                'read_at': str(r.ReadAt) if r.ReadAt else None,
                'replies_count': replies_count
            })

        unread_total = sum(1 for x in result if x['status'] == 'new')
        conn.close()
        return jsonify({
            'success': True,
            'unread_total': unread_total,
            'messages': result
        })
    except Exception as e:
        print(f"❌ خطأ في api_messages_inbox: {e}", flush=True)
        traceback.print_exc()
        return jsonify({'success': False, 'message': str(e)}), 500


@app.route('/api/messages/unread-count')
def api_messages_unread_count():
    """عدّاد الرسائل غير المقروءة (للمدير/المشرف)"""
    if 'user_id' not in session:
        return jsonify({'count': 0})

    try:
        role = session.get('role')
        conn = get_db_connection()
        cursor = conn.cursor()

        if role in ['مدير', 'مشرف']:
            cursor.execute("SELECT COUNT(*) FROM Messages WHERE IsFromAdmin = 0 AND Status = 'new'")
        elif role in ['parent', 'معلم', 'حارس']:
            user_id = session.get('user_id')
            cursor.execute("""
                SELECT COUNT(*) FROM Messages
                WHERE SenderUserId = ? AND IsFromAdmin = 0
                AND Status = 'replied'
            """, (user_id,))
        else:
            count = 0
            conn.close()
            return jsonify({'count': 0})

        count = cursor.fetchone()[0]
        conn.close()
        return jsonify({'count': count})
    except Exception:
        return jsonify({'count': 0})


