@app.route('/api/next_id')
def api_next_id():
    role = request.args.get('role', 'طالب')
    sc = request.args.get('class', '')
    pm = {'طالب': 'STU', 'معلم': 'TCH', 'مشرف': 'SUP', 'مدير': 'MGR'}
    if role == 'طالب' and sc:
        cn = {'الأول': '1', 'الثاني': '2', 'الثالث': '3', 'الرابع': '4', 'الخامس': '5', 'السادس': '6', 'السابع': '7', 'الثامن': '8', 'التاسع': '9', 'أول ثانوي': '10', 'ثاني ثانوي': '11', 'ثالث ثانوي': '12'}
        prefix = cn.get(sc, 'STU') + '-'
    else:
        prefix = pm.get(role, 'STU')
    conn = get_db_connection()
    cursor = conn.cursor()
    cursor.execute("SELECT TOP 1 StudentId FROM Users WHERE StudentId LIKE ? AND Role = ? ORDER BY StudentId DESC", (prefix + '%', role))
    row = cursor.fetchone()
    conn.close()
    num = int(row.StudentId[len(prefix):]) + 1 if row and row.StudentId else 1
    return jsonify({"student_id": f"{prefix}{num:03d}"})


@app.route('/api/reports/monthly')
def api_reports_monthly():
    if session.get('role') not in ['مدير', 'مشرف']:
        return jsonify({"error": "غير مصرح"}), 401
    conn = get_db_connection()
    cursor = conn.cursor()
    cursor.execute("""
        SELECT u.Id, u.Name, u.Role, u.Class, u.ProfileImage,
               SUM(CASE WHEN a.Status = N'حاضر' THEN 1 ELSE 0 END) as PresentCount,
               SUM(CASE WHEN a.Status = N'غائب' THEN 1 ELSE 0 END) as AbsentCount,
               SUM(CASE WHEN a.Status = N'متأخر' THEN 1 ELSE 0 END) as LateCount,
               COUNT(a.Id) as TotalDays
        FROM Users u LEFT JOIN Attendance a ON u.Id = a.UserId
        GROUP BY u.Id, u.Name, u.Role, u.Class, u.ProfileImage
    """)
    rows = cursor.fetchall()
    conn.close()
    result = []
    for r in rows:
        total = r.TotalDays if r.TotalDays > 0 else 1
        rate = round((r.PresentCount / total) * 100, 1) if r.TotalDays > 0 else 0
        result.append({
            'user_id': r.Id,
            'name': r.Name,
            'role': r.Role,
            'class': r.Class or '-',
            'profile_image': r.ProfileImage or '',  # ✅ صورة المستخدم
            'presentCount': r.PresentCount or 0,
            'absentCount': r.AbsentCount or 0,
            'lateCount': r.LateCount or 0,
            'attendanceRate': rate
        })
    return jsonify(result)

@app.route('/api/attendance/today/export')
def api_attendance_today_export():
    if session.get('role') not in ['مدير', 'مشرف']:
        return jsonify({"error": "غير مصرح"}), 401
    today = datetime.now().strftime("%Y-%m-%d")
    conn = get_db_connection()
    cursor = conn.cursor()
    cursor.execute("""
        SELECT u.Name, u.Role, u.Class, a.CheckInTime, a.CheckOutTime
        FROM Attendance a JOIN Users u ON a.UserId = u.Id
        WHERE a.AttendanceDate = ?
        ORDER BY u.Role, u.Class, u.Name
    """, (today,))
    rows = cursor.fetchall()
    conn.close()
    wb = openpyxl.Workbook()
    ws = wb.active
    ws.title = f"حضور {today}"
    ws.append(['الاسم', 'الدور', 'الصف', 'وقت الدخول', 'وقت الخروج'])
    for r in rows:
        ws.append([r.Name, r.Role, r.Class or '-', str(r.CheckInTime) if r.CheckInTime else '-', str(r.CheckOutTime) if r.CheckOutTime else '-'])
    fn = f"attendance_{today}.xlsx"
    fp = os.path.join('exports', fn)
    os.makedirs('exports', exist_ok=True)
    wb.save(fp)
    return send_file(fp, as_attachment=True, download_name=fn)


