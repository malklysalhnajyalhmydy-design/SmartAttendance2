def api_exam_classroom_start(scid):
    if session.get('role') not in ['مدير', 'مشرف']: return jsonify({"error": "غير مصرح"}), 401
    conn = get_db_connection(); cursor = conn.cursor()
    cursor.execute("UPDATE ExamSessionClassrooms SET Status='running', StartedAt=GETDATE() WHERE Id=?", (scid,))
    cursor.execute("""UPDATE ExamSessions SET Status='running', StartedAt=COALESCE(StartedAt, GETDATE())
                      WHERE Id=(SELECT SessionId FROM ExamSessionClassrooms WHERE Id=?) AND Status IN ('idle','stopped')""", (scid,))
    conn.commit(); conn.close()
    return jsonify({"success": True, "message": "▶️ بدأت مراقبة الفصل"})


@app.route('/api/exams/classrooms/<int:scid>/stop', methods=['POST'])
def api_exam_classroom_stop(scid):
    if session.get('role') not in ['مدير', 'مشرف']: return jsonify({"error": "غير مصرح"}), 401
    conn = get_db_connection(); cursor = conn.cursor()
    cursor.execute("UPDATE ExamSessionClassrooms SET Status='stopped', StoppedAt=GETDATE() WHERE Id=?", (scid,))
    cursor.execute("SELECT SessionId FROM ExamSessionClassrooms WHERE Id=?", (scid,))
    r = cursor.fetchone()
    if r:
        sid = r.SessionId
        cursor.execute("SELECT COUNT(*) FROM ExamSessionClassrooms WHERE SessionId=? AND Status='running'", (sid,))
        if cursor.fetchone()[0] == 0:
            cursor.execute("UPDATE ExamSessions SET Status='stopped', StoppedAt=GETDATE() WHERE Id=?", (sid,))
    conn.commit(); conn.close()
    return jsonify({"success": True, "message": "⏹️ تم إيقاف الفصل"})


