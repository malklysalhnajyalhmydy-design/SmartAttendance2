def send_excuse_notification(user_id, date, reason, status='معذور'):
    conn = get_db_connection()
    cursor = conn.cursor()
    cursor.execute("SELECT Name, Role, ParentEmail, Email, TelegramChatID FROM Users WHERE Id = ?", (user_id,))
    user = cursor.fetchone()
    conn.close()
    if not user:
        return
    user_name, role, parent_email, personal_email, chat_id = user
    date_formatted = datetime.strptime(date, "%Y-%m-%d").strftime("%Y-%m-%d")
    if role == 'طالب':
        telegram_msg = f"📋 <b>تحديث حالة حضور ابنكم</b>\n\n👤 الطالب: {user_name}\n📅 {date_formatted}\n📌 الحالة: ✅ {status}\n📝 السبب: {reason}"
        email_subject = f"📋 تحديث حالة الحضور - {user_name}"
        email_body = f"تم قبول عذر {user_name} ليوم {date_formatted}.\n📌 الحالة: {status}\n📝 السبب: {reason}"
        if parent_email:
            send_email(parent_email, email_subject, email_body)
        if chat_id:
            send_telegram(chat_id, telegram_msg)
    else:
        telegram_msg = f"📋 <b>تحديث حالة حضوركم</b>\n\n👤 {user_name}\n📅 {date_formatted}\n📌 الحالة: ✅ {status}\n📝 السبب: {reason}"
        email_subject = f"📋 تحديث حالة الحضور - {user_name}"
        email_body = f"تم قبول عذركم ليوم {date_formatted}.\n📌 الحالة: {status}\n📝 السبب: {reason}"
        if personal_email:
            send_email(personal_email, email_subject, email_body)
        if chat_id:
            send_telegram(chat_id, telegram_msg)


@app.route('/api/reports/user-export/<int:user_id>')
def api_user_report_export(user_id):
    if session.get('role') not in ['مدير', 'مشرف']:
        return jsonify({"error": "غير مصرح"}), 401
    today = datetime.now()
    first_of_month = today.replace(day=1)
    last_month = first_of_month - timedelta(days=1)
    month_str = last_month.strftime("%Y-%m")
    conn = get_db_connection()
    cursor = conn.cursor()
    cursor.execute("SELECT Name, Role, Class FROM Users WHERE Id = ? AND IsActive = 1", (user_id,))
    user = cursor.fetchone()
    if not user:
        conn.close()
        return jsonify({"error": "المستخدم غير موجود"}), 404
    cursor.execute("SELECT AttendanceDate, CheckInTime, CheckOutTime, Status, ExcuseReason FROM Attendance WHERE UserId = ? AND AttendanceDate LIKE ? ORDER BY AttendanceDate", (user_id, f"{month_str}%"))
    rows = cursor.fetchall()
    conn.close()
    wb = openpyxl.Workbook()
    ws = wb.active
    ws.title = f"تقرير {user.Name} - {month_str}"
    ws.append(['التاريخ', 'الحالة', 'وقت الدخول', 'وقت الخروج', 'سبب العذر'])
    for r in rows:
        ws.append([str(r.AttendanceDate), r.Status, str(r.CheckInTime) if r.CheckInTime else '-', str(r.CheckOutTime) if r.CheckOutTime else '-', r.ExcuseReason or '-'])
    filename = f"user_report_{user.Name}_{month_str}.xlsx"
    filepath = os.path.join('exports', filename)
    os.makedirs('exports', exist_ok=True)
    wb.save(filepath)
    return send_file(filepath, as_attachment=True, download_name=filename)


@app.route('/api/reports/user-details/<int:user_id>')
def api_user_report_details(user_id):
    if session.get('role') not in ['مدير', 'مشرف']:
        return jsonify({"error": "غير مصرح"}), 401
    month = request.args.get('month', type=int)
    year = request.args.get('year', type=int)
    today = datetime.now()
    if month is None or year is None:
        month = today.month
        year = today.year
    else:
        if month < 1 or month > 12:
            return jsonify({"error": "شهر غير صحيح"}), 400
        if year < 2000 or year > 2100:
            return jsonify({"error": "سنة غير صحيحة"}), 400
    conn = get_db_connection()
    cursor = conn.cursor()
    cursor.execute("SELECT Name, Role, Class, ProfileImage FROM Users WHERE Id = ? AND IsActive = 1", (user_id,))
    user = cursor.fetchone()
    if not user:
        conn.close()
        return jsonify({"error": "المستخدم غير موجود"}), 404
    month_str = f"{year}-{str(month).zfill(2)}"
    cursor.execute("SELECT AttendanceDate, CheckInTime, CheckOutTime, Status, ExcuseReason FROM Attendance WHERE UserId = ? AND AttendanceDate LIKE ? ORDER BY AttendanceDate", (user_id, f"{month_str}%"))
    rows = cursor.fetchall()
    conn.close()
    days_dict = {}
    present_count = absent_count = excused_count = 0
    for r in rows:
        date_str = str(r.AttendanceDate)
        status = r.Status or 'غائب'
        checkin_time = checkout_time = None
        if r.CheckInTime:
            try:
                dt_obj = datetime.strptime(str(r.CheckInTime), "%H:%M:%S")
                checkin_time = dt_obj.strftime("%I:%M %p").lstrip('0')
            except Exception:
                checkin_time = str(r.CheckInTime)
        if r.CheckOutTime:
            try:
                dt_obj = datetime.strptime(str(r.CheckOutTime), "%H:%M:%S")
                checkout_time = dt_obj.strftime("%I:%M %p").lstrip('0')
            except Exception:
                checkout_time = str(r.CheckOutTime)
        days_dict[date_str] = {'status': status, 'checkin': checkin_time, 'checkout': checkout_time, 'excuse_reason': r.ExcuseReason}
        if status == 'حاضر': present_count += 1
        elif status == 'معذور': excused_count += 1
        else: absent_count += 1
    settings = load_settings()
    holidays_list = []
    weekly_holidays = settings.get('weekly_holidays', [])
    weekdays_map = {'الإثنين': 0, 'الثلاثاء': 1, 'الأربعاء': 2, 'الخميس': 3, 'الجمعة': 4, 'السبت': 5, 'الأحد': 6}
    weekly_numbers = [weekdays_map.get(day) for day in weekly_holidays if day in weekdays_map]
    for day in range(1, 32):
        try:
            date_obj = datetime(year, month, day)
            if date_obj.weekday() in weekly_numbers:
                holidays_list.append(date_obj.strftime("%Y-%m-%d"))
        except ValueError:
            pass
    conn = get_db_connection()
    cursor = conn.cursor()
    cursor.execute("SELECT HolidayDate, EndDate FROM Holidays WHERE (HolidayType IS NULL OR HolidayType = N'عامة') AND (EndDate IS NULL OR EndDate >= ?)", (f"{year}-{str(month).zfill(2)}-01",))
    holidays_rows = cursor.fetchall()
    conn.close()
    for r in holidays_rows:
        start_date = str(r.HolidayDate)
        if r.EndDate:
            current = r.HolidayDate
            end = r.EndDate
            while current <= end:
                holidays_list.append(str(current))
                current += timedelta(days=1)
        else:
            holidays_list.append(start_date)
    conn = get_db_connection()
    cursor = conn.cursor()
    cursor.execute("SELECT HolidayDate FROM IndividualHolidays WHERE UserId = ? AND HolidayDate LIKE ?", (user_id, f"{month_str}%"))
    individual_rows = cursor.fetchall()
    conn.close()
    for r in individual_rows:
        holidays_list.append(str(r.HolidayDate))
    holidays_list = list(set(holidays_list))
    days_list = [{'date': d, 'status': i['status'], 'checkin': i['checkin'], 'checkout': i['checkout'], 'excuse_reason': i['excuse_reason']} for d, i in days_dict.items()]
    return jsonify({
        'name': user.Name, 'role': user.Role, 'class': user.Class or '-', 'profile_image': user.ProfileImage,
        'month': month, 'year': year,
        'present_count': present_count, 'absent_count': absent_count, 'excused_count': excused_count,
        'days': days_list, 'holidays': holidays_list, 'today': today.strftime("%Y-%m-%d")
    })


# ======================== Webhook ========================
@app.route('/webhook', methods=['POST'])
def webhook():
    data = request.get_json()
    if 'message' in data:
        chat_id = data['message']['chat']['id']
        conn = get_db_connection()
        cursor = conn.cursor()
        cursor.execute("SELECT Id, Role, Name FROM Users WHERE TelegramChatID = ? AND IsActive = 1", (str(chat_id),))
        user = cursor.fetchone()
        conn.close()
        if user:
            user_id, role, user_name = user.Id, user.Role, user.Name
            today = datetime.now().strftime("%Y-%m-%d")
            if is_holiday(today):
                send_telegram(chat_id, "📅 اليوم عطلة رسمية.")
                return jsonify({"ok": True})
            last_att = get_last_attendance(user_id, today)
            if last_att:
                try:
                    dt_obj = datetime.strptime(last_att['time'], "%H:%M:%S")
                    time_12h = dt_obj.strftime("%I:%M %p")
                except Exception:
                    time_12h = last_att['time']
                send_telegram(chat_id, f"✅ {'الطالب' if role == 'طالب' else 'المعلم'} {user_name} حضر اليوم الساعة {time_12h}.")
            else:
                send_telegram(chat_id, f"❌ {'الطالب' if role == 'طالب' else 'المعلم'} {user_name} لم يحضر حتى الآن.")
            return jsonify({"ok": True})
        code = generate_random_code()
        conn = get_db_connection()
        cursor = conn.cursor()
        cursor.execute("INSERT INTO TelegramCodes (Code, ChatId, CreatedAt) VALUES (?, ?, ?)", (code, str(chat_id), datetime.now()))
        conn.commit()
        conn.close()
        send_telegram(chat_id, f"🔐 رمز التحقق: <code>{code}</code>\n⏳ صالح 10 دقائق.")
        admin_chat = load_settings().get("admin_telegram_chat_id")
        if admin_chat:
            send_telegram(admin_chat, f"📌 مستخدم جديد: {chat_id}\nالرمز: {code}")
    return jsonify({"ok": True})


