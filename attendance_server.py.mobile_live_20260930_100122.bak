@app.route('/api/periods', methods=['GET', 'POST', 'DELETE'])
def api_periods():
    if session.get('role') not in ['مدير', 'مشرف']: return jsonify({"error": "غير مصرح"}), 401
    if request.method == 'GET': return jsonify(get_periods())
    data = request.get_json()
    conn = get_db_connection(); cursor = conn.cursor()
    if request.method == 'POST':
        cursor.execute("SELECT MAX(PeriodNumber) FROM Periods")
        mx = cursor.fetchone()[0] or 0; new_num = mx + 1
        cursor.execute("""INSERT INTO Periods (PeriodNumber, StartTime, EndTime, Name, IsBreak, IsActive)
                          VALUES (?, ?, ?, ?, ?, 1)""",
                       (new_num, data.get('start','08:00'), data.get('end','08:45'),
                        data.get('name', f'الحصة {new_num}'), 1 if data.get('is_break') else 0))
        conn.commit(); conn.close(); return jsonify({"success": True, "message": "✅ تم إضافة الحصة"})
    cursor.execute("DELETE FROM Periods WHERE Id=?", (data.get('id'),))
    cursor.execute("SELECT Id FROM Periods ORDER BY PeriodNumber")
    for i, r in enumerate(cursor.fetchall(), start=1):
        cursor.execute("UPDATE Periods SET PeriodNumber=? WHERE Id=?", (i, r.Id))
    conn.commit(); conn.close()
    return jsonify({"success": True, "message": "✅ تم حذف الحصة"})


@app.route('/api/periods/<int:pid>', methods=['PUT'])
def api_period_update(pid):
