# ======================== مسارات استعادة كلمة المرور ========================
@app.route('/api/forgot-password', methods=['POST'])
def api_forgot_password():
    data = request.get_json()
    email = data.get('email', '').strip()
    if not email:
        return jsonify({"success": False, "message": "البريد الإلكتروني مطلوب."}), 400
    conn = get_db_connection()
    cursor = conn.cursor()
    cursor.execute("SELECT Id, Name, Role FROM Users WHERE (Email = ? OR ParentEmail = ?) AND IsActive = 1", (email, email))
    user = cursor.fetchone()
    conn.close()
    if not user:
        return jsonify({"success": False, "message": "هذا البريد غير مسجل."}), 404
    user_id, user_name, user_role = user.Id, user.Name, user.Role
    token = generate_reset_token(user_id)
    reset_link = f"{BASE_URL}/reset-password/{token}"
    if user_role == 'طالب':
        body = f"مرحباً ولي الأمر,\nتم طلب استعادة كلمة المرور للطالب {user_name}.\n{reset_link}\nصالح لمدة 10 دقائق."
    else:
        body = f"مرحباً {user_name},\nتم طلب استعادة كلمة المرور.\n{reset_link}\nصالح لمدة 10 دقائق."
    send_email(email, "🔐 استعادة كلمة المرور", body)
    return jsonify({"success": True, "message": "تم إرسال رابط الاستعادة."})


@app.route('/reset-password/<token>', methods=['GET', 'POST'])
def reset_password_page(token):
    if request.method == 'GET':
        user_id = verify_reset_token(token)
        if not user_id:
            return "الرابط غير صالح أو منتهي الصلاحية.", 400
        return render_template('reset_password.html', token=token)
    data = request.get_json()
    new_password = data.get('password', '').strip()
    if len(new_password) < 6:
        return jsonify({"success": False, "message": "كلمة المرور 6 أحرف على الأقل."}), 400
    user_id = verify_reset_token(token)
    if not user_id:
        return jsonify({"success": False, "message": "الرابط غير صالح."}), 400
    hashed = werkzeug.security.generate_password_hash(new_password)
    conn = get_db_connection()
    cursor = conn.cursor()
    cursor.execute("UPDATE Users SET PasswordHash = ? WHERE Id = ?", (hashed, user_id))
    mark_token_used(token)
    conn.commit()
    conn.close()
    return jsonify({"success": True, "message": "تم تغيير كلمة المرور بنجاح."})


@app.route('/api/attendance/mark-excused', methods=['POST'])
def api_mark_excused():
    if session.get('role') not in ['مدير', 'مشرف']:
        return jsonify({"success": False, "message": "غير مصرح"}), 401
    user_id = request.form.get('user_id')
    date = request.form.get('date', datetime.now().strftime("%Y-%m-%d"))
    reason = request.form.get('reason', '').strip()
    file = request.files.get('attachment')
    if not user_id or not reason:
        return jsonify({"success": False, "message": "معرف المستخدم والسبب مطلوبان"}), 400
    conn = get_db_connection()
    cursor = conn.cursor()
    cursor.execute("SELECT Name FROM Users WHERE Id = ? AND IsActive = 1", (user_id,))
    user = cursor.fetchone()
    if not user:
        conn.close()
        return jsonify({"success": False, "message": "المستخدم غير موجود"}), 404
    attachment_path = None
    if file and file.filename:
        allowed_extensions = {'png', 'jpg', 'jpeg', 'gif', 'pdf'}
        ext = file.filename.rsplit('.', 1)[-1].lower()
        if ext in allowed_extensions:
            filename = f"excuse_{user_id}_{datetime.now().strftime('%Y%m%d%H%M%S')}.{ext}"
            upload_dir = os.path.join('uploads', 'excuses')
            os.makedirs(upload_dir, exist_ok=True)
            filepath = os.path.join(upload_dir, filename)
            file.save(filepath)
            attachment_path = f"uploads/excuses/{filename}"
        else:
            conn.close()
            return jsonify({"success": False, "message": "نوع الملف غير مدعوم."}), 400
    cursor.execute("SELECT Id FROM Attendance WHERE UserId = ? AND AttendanceDate = ?", (user_id, date))
    record = cursor.fetchone()
    if record:
        if attachment_path:
            cursor.execute("UPDATE Attendance SET Status = N'معذور', ExcuseReason = ?, AttachmentPath = ? WHERE Id = ?", (reason, attachment_path, record.Id))
        else:
            cursor.execute("UPDATE Attendance SET Status = N'معذور', ExcuseReason = ? WHERE Id = ?", (reason, record.Id))
        conn.commit()
    else:
        if attachment_path:
            cursor.execute("INSERT INTO Attendance (UserId, Name, AttendanceDate, CheckInTime, Status, ExcuseReason, AttachmentPath) SELECT ?, u.Name, ?, ?, N'معذور', ?, ? FROM Users u WHERE u.Id = ?", (user_id, date, datetime.now().strftime("%H:%M:%S"), reason, attachment_path, user_id))
        else:
            cursor.execute("INSERT INTO Attendance (UserId, Name, AttendanceDate, CheckInTime, Status, ExcuseReason) SELECT ?, u.Name, ?, ?, N'معذور', ? FROM Users u WHERE u.Id = ?", (user_id, date, datetime.now().strftime("%H:%M:%S"), reason, user_id))
        conn.commit()
    cursor.execute("DELETE FROM Notifications WHERE UserId = ? AND NotificationType = 'absence' AND SentDate = ?", (user_id, date))
    conn.commit()
    conn.close()
    send_excuse_notification(user_id, date, reason)
    return jsonify({"success": True, "message": f"تم تسجيل عذر {user.Name}."})


