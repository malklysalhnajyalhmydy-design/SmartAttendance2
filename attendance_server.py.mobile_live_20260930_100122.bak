def _log(prefix, msg):
    """طباعة فورية بدون buffering — تعمل مع PowerShell و Terminal"""
    try:
        print(f"{prefix} {msg}", flush=True)
    except Exception:
        try:
            sys.stdout.buffer.write(f"{prefix} {msg}\n".encode('utf-8', errors='replace'))
            sys.stdout.buffer.flush()
        except Exception:
            pass

def log_info(msg): _log("ℹ️", msg)
def log_success(msg): _log("✅", msg)
def log_warning(msg): _log("⚠️", msg)
def log_error(msg): _log("❌", msg)
def log_debug(msg): _log("🔍", msg)
def log_separator(): print("=" * 60, flush=True)


logging.basicConfig(
    level=logging.INFO,
    format='%(asctime)s [%(levelname)s] %(name)s: %(message)s',
    stream=sys.stdout
)
logging.getLogger('werkzeug').setLevel(logging.WARNING)
logging.getLogger('waitress').setLevel(logging.INFO)


def global_exception_handler(exc_type, exc_value, exc_traceback):
    if issubclass(exc_type, KeyboardInterrupt):
        sys.__excepthook__(exc_type, exc_value, exc_traceback)
        return
    log_separator()
    log_error("🚨 خطأ غير معالَج!")
    log_error(f"   النوع: {exc_type.__name__}")
    log_error(f"   الرسالة: {exc_value}")
    print("\n📋 تفاصيل كاملة:", flush=True)
    traceback.print_exception(exc_type, exc_value, exc_traceback)
    log_separator()

sys.excepthook = global_exception_handler


def thread_exception_handler(args):
    log_separator()
    log_error(f"🚨 خطأ في خيط ({args.thread.name}):")
    log_error(f"   {args.exc_type.__name__}: {args.exc_value}")
    traceback.print_exception(args.exc_type, args.exc_value, args.exc_traceback)
    log_separator()

try:
    threading.excepthook = thread_exception_handler
except Exception:
    pass


