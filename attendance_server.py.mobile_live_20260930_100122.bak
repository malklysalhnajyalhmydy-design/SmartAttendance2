        load_users_cache()
        return jsonify({"success": True, "message": "تم الحذف."})
    except Exception as e:
        return jsonify({"success": False, "message": str(e)}), 500


@app.route('/api/absent-users')
def api_absent_users():
    if session.get('role') not in ['مدير', 'مشرف']:
        return jsonify({"error": "غير مصرح"}), 401
    days = request.args.get('days', 30, type=int)
    role = request.args.get('role', 'طالب')
    user_role = session.get('role')
    if user_role == 'مشرف' and role not in ['طالب', 'معلم']:
        return jsonify([])
    conn = get_db_connection()
    cursor = conn.cursor()
    query = """
        SELECT u.Id, u.Name, u.Role, u.Class, u.StudentId,
               COUNT(a.Id) AS PresentDays,
               DATEDIFF(DAY, u.CreatedAt, GETDATE()) - COUNT(a.Id) AS AbsentDays
        FROM Users u LEFT JOIN Attendance a ON u.Id = a.UserId
        WHERE u.Role = ? AND u.IsActive = 1
        GROUP BY u.Id, u.Name, u.Role, u.Class, u.StudentId, u.CreatedAt
        HAVING DATEDIFF(DAY, u.CreatedAt, GETDATE()) - COUNT(a.Id) >= ?
        ORDER BY AbsentDays DESC
    """
    cursor.execute(query, (role, days))
    rows = cursor.fetchall()
    conn.close()
    return jsonify([{'id': r.Id, 'name': r.Name, 'role': r.Role, 'class': r.Class or '-', 'studentId': r.StudentId or '-', 'absentDays': r.AbsentDays if r.AbsentDays else 0} for r in rows])


@app.route('/api/teacher/attendance')
def api_teacher_attendance():
    if session.get('role') != 'معلم':
        return jsonify({"error": "غير مصرح"}), 401
    uid = session['user_id']
    conn = get_db_connection()
    cursor = conn.cursor()
    cursor.execute("SELECT Name, SUM(CASE WHEN Status = N'حاضر' THEN 1 ELSE 0 END), SUM(CASE WHEN Status = N'غائب' THEN 1 ELSE 0 END), COUNT(Id) FROM Attendance WHERE UserId = ? GROUP BY Name", (uid,))
    st = cursor.fetchone()
    cursor.execute("SELECT AttendanceDate, CheckInTime, CheckOutTime, Status FROM Attendance WHERE UserId = ? ORDER BY AttendanceDate DESC", (uid,))
    recs = cursor.fetchall()
    conn.close()
    return jsonify({
        'name': st.Name if st else 'معلم',
        'present_days': st[1] if st else 0, 'absent_days': st[2] if st else 0,
        'attendance_rate': round((st[1] / st[3] * 100) if st and st[3] > 0 else 0, 1),
        'records': [{'date': str(r.AttendanceDate), 'checkin': str(r.CheckInTime) if r.CheckInTime else '-', 'checkout': str(r.CheckOutTime) if r.CheckOutTime else '-', 'status': r.Status or '-'} for r in recs]
    })


@app.route('/api/parent/attendance')
def api_parent_attendance():
    if session.get('role') != 'parent':
        return jsonify({"error": "غير مصرح"}), 401
    sid = session['user_id']
    conn = get_db_connection()
    cursor = conn.cursor()
    cursor.execute("SELECT u.Name, SUM(CASE WHEN a.Status = N'حاضر' THEN 1 ELSE 0 END), SUM(CASE WHEN a.Status = N'غائب' THEN 1 ELSE 0 END), COUNT(a.Id) FROM Users u LEFT JOIN Attendance a ON u.Id = a.UserId WHERE u.Id = ? GROUP BY u.Name", (sid,))
    st = cursor.fetchone()
    cursor.execute("SELECT AttendanceDate, CheckInTime, CheckOutTime, Status FROM Attendance WHERE UserId = ? ORDER BY AttendanceDate DESC", (sid,))
    recs = cursor.fetchall()
    conn.close()
    return jsonify({
        'student_name': st.Name if st else 'طالب',
        'present_days': st[1] if st else 0, 'absent_days': st[2] if st else 0,
        'attendance_rate': round((st[1] / st[3] * 100) if st and st[3] > 0 else 0, 1),
        'records': [{'date': str(r.AttendanceDate), 'checkin': str(r.CheckInTime) if r.CheckInTime else '-', 'checkout': str(r.CheckOutTime) if r.CheckOutTime else '-', 'status': r.Status or '-'} for r in recs]
    })


@app.route('/api/absence/today')
def api_absence_today():
    """
    قائمة الغائبين اليوم.
    ✅ التعديل:
      - تجاهل المعلمين في أيام عدم دوامهم
    """
    if session.get('role') not in ['مدير', 'مشرف']:
        return jsonify({"error": "غير مصرح"}), 401

    today = datetime.now().strftime("%Y-%m-%d")

    # فحص هل اليوم عطلة رسمية
    if is_holiday(today):
        return jsonify([])

    user_role = session.get('role')
    if user_role == 'مدير':
        roles_filter = "u.Role IN (N'طالب', N'معلم', N'مشرف')"
    else:
        roles_filter = "u.Role IN (N'طالب', N'معلم')"

    conn = get_db_connection()
    cursor = conn.cursor()
    query = f"""
        SELECT u.Id, u.Name, u.Role, u.Class, u.StudentId, u.ProfileImage
        FROM Users u
        WHERE u.IsActive = 1 AND {roles_filter}
          AND u.Id NOT IN (SELECT DISTINCT a.UserId FROM Attendance a WHERE a.AttendanceDate = ?)
          AND u.Id NOT IN (SELECT ih.UserId FROM IndividualHolidays ih WHERE ih.HolidayDate = ?)
        ORDER BY u.Role, u.Class, u.Name
    """
    cursor.execute(query, (today, today))
    rows = cursor.fetchall()
    conn.close()

    # ✅ 🆕 فلترة المعلمين في أيام عدم دوامهم
    filtered = []
    for r in rows:
        if r.Role == 'معلم':
            if not is_teacher_working_day(r.Id, today):
                continue  # ليس يوم دوامه — تجاهله
        filtered.append(r)

    return jsonify([{
        'id': r.Id,
        'name': r.Name,
        'role': r.Role,
        'class': r.Class or '-',
        'studentId': r.StudentId or '-',
        'profile_image': r.ProfileImage or ''
    } for r in filtered])

@app.route('/api/absence/today/export')
def api_absence_today_export():
    """
    تصدير الغائبين اليوم إلى Excel.
    ✅ التعديل:
      - تجاهل المعلمين في أيام عدم دوامهم
    """
    if session.get('role') not in ['مدير', 'مشرف']:
        return jsonify({"error": "غير مصرح"}), 401

    today = datetime.now().strftime("%Y-%m-%d")
    user_role = session.get('role')
    if user_role == 'مدير':
        roles_filter = "u.Role IN (N'طالب', N'معلم', N'مشرف')"
    else:
        roles_filter = "u.Role IN (N'طالب', N'معلم')"

    conn = get_db_connection()
    cursor = conn.cursor()
    query = f"""
        SELECT u.Id, u.Name, u.Role, u.Class, u.StudentId
        FROM Users u
        WHERE u.IsActive = 1 AND {roles_filter}
          AND u.Id NOT IN (SELECT DISTINCT a.UserId FROM Attendance a WHERE a.AttendanceDate = ?)
          AND u.Id NOT IN (SELECT ih.UserId FROM IndividualHolidays ih WHERE ih.HolidayDate = ?)
        ORDER BY u.Role, u.Class, u.Name
    """
    cursor.execute(query, (today, today))
    rows = cursor.fetchall()
    conn.close()

    # ✅ 🆕 فلترة المعلمين
    filtered = []
    for r in rows:
        if r.Role == 'معلم':
            if not is_teacher_working_day(r.Id, today):
                continue
        filtered.append(r)

    wb = openpyxl.Workbook()
    ws = wb.active
    ws.title = f"الغائبون {today}"
    ws.append(['الاسم', 'الدور', 'الصف', 'رقم القيد'])
    for r in filtered:
        ws.append([r.Name, r.Role, r.Class or '-', r.StudentId or '-'])

    filename = f"absence_{today}.xlsx"
    filepath = os.path.join('exports', filename)
    os.makedirs('exports', exist_ok=True)
    wb.save(filepath)
    return send_file(filepath, as_attachment=True, download_name=filename)


